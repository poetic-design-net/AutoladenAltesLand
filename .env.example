# Mailversand der Anfragen (Resend)
RESEND_API_KEY=
# Empfängeradresse der Anfragen – ohne diese Variable antwortet /api/contact mit 503
CONTACT_TO=
# Absender; muss bei Resend als Domain verifiziert sein
CONTACT_FROM="Autoladen Altes Land <anfrage@deine-domain.de>"

# Google Places – nur serverseitig, niemals mit PUBLIC_-Präfix.
# Den echten Schlüssel in .env und in Vercel hinterlegen, nicht in Sanity/Git.
# Places API (New) aktivieren. Place ID wird in Sanity gepflegt.
GOOGLE_PLACES_API_KEY=
