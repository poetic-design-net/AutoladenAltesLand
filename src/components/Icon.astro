---
/**
 * Rendert ein Icon aus @hugeicons/core-free-icons (Stroke Rounded).
 *
 *   import { Call02Icon } from '@hugeicons/core-free-icons';
 *   <Icon icon={Call02Icon} size={19} />
 *
 * Die Farbe kommt über currentColor vom Elternelement, die Strichstärke
 * aus der globalen .ic-Regel. width/height stehen als Attribute, damit
 * CSS-Regeln wie `.cp-btn .ic { width: 19px }` weiterhin gewinnen.
 */
type IconNode = readonly [string, { readonly [key: string]: string | number }];

interface Props {
  icon: readonly IconNode[];
  size?: number;
  class?: string;
}

const { icon, size = 20, class: cls } = Astro.props;

const inner = icon
  .map(
    ([tag, attrs]) =>
      `<${tag} ${Object.entries(attrs)
        .map(([key, value]) => `${key}="${String(value).replace(/"/g, '&quot;')}"`)
        .join(' ')} />`
  )
  .join('');
---

<svg
  class={['ic', cls].filter(Boolean).join(' ')}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  set:html={inner}
/>
