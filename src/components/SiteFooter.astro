---
/**
 * Gemeinsamer Footer aller Seiten. Auf der Startseite öffnen Anfrage und
 * „Fragen & Antworten“ die Dialoge direkt; auf Unterseiten führen dieselben
 * Einträge zur Startseite, die den Dialog dann öffnet.
 */
import Icon from './Icon.astro';
import {
  ArrowRight02Icon,
  Call02Icon,
  InstagramIcon,
  Mail01Icon,
  WhatsappIcon,
} from '@hugeicons/core-free-icons';
import { contactLinks, navHref, navLinks, type Frontpage, type SiteSettings } from '../lib/content';
import { httpsUrl } from '../lib/reviews';

interface Props {
  site: SiteSettings;
  page: Frontpage;
  /** Startseite: Dialoge sind auf der Seite vorhanden, Sprungziele ohne Seitenwechsel. */
  home?: boolean;
}
const { site, page, home = false } = Astro.props;
const { telHref, waHref, mailHref } = contactLinks(site);
const instagramHref = httpsUrl(site.instagramUrl);
const enquiryHref = '/?anfrage=allgemein';
const dialogHref = { faq: '/?dialog=faq', ask: enquiryHref };
const links = navLinks(page.footer.links, page);
const groups = [
  {
    title: page.footer.exploreLabel,
    targets: ['fahrzeuge', 'ablauf', 'finanzierung', 'dachzelte'],
  },
  { title: page.footer.moreLabel, targets: ['alex', 'faq', 'ask'] },
];
---

<footer
  class:list={['foot', { 'foot--subpage': !home }]}
  id="kontakt"
  tabindex="-1"
  data-track-section="footer"
>
  <div class="footer-top">
    <svg class="footer-road" viewBox="0 0 620 360" fill="none" aria-hidden="true">
      <path d="M10 352C200 296 446 237 343 183C209 113 523 125 448 85C409 65 534 40 610 18"></path>
      <path
        d="M65 358C247 293 469 243 364 184C252 122 537 128 467 85C430 62 546 38 615 19"
        stroke-dasharray="10 8"></path>
      <path d="M110 359C297 292 495 249 386 185C288 128 551 130 486 85C450 61 560 38 620 20"></path>
    </svg>
    <div class="footer-invitation">
      <span class="footer-eyebrow">{page.footer.eyebrow}</span>
      <h2>{page.footer.heading}</h2>
      <p>{page.footer.intro}</p>
    </div>
    <div class="footer-actions">
      {
        home ? (
          <button
            class="footer-primary"
            type="button"
            data-view="ask"
            aria-haspopup="dialog"
            data-track-id="footer_contact"
          >
            {page.footer.ctaLabel}
            <span>
              <Icon icon={ArrowRight02Icon} />
            </span>
          </button>
        ) : (
          <a class="footer-primary" href={enquiryHref} data-track-id="footer_contact">
            {page.footer.ctaLabel}
            <span>
              <Icon icon={ArrowRight02Icon} />
            </span>
          </a>
        )
      }
      {
        waHref && (
          <a class="footer-whatsapp" href={waHref} target="_blank" rel="noopener noreferrer">
            <Icon icon={WhatsappIcon} />
            {page.footer.whatsappCtaLabel}
          </a>
        )
      }
      <p>{page.footer.finePrint}</p>
    </div>
  </div>
  <div class="footer-main">
    <div class="footer-brand">
      <a class="brand" href={home ? '#start' : '/'}>
        <img src={site.logo} alt="" width="72" height="72" />
        <span>{site.brandName}<small>{page.footer.brandTagline}</small></span>
      </a>
    </div>
    <address class="footer-contact">
      <h3>{page.footer.contactLabel}</h3>
      {
        telHref && (
          <a href={telHref}>
            <Icon icon={Call02Icon} />
            {site.phone}
          </a>
        )
      }
      {
        mailHref && (
          <a href={mailHref}>
            <Icon icon={Mail01Icon} />
            {site.email}
          </a>
        )
      }
      {
        instagramHref && (
          <a href={instagramHref} target="_blank" rel="noopener noreferrer">
            <Icon icon={InstagramIcon} />
            {page.footer.instagramLabel}
          </a>
        )
      }
    </address>
    <nav class="footer-nav" aria-label={page.footer.navigationLabel}>
      {
        groups.map((group) => (
          <div class="footer-nav-group">
            <h3>{group.title}</h3>
            {links
              .filter((link) => group.targets.includes(link.target))
              .map((link) =>
                link.target === 'faq' || link.target === 'ask' ? (
                  home ? (
                    <button type="button" data-view={link.target} aria-haspopup="dialog">
                      {link.label}
                    </button>
                  ) : (
                    <a href={dialogHref[link.target]}>{link.label}</a>
                  )
                ) : (
                  <a href={navHref(link.target, home)}>{link.label}</a>
                )
              )}
          </div>
        ))
      }
    </nav>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} {site.brandName}</span>
    <nav aria-label={site.legalLabels.legalNavigation}>
      <a href="/impressum">{page.footer.legalLabel}</a>
      <a href="/datenschutz">{page.footer.privacyLabel}</a>
    </nav>
  </div>
</footer>

<style>
  /* Erwartet einen Seitenrahmen mit 40px (mobil 20px) seitlichem Innenabstand. */
  .brand {
    display: inline-flex;
    align-items: center;
    flex: none;
    color: inherit;
  }

  .foot {
    --focus: #b8dfd1;
    width: calc(100% + 80px);
    margin: 80px -40px 0;
    padding: 0 max(40px, calc((100vw - 1240px) / 2)) 28px;
    border-radius: 40px 40px 0 0;
    background: #09294e;
    color: #fff;
    border-top: 2px solid #27bf8e;
  }
  .footer-top {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.85fr) minmax(320px, 1fr);
    gap: 64px;
    align-items: center;
    padding: 88px 0 64px;
    border-bottom: 1px solid #33516f;
  }
  .footer-road {
    position: absolute;
    width: 52%;
    height: 90%;
    left: 27%;
    top: 5%;
    pointer-events: none;
    color: #a8c7df;
    opacity: 0.1;
    stroke: currentColor;
    stroke-width: 1;
  }
  .footer-invitation,
  .footer-actions {
    position: relative;
  }
  .footer-eyebrow {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #41d1a2;
    font-weight: 500;
  }
  .footer-invitation h2 {
    margin-top: 24px;
    font-size: clamp(32px, 3.2vw, 48px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .footer-invitation p {
    margin-top: 24px;
    font-size: 18px;
    line-height: 1.6;
    color: #b7cadf;
  }
  .footer-actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .footer-primary,
  .foot .footer-whatsapp {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 76px;
    padding: 16px 24px;
    border-radius: 12px;
    font-size: 17px;
    line-height: 1.35;
    font-weight: 600;
  }
  .footer-primary {
    justify-content: space-between;
    background: #f5f4f1;
    color: #09294e;
  }
  .footer-primary:hover {
    background: white;
  }
  .footer-primary > span {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    background: #09294e;
    color: white;
  }
  .footer-primary :global(.ic) {
    width: 22px;
    height: 22px;
  }
  .foot .footer-whatsapp {
    border: 1px solid #b7cadf;
    color: white;
  }
  .footer-whatsapp :global(.ic) {
    width: 32px;
    height: 32px;
  }
  .footer-actions p {
    font-size: 13px;
    line-height: 1.5;
    color: #b7cadf;
  }
  .foot h3 {
    margin-bottom: 16px;
    font-size: 14px;
    font-weight: 500;
    color: #41d1a2;
  }
  .footer-nav-group {
    padding-left: 36px;
    border-left: 1px solid #33516f;
  }
  .footer-brand small {
    display: block;
    margin-top: 4px;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.5;
    color: #b7cadf;
  }
  .footer-brand {
    align-self: center;
  }
  .footer-brand .brand > span {
    min-width: 0;
  }
  .footer-brand .brand:hover {
    text-decoration: none;
  }
  .footer-brand .brand:hover > span {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer-brand .brand:hover small {
    text-decoration: none;
  }
  .footer-bottom {
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .footer-bottom nav a + a::before {
    content: '';
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #b7cadf;
    margin-right: 24px;
  }
  @media (max-width: 1100px) {
    .footer-top {
      grid-template-columns: minmax(0, 1.4fr) minmax(300px, 1fr);
      gap: 32px;
    }
    .footer-invitation h2 {
      font-size: 36px;
    }
  }
  .footer-main {
    display: grid;
    grid-template-columns: 1.1fr 1.1fr 1.6fr;
    align-items: stretch;
    gap: 32px;
    padding-block: 40px 48px;
  }
  .footer-brand .brand {
    gap: 16px;
    font-size: 17px;
    font-weight: 500;
  }
  .footer-brand img {
    width: 64px;
    height: 64px;
    flex: none;
  }
  .footer-contact {
    padding-left: 32px;
    border-left: 1px solid #33516f;
    font-style: normal;
  }
  .footer-contact a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    font-size: 13px;
    overflow-wrap: anywhere;
  }
  .footer-contact :global(.ic) {
    width: 21px;
    height: 21px;
  }
  .footer-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .footer-nav a,
  .footer-nav button {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    font-size: 13px;
    line-height: 1.4;
  }
  .foot a,
  .footer-nav button {
    color: #d7e4ef;
  }
  .foot a:hover,
  .footer-nav button:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 20px;
    border-top: 1px solid #33516f;
    font-size: 13px;
    color: #b7cedf;
  }
  .footer-bottom nav {
    display: flex;
    gap: 28px;
  }
  .footer-bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }
  @media (max-width: 1100px) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
    .footer-contact {
      border-right: 0;
    }
    .footer-nav {
      grid-column: 1 / -1;
      grid-template-columns: 1fr 1fr;
      border-top: 1px solid #33516f;
      padding-top: 20px;
    }
    .footer-nav-group:first-child {
      border-left: 0;
      padding-left: 0;
    }
  }
  @media (max-width: 760px) {
    .foot {
      width: calc(100% + 40px);
      margin: 48px -20px 0;
      padding: 0 24px calc(100px + env(safe-area-inset-bottom, 0px));
      border-radius: 28px 28px 0 0;
    }
    .footer-top {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding: 48px 0 32px;
    }
    .footer-invitation h2 {
      font-size: 32px;
      text-wrap: initial;
    }
    .footer-invitation p {
      font-size: 16px;
      margin-top: 16px;
    }
    .footer-road {
      left: 20%;
      width: 80%;
    }
    .footer-primary,
    .foot .footer-whatsapp {
      min-height: 68px;
      padding: 12px 16px;
      font-size: 15px;
    }
    .footer-main {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-block: 32px;
    }
    .footer-brand .brand {
      font-size: 17px;
    }
    .footer-contact {
      border: 0;
      padding: 0;
    }
    .footer-contact a {
      min-height: 44px;
      font-size: 13px;
    }
    .footer-nav {
      grid-template-columns: 1fr 1fr;
      gap: 4px 20px;
      padding-top: 20px;
    }
    .footer-nav-group {
      padding-left: 20px;
    }
    .footer-nav a,
    .footer-nav button {
      min-height: 44px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      margin-top: 24px;
      padding-top: 16px;
    }
    .footer-bottom a {
      min-height: 44px;
    }
  }
  /* Als Link (Unterseiten) behält der Hauptbutton seine Farben. */
  .foot a.footer-primary {
    color: #09294e;
  }
  .foot a.footer-primary:hover {
    color: #09294e;
    text-decoration: none;
  }
  @media (max-width: 760px) {
    /* Ohne mobile Leiste braucht der Fuß keinen Platz darunter. */
    .foot--subpage {
      padding-bottom: calc(28px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
