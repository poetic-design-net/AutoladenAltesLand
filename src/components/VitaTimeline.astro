---
/**
 * Astro adaptation of kedhareswer's Pigment Experience Ledger / Experience Timeline Section.
 * Retrieved via 21st CLI (catalog 38037), 2026-10-30.
 * https://21st.dev/@kedhareswer/components/pigment-experience-ledger
 * Retains the date/title ledger, expandable stories and pigment highlight.
 * Native details replace React state; a static SVG wash replaces the canvas render loop.
 */
import { vitaItems, type VitaContent } from '../lib/vita';

interface Props {
  content: VitaContent;
}

const { content } = Astro.props;
const items = vitaItems(content.items);
---

{
  content.enabled && items.length > 0 && (
    <section class="vita" id="vita" aria-labelledby="vita-title" data-track-section="about_vita">
      <header class="vita-head">
        <div>
          <p class="eyebrow">{content.eyebrow}</p>
          <h2 id="vita-title">{content.heading}</h2>
        </div>
        {content.intro && <p class="vita-intro">{content.intro}</p>}
      </header>
      <ol class="vita-list">
        {items.map((item, index) => (
          <li class="vita-row">
            <details class="station" open={index === 0}>
              <summary>
                <span class="when">
                  <span class="period">{item.period}</span>
                  <span class="toggle" aria-hidden="true" />
                </span>
                <span class="name-cell">
                  <span class="name">
                    <svg
                      class="pigment"
                      viewBox="0 0 600 110"
                      preserveAspectRatio="none"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <defs>
                        <filter
                          id={`vita-wash-${index}`}
                          x="-10%"
                          y="-50%"
                          width="120%"
                          height="200%"
                        >
                          <feTurbulence
                            type="fractalNoise"
                            baseFrequency="0.03 0.12"
                            numOctaves="3"
                            seed={index + 3}
                            result="grain"
                          />
                          <feDisplacementMap in="SourceGraphic" in2="grain" scale="18" />
                          <feGaussianBlur stdDeviation="1.3" />
                        </filter>
                      </defs>
                      <g filter={`url(#vita-wash-${index})`}>
                        <path
                          class="wash-light"
                          d="M18 55 Q130 13 270 30 T578 31 L584 80 Q420 65 301 86 T18 92 Z"
                        />
                        <path
                          class="wash-dark"
                          d="M35 68 Q210 42 355 52 T568 41 L572 75 Q420 91 310 73 T28 92 Z"
                        />
                      </g>
                    </svg>
                    <span class="station-title">{item.title}</span>
                  </span>
                  {item.role && <span class="role">{item.role}</span>}
                </span>
              </summary>
              <div class="station-body">
                {item.location && <p class="location">{item.location}</p>}
                <p class="description">{item.description}</p>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .vita {
    padding-block: 56px 72px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 32px;
  }
  .vita-head {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: end;
    gap: clamp(32px, 6vw, 88px);
    margin-bottom: 40px;
  }
  .eyebrow {
    color: #28715e;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h2 {
    max-width: 19ch;
    margin-top: 14px;
    color: var(--ink);
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .vita-intro {
    max-width: 43ch;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.8;
  }
  .vita-list {
    border-top: 1px solid var(--line);
  }
  .vita-row {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: grid;
    grid-template-columns: minmax(140px, 0.36fr) minmax(0, 1fr);
    align-items: center;
    gap: 32px;
    min-height: 112px;
    padding: 28px 8px;
    list-style: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline-offset: -2px;
  }
  .when {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--ink-2);
  }
  .period {
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
  }
  .toggle {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
    transition: transform 200ms var(--ease);
  }
  .toggle::before,
  .toggle::after {
    position: absolute;
    content: '';
    top: 6px;
    width: 14px;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
  }
  .toggle::after {
    transform: rotate(90deg);
  }
  details[open] .toggle {
    transform: rotate(45deg);
  }
  .name-cell {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    min-width: 0;
    text-align: right;
  }
  .name {
    position: relative;
    isolation: isolate;
    max-width: 100%;
    font-size: clamp(26px, 3.5vw, 46px);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--accent);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .station-title {
    position: relative;
  }
  .pigment {
    position: absolute;
    z-index: -1;
    left: -2%;
    top: 15%;
    width: 104%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    opacity: 0;
    transform: scaleX(0.82);
    transform-origin: 80% 50%;
    transition:
      opacity 220ms var(--ease),
      transform 280ms var(--ease);
  }
  .wash-light {
    fill: var(--green);
    opacity: 0.1;
  }
  .wash-dark {
    fill: var(--green);
    opacity: 0.12;
  }
  details[open] .pigment,
  summary:focus-visible .pigment {
    opacity: 1;
    transform: scaleX(1);
  }
  @media (hover: hover) {
    summary:hover .pigment {
      opacity: 1;
      transform: scaleX(1);
    }
  }
  .role {
    margin-top: 10px;
    color: var(--ink-2);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .station-body {
    display: grid;
    grid-template-columns: minmax(140px, 0.36fr) minmax(0, 1fr);
    gap: 32px;
    padding: 0 8px 32px;
  }
  .location {
    grid-column: 1;
    color: var(--ink-2);
    font-size: 13px;
    line-height: 1.8;
  }
  .description {
    grid-column: 2;
    max-width: 62ch;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.8;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
  @media (max-width: 760px) {
    .vita {
      padding-block: 36px 44px;
    }
    .vita-head {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 28px;
    }
    summary {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 24px 4px;
    }
    .name-cell {
      align-items: flex-start;
      text-align: left;
    }
    .name {
      font-size: clamp(26px, 7vw, 38px);
    }
    .role {
      font-size: 11px;
    }
    .station-body {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 0 4px 28px;
    }
    .location,
    .description {
      grid-column: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pigment,
    .toggle {
      transition: none;
    }
  }
</style>
