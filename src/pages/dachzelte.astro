---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Rooftent from '../components/Rooftent.astro';
import { ArrowLeft02Icon } from '@hugeicons/core-free-icons';
import { getContent } from '../lib/content';
import { canonicalUrl, SITE_URL } from '../lib/seo';

const { site, page } = await getContent();
const tent = page.rooftent;
// Der Schalter in Sanity blendet Seite, Startseiten-Hinweis und Footer-Link gemeinsam aus.
if (!tent.enabled) return new Response(null, { status: 404 });
const url = canonicalUrl('/dachzelte');
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${url}#webpage`,
  url,
  name: tent.seoTitle,
  description: tent.seoDescription,
  inLanguage: 'de-DE',
  isPartOf: { '@id': `${SITE_URL}/#website` },
};
---

<Base
  title={tent.seoTitle}
  description={tent.seoDescription}
  ogImage={tent.image}
  ogImageAlt={tent.imageAlt}
  siteName={site.brandName}
  structuredData={structuredData}
  fonts="family=Geist:wght@300..700&family=Manrope:wght@400..700"
>
  <div class="tent-page">
    <header class="bar" data-track-section="rooftent_header">
      <a class="brand" href="/">
        <img src={site.logo} alt="" width="72" height="72" />
        <span>{site.brandName}</span>
      </a>
      <a class="back" href="/">
        <Icon icon={ArrowLeft02Icon} />
        {tent.backLabel}
      </a>
    </header>

    <main id="main" tabindex="-1">
      <Rooftent content={tent} />
    </main>

    <footer class="footer-bottom" data-track-section="rooftent_footer">
      <span>© {new Date().getFullYear()} {site.brandName}</span>
      <nav aria-label={site.legalLabels.legalNavigation}>
        <a href="/impressum">{page.footer.legalLabel}</a>
        <a href="/datenschutz">{page.footer.privacyLabel}</a>
      </nav>
    </footer>
  </div>
</Base>

<style>
  /* Kopf und Fuß folgen /ueber-mich; bewusst dupliziert, bis eine dritte Unterseite sie braucht. */
  :global(body[data-theme='light']) {
    --font: 'Geist', 'Manrope', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  }
  .tent-page {
    padding: 24px 40px 0;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    max-width: 1400px;
    margin-inline: auto;
    min-height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    color: var(--ink);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .brand img {
    flex: none;
    width: 72px;
    height: 72px;
    object-fit: contain;
  }
  .back {
    display: inline-flex;
    align-items: center;
    flex: none;
    gap: 10px;
    min-height: 44px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .back:hover,
  .footer-bottom a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .back :global(.ic) {
    width: 20px;
    height: 20px;
  }
  main :global(.rooftent) {
    margin-top: 24px;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    max-width: 1240px;
    margin: 64px auto 0;
    padding-block: 20px 28px;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 12px;
  }
  .footer-bottom nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  .footer-bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
  }
  @media (max-width: 760px) {
    .tent-page {
      padding: calc(16px + env(safe-area-inset-top, 0px)) 20px 0;
    }
    .bar {
      gap: 16px;
      min-height: 56px;
    }
    .brand {
      gap: 10px;
      font-size: 15px;
      line-height: 1.2;
    }
    .brand img {
      width: 48px;
      height: 48px;
    }
    .back {
      gap: 6px;
      font-size: 12px;
    }
    .footer-bottom {
      margin-top: 40px;
    }
  }
</style>
