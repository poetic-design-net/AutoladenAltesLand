---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import VitaTimeline from '../components/VitaTimeline.astro';
import {
  ArrowLeft02Icon,
  ArrowRight02Icon,
  Call02Icon,
  WhatsappIcon,
} from '@hugeicons/core-free-icons';
import { contactLinks, getContent } from '../lib/content';
import { canonicalUrl, SITE_URL } from '../lib/seo';

const { site, page, about } = await getContent();
const { telHref, waHref } = contactLinks(site);
const enquiryHref = '/?anfrage=allgemein&aal_source=about_contact';
const url = canonicalUrl('/ueber-mich');
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${url}#webpage`,
  url,
  name: about.seoTitle,
  description: about.seoDescription,
  inLanguage: 'de-DE',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  mainEntity: {
    '@type': 'Person',
    name: site.contactName,
    image: new URL(about.image, SITE_URL).href,
    worksFor: { '@id': `${SITE_URL}/#unternehmen`, '@type': 'AutoDealer', name: site.brandName },
  },
};
---

<Base
  title={about.seoTitle}
  description={about.seoDescription}
  ogImage={about.image}
  ogImageAlt={about.imageAlt}
  siteName={site.brandName}
  structuredData={structuredData}
  fonts="family=Geist:wght@300..700&family=Manrope:wght@400..700"
>
  <div class="about-page">
    <header class="bar" data-track-section="about_header">
      <a class="brand" href="/">
        <img src={site.logo} alt="" width="72" height="72" />
        <span>{site.brandName}</span>
      </a>
      <a class="back" href="/">
        <Icon icon={ArrowLeft02Icon} />
        {about.backLabel}
      </a>
    </header>

    <main id="main" tabindex="-1">
      <section class="introduction" aria-labelledby="about-title" data-track-section="about_intro">
        <div class="introduction-copy">
          <p class="eyebrow">{about.eyebrow}</p>
          <h1 id="about-title">{about.title}</h1>
          <p class="lead">{about.lead}</p>
          <div class="story">
            {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <a class="text-link" href={enquiryHref} data-track-id="about_contact">
            {about.ctaLabel}<Icon icon={ArrowRight02Icon} />
          </a>
        </div>
        <figure class="portrait">
          <img
            src={about.image}
            alt={about.imageAlt}
            width="1600"
            height="1067"
            fetchpriority="high"
          />
          <figcaption>
            <span class="dot" aria-hidden="true"></span>
            {about.subtitle}
          </figcaption>
        </figure>
      </section>

      <VitaTimeline content={about.vita} />

      <section
        class="approach"
        aria-labelledby="approach-title"
        data-track-section="about_approach"
      >
        <h2 id="approach-title">{about.ruleHeading}</h2>
        <div class="approach-copy">
          {about.ruleParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          <p class="emphasis">{about.ruleEmphasis}</p>
        </div>
      </section>
    </main>

    <footer class="footer" data-track-section="about_footer">
      <div class="contact">
        <div class="contact-copy">
          <h2>{about.kicker}</h2>
          <p>{about.contactText}</p>
          <div class="direct-links">
            {
              telHref && (
                <a href={telHref}>
                  <Icon icon={Call02Icon} />
                  {about.phoneLabel}
                </a>
              )
            }
            {
              waHref && (
                <a href={waHref} target="_blank" rel="noopener noreferrer">
                  <Icon icon={WhatsappIcon} />
                  {about.whatsappLabel}
                </a>
              )
            }
          </div>
        </div>
        <div class="contact-action">
          <a class="contact-button" href={enquiryHref} data-track-id="about_contact">
            {about.ctaLabel}
            <span aria-hidden="true"><Icon icon={ArrowRight02Icon} /></span>
          </a>
          <p>{about.contactNote}</p>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} {site.brandName}</span>
        <nav aria-label={site.legalLabels.legalNavigation}>
          <a href="/impressum">{page.footer.legalLabel}</a>
          <a href="/datenschutz">{page.footer.privacyLabel}</a>
        </nav>
      </div>
    </footer>
  </div>
</Base>

<style>
  :global(body[data-theme='light']) {
    --font: 'Geist', 'Manrope', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  }
  .about-page {
    padding: 24px 40px 0;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    max-width: 1400px;
    margin-inline: auto;
    min-height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    color: var(--ink);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .brand img {
    flex: none;
    width: 72px;
    height: 72px;
    object-fit: contain;
  }
  .back,
  .text-link,
  .direct-links a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 14px;
    font-weight: 500;
  }
  .back {
    flex: none;
    color: var(--ink-2);
  }
  .back:hover,
  .text-link:hover,
  .footer a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .back :global(.ic),
  .text-link :global(.ic),
  .direct-links :global(.ic) {
    width: 20px;
    height: 20px;
  }
  main {
    max-width: 1240px;
    margin-inline: auto;
  }
  .introduction {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(32px, 6vw, 88px);
    padding-block: clamp(48px, 6vw, 88px);
  }
  .eyebrow {
    color: #28715e;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 11ch;
    margin-top: 16px;
    color: var(--accent);
    font-size: clamp(40px, 4.8vw, 64px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .lead {
    margin-top: 28px;
    font-size: clamp(20px, 2vw, 23px);
    line-height: 1.45;
    letter-spacing: -0.02em;
  }
  .story {
    margin-top: 24px;
  }
  .story p,
  .approach-copy p {
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.8;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
  .story p + p,
  .approach-copy p + p {
    margin-top: 16px;
  }
  .text-link {
    margin-top: 24px;
  }
  .portrait img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    background: var(--surface-2);
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    color: var(--ink-2);
    font-size: 13px;
  }
  .approach {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(32px, 6vw, 88px);
    border-top: 1px solid var(--line);
    padding-block: 56px 72px;
  }
  .approach h2 {
    max-width: 18ch;
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .approach-copy .emphasis {
    margin-top: 28px;
    padding-left: 20px;
    border-left: 3px solid var(--green);
    color: var(--accent);
    font-weight: 500;
  }
  .footer {
    max-width: 1400px;
    margin-inline: auto;
    padding: 48px clamp(24px, 4.5vw, 64px) 24px;
    border-top: 6px solid var(--green);
    border-radius: 40px 40px 0 0;
    background: var(--accent);
    color: white;
  }
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    align-items: center;
    gap: 48px;
  }
  .contact h2 {
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .contact-copy > p {
    max-width: 40ch;
    margin-top: 16px;
    color: #dce6ef;
    line-height: 1.7;
  }
  .direct-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 20px;
  }
  .footer a {
    color: inherit;
  }
  .footer :global(:focus-visible) {
    outline-color: white;
  }
  .contact-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 64px;
    padding: 14px 16px 14px 24px;
    border-radius: 10px;
    background: var(--surface);
    color: var(--accent) !important;
    font-size: 16px;
    font-weight: 500;
  }
  .contact-button span {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 50%;
  }
  .contact-action p {
    margin-top: 14px;
    color: #dce6ef;
    font-size: 12px;
    line-height: 1.6;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid #ffffff30;
    color: #dce6ef;
    font-size: 12px;
  }
  .footer-bottom nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  .footer-bottom nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  @media (max-width: 900px) {
    .introduction {
      align-items: start;
      gap: 32px;
    }
    .portrait {
      margin-top: 48px;
    }
    .contact {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .contact-action {
      max-width: 480px;
    }
  }
  @media (max-width: 760px) {
    .about-page {
      padding: 16px 20px 0;
    }
    .bar {
      align-items: center;
      gap: 16px;
      min-height: 56px;
    }
    .brand {
      gap: 10px;
      font-size: 15px;
      line-height: 1.2;
    }
    .brand img {
      width: 48px;
      height: 48px;
    }
    .back {
      gap: 6px;
      font-size: 12px;
    }
    .introduction,
    .approach {
      grid-template-columns: 1fr;
    }
    .introduction {
      gap: 32px;
      padding-block: 44px 40px;
    }
    h1 {
      max-width: 14ch;
      font-size: clamp(38px, 9vw, 54px);
    }
    .lead {
      margin-top: 20px;
    }
    .story {
      margin-top: 20px;
    }
    .portrait {
      margin-top: 0;
    }
    figcaption {
      margin-top: 16px;
    }
    .approach {
      gap: 24px;
      padding-block: 36px 44px;
    }
    .approach h2 {
      max-width: 20ch;
    }
    .footer {
      margin-inline: -20px;
      padding: 32px 24px 16px;
      border-radius: 28px 28px 0 0;
    }
    .contact-button {
      padding-left: 18px;
    }
    .footer-bottom {
      margin-top: 28px;
      gap: 4px;
    }
  }
</style>
