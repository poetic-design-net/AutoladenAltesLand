---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Reviews from '../components/Reviews.astro';
import {
  ArrowRight01Icon,
  ArrowRight02Icon,
  BubbleChatIcon,
  Call02Icon,
  Cancel01Icon,
  Car03Icon,
  ShieldCheckIcon,
  SlidersHorizontalIcon,
  SteeringIcon,
  RefreshIcon,
  CheckmarkBadge01Icon,
  Car05Icon,
  Sent02Icon,
  Tick02Icon,
  WhatsappIcon,
  Mail01Icon,
  InstagramIcon,
} from '@hugeicons/core-free-icons';
import { contactLinks, getContent } from '../lib/content';
import { getFeaturedVehicles } from '../lib/vehicles';
import { httpsUrl } from '../lib/reviews';
import { businessSchema } from '../lib/seo';
import { getGoogleReviews } from '../lib/google-reviews';

const [{ site, page }, vehicles] = await Promise.all([getContent(), getFeaturedVehicles()]);
const { telHref, waHref, mailHref } = contactLinks(site);
const instagramHref = httpsUrl(site.instagramUrl);
const reviews = await getGoogleReviews(page.reviews);
// Google content must not become a CDN/browser cache or a permanent CMS copy.
if (page.reviews.useGoogleApi) Astro.response.headers.set('Cache-Control', 'private, no-store');
const navigationIcons = {
  alex: BubbleChatIcon,
  fahrzeuge: Car03Icon,
  ablauf: SteeringIcon,
  finanzierung: CheckmarkBadge01Icon,
};

/* Prozess-Route: x = Spaltenmitte in %, y = Anteil der Straßenhöhe (passt zum SVG-Pfad) */
const stepLayout = [
  { icon: BubbleChatIcon, x: 10, y: 0.667 },
  { icon: SlidersHorizontalIcon, x: 30, y: 0.333 },
  { icon: Car03Icon, x: 50, y: 0.583 },
  { icon: ShieldCheckIcon, x: 70, y: 0.292 },
  { icon: SteeringIcon, x: 90, y: 0.625 },
];
const steps = page.process.steps.map((step, index) => ({ ...stepLayout[index], ...step }));
const wayIcons = { leasing: RefreshIcon, finanzierung: CheckmarkBadge01Icon };
const ways = page.finance.ways.map((way) => ({
  ...way,
  icon: wayIcons[way.id as keyof typeof wayIcons] ?? CheckmarkBadge01Icon,
}));
const road = 'M100 80 C180 80 220 40 300 40 S420 70 500 70 S620 35 700 35 S820 75 900 75';
---

<Base
  title={page.seoTitle}
  description={page.seoDescription}
  ogImage={page.seoImage}
  ogImageAlt={page.seoImageAlt}
  siteName={site.brandName}
  structuredData={businessSchema(site, page.seoDescription)}
  theme="light"
  fonts="family=Geist:wght@300..700&family=Manrope:wght@400..700"
>
  <div class="app">
    <!-- ============================ KOPF ============================ -->
    <header class="bar">
      <a class="brand" href="#start" aria-label={`${site.brandName} – Startseite`}>
        <img class="logo" src={site.logo} alt="" width="72" height="72" />
        <span class="bar-name">{site.brandName}</span>
      </a>
      <nav class="header-nav" aria-label={page.header.navigationLabel}>
        {page.header.links.map((link) => <a href={`#${link.target}`}>{link.label}</a>)}
      </nav>
      <div class="header-actions">
        {
          waHref && (
            <a
              class="header-whatsapp"
              href={waHref}
              target="_blank"
              rel="noopener"
              aria-label={page.header.whatsappLabel}
            >
              <Icon icon={WhatsappIcon} />
            </a>
          )
        }
        <button class="header-contact" type="button" data-view="ask"
          >{page.header.contactLabel}</button
        >
      </div>
    </header>

    <main id="start" tabindex="-1">
      <div class="console">
        <div class="hero-fold">
          <div class="hero-row">
            <picture class="hero-artwork">
              <source
                media="(max-width: 760px)"
                srcset={`${page.hero.mobileImageSmall} 480w, ${page.hero.mobileImage} 941w`}
                sizes="calc(100vw - 40px)"
              />
              <img
                src={page.hero.desktopImage}
                srcset={`${page.hero.desktopImageSmall} 1000w, ${page.hero.desktopImage} 1672w`}
                sizes="(max-width: 760px) 100vw, (max-width: 1480px) calc(100vw - 80px), 1400px"
                alt={page.hero.imageAlt}
                width="1672"
                height="941"
                fetchpriority="high"
              />
            </picture>
            <div class="mid">
              <span class="hero-label">{page.hero.eyebrow}</span>
              <h1>{page.hero.headline}<br /><span class="a">{page.hero.headlineAccent}</span></h1>
              <blockquote class="sub">
                <p>{page.hero.quote}</p>
              </blockquote>

              <button class="primary hero-primary" type="button" data-view="ask">
                {page.hero.ctaLabel}
                <span class="go"><Icon icon={ArrowRight02Icon} /></span>
              </button>

              <div class="hero-links">
                {
                  waHref ? (
                    <a class="hero-whatsapp" href={waHref} target="_blank" rel="noopener">
                      <Icon icon={WhatsappIcon} />
                      {page.hero.whatsappLinkLabel}
                    </a>
                  ) : (
                    <button class="hero-whatsapp" type="button" data-view="ask">
                      <Icon icon={WhatsappIcon} />
                      {page.hero.whatsappLabel}
                    </button>
                  )
                }
                  <a class="hero-vehicles" href="#vehicle-slider">
                  {page.hero.vehiclesLinkLabel}
                  <Icon icon={ArrowRight02Icon} />
                </a>
              </div>
            </div>
          </div>

          <ul class="trust-strip" aria-label={page.intro.promisesLabel}>
            {
              page.intro.promises.map((promise) => (
                <li>
                  <>
                    <strong>{promise.title}</strong>
                    <span>{promise.text}</span>
                  </>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Vorstellung und Fahrzeuge bilden einen gemeinsamen Bereich. -->
        <section class="panel" id="fahrzeuge" aria-labelledby="offers-title" tabindex="-1">
          <div class="intro" id="alex" tabindex="-1">
            <div class="intro-heading">
              <span class="hero-label">{page.intro.eyebrow}</span>
              <h2 id="offers-title">{page.intro.heading}</h2>
            </div>
            <div class="intro-copy">
              <p>{page.intro.text}</p>
              <button class="alex-more" type="button" data-view="alex" aria-haspopup="dialog">
                {page.hero.aboutLinkLabel}<Icon icon={ArrowRight02Icon} />
              </button>
            </div>
          </div>
          <div class="offers-toolbar">
            <button class="panel-more panel-more--desktop" type="button" data-view="ask">
              {page.offers.ctaLabel}
              <Icon icon={ArrowRight02Icon} />
            </button>
            <div class="offers-controls" data-slider-controls hidden>
              <button
                class="offers-arrow offers-prev"
                type="button"
                data-slider-prev
                aria-controls="vehicle-slider"
                aria-label={page.offers.previousLabel}
                disabled
              >
                <Icon icon={ArrowRight02Icon} />
              </button>
              <button
                class="offers-arrow"
                type="button"
                data-slider-next
                aria-controls="vehicle-slider"
                aria-label={page.offers.nextLabel}
              >
                <Icon icon={ArrowRight02Icon} />
              </button>
            </div>
          </div>

          <div
            class="offers"
            id="vehicle-slider"
            role="region"
            aria-label={page.offers.sliderLabel}
            tabindex="0"
          >
            {
              vehicles.map((v) => (
                <a class="ocard" href={`/fahrzeuge/${v.id}`}>
                  <span class="ocard-image">
                    <img
                      class="ocard-pic"
                      src={v.image}
                      alt={v.alt}
                      width="640"
                      height="400"
                      loading="lazy"
                    />
                    {v.status && (
                      <span class="ocard-status">
                        <span class={`dot tone-${v.tone}`} />
                        {v.status}
                      </span>
                    )}
                  </span>
                  <span class="ocard-txt">
                    <span class="t">{v.name}</span>
                    <span class="prow">
                      {v.price.old && <span class="p-old">{v.price.old}</span>}
                      <span class="p-new">{v.price.value}</span>
                      <span class="p-unit">{page.offers.priceLabel}</span>
                    </span>
                    <span class="ocard-facts">
                      {v.features.slice(0, 3).map((feature) => (
                        <span>
                          <Icon icon={Tick02Icon} />
                          {feature}
                        </span>
                      ))}
                    </span>
                    <span class="ocard-go" aria-hidden="true">
                      <Icon icon={ArrowRight02Icon} />
                    </span>
                  </span>
                </a>
              ))
            }
          </div>

          <p class="tail">{site.priceNote}</p>
          <button class="panel-more panel-more--mobile" type="button" data-view="ask">
            {page.offers.ctaLabel}
            <Icon icon={ArrowRight02Icon} />
          </button>
        </section>
      </div>

      <!-- ============================ ABLAUF ============================ -->
      <section class="proc" id="ablauf" aria-labelledby="proc-title" tabindex="-1">
        <div class="proc-stage">
          <div class="proc-head">
            <h2 id="proc-title">{page.process.heading}</h2>
            <p>{page.process.intro}</p>
          </div>

          <div class="route" id="route">
            <svg class="road" viewBox="0 0 1000 120" preserveAspectRatio="none" aria-hidden="true">
              <path class="road-base" d={road}></path>
              <path class="road-dash" d={road}></path>
              <path class="road-draw" d={road} pathLength="1"></path>
            </svg>
            <ol class="steps">
              {
                steps.map((st, i) => (
                  <li class="step" style={`--x:${st.x}%;--y:${st.y};--i:${i}`}>
                    <span class="stop" aria-hidden="true">
                      <Icon icon={st.icon} />
                    </span>
                    <span class="num" aria-hidden="true">
                      0{i + 1}
                    </span>
                    <h3>{st.title}</h3>
                    <p>{st.text}</p>
                  </li>
                ))
              }
            </ol>
          </div>

          <div class="proc-cta">
            <button class="primary" type="button" data-view="ask">
              {page.process.ctaLabel}
              <span class="go"><Icon icon={ArrowRight02Icon} /></span>
            </button>
            <p class="proc-fine">{page.process.finePrint}</p>
          </div>
        </div>
      </section>

      <!-- ===================== LEASING & FINANZIERUNG ===================== -->
      <section class="fin" id="finanzierung" aria-labelledby="fin-title" tabindex="-1">
        <div class="fin-head" data-reveal>
          <h2 id="fin-title">{page.finance.heading}</h2>
          <p>{page.finance.intro}</p>
        </div>

        <div class="fork" data-reveal>
          <span class="fork-car" aria-hidden="true"><Icon icon={Car05Icon} /></span>
          <svg
            class="fork-lines"
            viewBox="0 0 1000 90"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path d="M500 0 V22 C500 60 250 40 250 90"></path>
            <path d="M500 0 V22 C500 60 750 40 750 90"></path>
          </svg>
        </div>

        <div class="seg fin-tabs" role="tablist" aria-label={page.finance.heading} data-reveal>
          {
            ways.map((w, i) => (
              <button
                class="seg-b"
                type="button"
                role="tab"
                id={`tab-${w.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`way-${w.id}`}
                data-way={w.id}
              >
                {w.title}
              </button>
            ))
          }
        </div>

        <div class="ways" data-reveal>
          {
            ways.map((w, i) => (
              <article
                class="way"
                id={`way-${w.id}`}
                role="tabpanel"
                aria-labelledby={`tab-${w.id}`}
                data-way={w.id}
                data-active={i === 0 ? '1' : '0'}
              >
                <span class="way-icon" aria-hidden="true">
                  <Icon icon={w.icon} />
                </span>
                <span class="way-tag">{w.tag}</span>
                <h3>{w.title}</h3>
                <p class="way-intro">{w.intro}</p>
                <ul class="way-pros">
                  {w.pros.map((x) => (
                    <li>
                      <Icon icon={Tick02Icon} />
                      {x}
                    </li>
                  ))}
                </ul>
                <p class="way-fit">{w.fit}</p>
              </article>
            ))
          }
          <span class="oder" aria-hidden="true">{page.finance.comparisonLabel}</span>
        </div>

        <div class="fin-help" data-reveal>
          <div>
            <h3>{page.finance.helpHeading}</h3>
            <p>{page.finance.helpText}</p>
          </div>
          <div class="fin-cta">
            <button class="primary" type="button" data-view="ask">
              {page.finance.ctaLabel}
              <span class="go"><Icon icon={ArrowRight02Icon} /></span>
            </button>
            <span class="proc-fine">{page.finance.finePrint}</span>
          </div>
        </div>

        <p class="fin-legal">{page.finance.legal}</p>
      </section>
      <Reviews content={reviews} />
    </main>

    <div class="mobile-navigation" id="mobile-navigation" data-expanded="0">
      <nav
        class="mobile-bar"
        id="mobile-bar"
        aria-label={page.mobileNavigation.label}
        aria-hidden="true"
        inert
      >
        {
          page.mobileNavigation.links.map((link) => (
            <a href={`#${link.target}`}>
              <>
                <Icon
                  icon={
                    navigationIcons[link.target as keyof typeof navigationIcons] ?? BubbleChatIcon
                  }
                />
                <span>{link.label}</span>
              </>
            </a>
          ))
        }
      </nav>
    </div>

    <footer class="foot" id="kontakt" tabindex="-1">
      <div class="footer-top">
        <svg class="footer-road" viewBox="0 0 620 360" fill="none" aria-hidden="true">
          <path d="M10 352C200 296 446 237 343 183C209 113 523 125 448 85C409 65 534 40 610 18"
          ></path>
          <path
            d="M65 358C247 293 469 243 364 184C252 122 537 128 467 85C430 62 546 38 615 19"
            stroke-dasharray="10 8"></path>
          <path d="M110 359C297 292 495 249 386 185C288 128 551 130 486 85C450 61 560 38 620 20"
          ></path>
        </svg>
        <div class="footer-invitation">
          <span class="footer-eyebrow">{page.footer.eyebrow}</span>
          <h2>{page.footer.heading}</h2>
          <p>{page.footer.intro}</p>
        </div>
        <div class="footer-actions">
          <button class="footer-primary" type="button" data-view="ask" aria-haspopup="dialog">
            {page.footer.ctaLabel}<span><Icon icon={ArrowRight02Icon} /></span>
          </button>
          {
            waHref && (
              <a class="footer-whatsapp" href={waHref} target="_blank" rel="noopener noreferrer">
                <Icon icon={WhatsappIcon} />
                {page.footer.whatsappCtaLabel}
              </a>
            )
          }
          <p>{page.footer.finePrint}</p>
        </div>
      </div>
      <div class="footer-main">
        <div class="footer-brand">
          <a class="brand" href="#start">
            <img src={site.logo} alt="" width="72" height="72" />
            <span>{site.brandName}<small>{page.footer.brandTagline}</small></span>
          </a>
        </div>
        <address class="footer-contact">
          <h3>{page.footer.contactLabel}</h3>
          {
            telHref && (
              <a href={telHref}>
                <Icon icon={Call02Icon} />
                {site.phone}
              </a>
            )
          }
          {
            mailHref && (
              <a href={mailHref}>
                <Icon icon={Mail01Icon} />
                {site.email}
              </a>
            )
          }
          {
            instagramHref && (
              <a href={instagramHref} target="_blank" rel="noopener noreferrer">
                <Icon icon={InstagramIcon} />
                {page.footer.instagramLabel}
              </a>
            )
          }
        </address>
        <nav class="footer-nav" aria-label={page.footer.navigationLabel}>
          {
            [
              { title: page.footer.exploreLabel, targets: ['fahrzeuge', 'ablauf', 'finanzierung'] },
              { title: page.footer.moreLabel, targets: ['alex', 'faq', 'ask'] },
            ].map((group) => (
              <div class="footer-nav-group">
                <h3>{group.title}</h3>
                {page.footer.links
                  .filter((link) => group.targets.includes(link.target))
                  .map((link) =>
                    link.target === 'faq' || link.target === 'ask' ? (
                      <button type="button" data-view={link.target} aria-haspopup="dialog">
                        {link.label}
                      </button>
                    ) : (
                      <a href={`#${link.target}`}>{link.label}</a>
                    )
                  )}
              </div>
            ))
          }
        </nav>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} {site.brandName}</span>
        <nav aria-label="Rechtliches">
          <a href="/impressum">{page.footer.legalLabel}</a>
          <a href="/datenschutz">{page.footer.privacyLabel}</a>
        </nav>
      </div>
    </footer>
  </div>

  <!-- ============================== SHEETS ============================== -->
  <div
    class="ovl"
    id="ovl"
    data-open="0"
    aria-hidden="true"
    inert
    data-context-prefix={page.form.contextPrefix}
    data-phone-label={page.form.phoneLabel}
    data-whatsapp-label={page.form.whatsappLabel}
    data-submitting-label={page.form.submittingLabel}
    data-submit-label={page.form.submitLabel}
    data-send-error-suffix={page.form.sendErrorSuffix}
  >
    <section
      class="sheet"
      id="sheet-faq"
      role="dialog"
      aria-modal="true"
      aria-labelledby="faq-title"
      hidden
    >
      <div class="grab" aria-hidden="true"></div>
      <div class="sh-head">
        <h2 class="sh-title" id="faq-title">{page.faq.title}</h2>
        <button class="sh-x" type="button" aria-label={page.form.closeLabel} data-close
          ><Icon icon={Cancel01Icon} /></button
        >
      </div>
      <div class="sh-body">
        <div class="faq-list">
          {
            page.faq.items.map((item) => (
              <details>
                <>
                  <summary>
                    {item.question}
                    <Icon icon={ArrowRight02Icon} />
                  </summary>
                  <p>{item.answer}</p>
                </>
              </details>
            ))
          }
        </div>
        <button class="primary" type="button" data-view="ask"
          >{page.about.ctaLabel}<span class="go"><Icon icon={ArrowRight02Icon} /></span></button
        >
      </div>
    </section>

    <!-- Alex: der ganze Text -->
    <section
      class="sheet"
      id="sheet-alex"
      role="dialog"
      aria-modal="true"
      aria-labelledby="alex-title"
      hidden
    >
      <div class="grab"></div>
      <div class="sh-head">
        <div>
          <div class="sh-title" id="alex-title">{page.about.title}</div>
          <div class="sh-sub">{page.about.subtitle}</div>
        </div>
        <button class="sh-x" type="button" aria-label={page.form.closeLabel} data-close>
          <Icon icon={Cancel01Icon} />
        </button>
      </div>
      <div class="sh-body">
        <div class="band">
          <img src={page.about.image} alt={page.about.imageAlt} width="1600" height="1067" />
          <div class="duo"></div>
        </div>
        <p class="lead">{page.about.lead}</p>
        {page.about.paragraphs.map((paragraph) => <p class="para">{paragraph}</p>)}
        <p class="kicker">{page.about.kicker}</p>

        <div class="rule">
          <span class="rule-l">{page.about.ruleHeading}</span>
          {page.about.ruleParagraphs.map((paragraph) => <p class="para">{paragraph}</p>)}
          <p class="para strong">{page.about.ruleEmphasis}</p>
        </div>

        <button class="send" type="button" data-view="ask">
          <Icon icon={BubbleChatIcon} />
          {page.about.ctaLabel}
        </button>
      </div>
    </section>

    <!-- Angebote -->
    <section
      class="sheet"
      id="sheet-cars"
      role="dialog"
      aria-modal="true"
      aria-labelledby="cars-title"
      hidden
    >
      <div class="grab"></div>
      <div class="sh-head">
        <div>
          <div class="sh-title" id="cars-title">{page.offers.heading}</div>
          <div class="sh-sub">{page.offers.sheetSubtitle}</div>
        </div>
        <button class="sh-x" type="button" aria-label={page.form.closeLabel} data-close>
          <Icon icon={Cancel01Icon} />
        </button>
      </div>
      <div class="sh-body">
        {
          vehicles.map((v) => (
            <a
              class="vrow"
              href={`/fahrzeuge/${v.id}`}
              data-id={v.id}
              data-vehicle={v.name}
              data-topic={v.topic}
            >
              <span
                class="pic"
                style={`background-image:url(${v.image})`}
                role="img"
                aria-label={v.alt}
              />
              <span class="vrow-txt">
                <span class="t">{v.name}</span>
                <span class="s">
                  <span class={`dot tone-${v.tone}`} />
                  {v.status}
                </span>
                <span class="prow">
                  {v.price.old && <span class="p-old">{v.price.old}</span>}
                  <span class="p-new">{v.price.value}</span>
                  <span class="p-unit">{page.offers.priceLabel}</span>
                </span>
              </span>
              <span class="ch">
                <Icon icon={ArrowRight01Icon} />
              </span>
            </a>
          ))
        }
        <p class="terms">{site.priceNote}</p>
      </div>
    </section>

    <!-- Anfrage -->
    <section
      class="sheet"
      id="sheet-ask"
      role="dialog"
      aria-modal="true"
      aria-labelledby="ask-title"
      hidden
    >
      <div class="grab"></div>
      <div class="sh-head">
        <div>
          <div class="sh-title" id="ask-title">{page.form.title}</div>
          <div class="sh-sub">{page.form.subtitle}</div>
        </div>
        <button class="sh-x" type="button" aria-label={page.form.closeLabel} data-close>
          <Icon icon={Cancel01Icon} />
        </button>
      </div>

      <form class="sh-body" id="form" novalidate>
        <div class="ctx" id="ctx" hidden>
          <Icon icon={Car03Icon} />
          <span id="ctx-name"></span>
          <button
            class="ctx-x"
            type="button"
            aria-label={page.form.removeContextLabel}
            id="ctx-clear"
          >
            <Icon icon={Cancel01Icon} size={14} />
          </button>
        </div>

        <div class="field">
          <span class="lbl" id="lbl-topic">{page.form.topicLabel}</span>
          <div class="chips" role="radiogroup" aria-labelledby="lbl-topic" id="chips">
            {
              page.form.topics.map((t, i) => (
                <button
                  class="chip"
                  type="button"
                  role="radio"
                  aria-checked={i === 0}
                  data-val={t.id}
                >
                  {t.label}
                </button>
              ))
            }
          </div>
        </div>

        <div class="field">
          <span class="lbl" id="lbl-ch">{page.form.channelLabel}</span>
          <div class="seg" role="radiogroup" aria-labelledby="lbl-ch" id="seg">
            <button class="seg-b" type="button" role="radio" aria-checked="true" data-val="tel">
              <Icon icon={Call02Icon} />
              {page.form.phoneOption}
            </button>
            <button class="seg-b" type="button" role="radio" aria-checked="false" data-val="wa">
              <Icon icon={WhatsappIcon} />
              {page.form.whatsappOption}
            </button>
          </div>
        </div>

        <div class="field">
          <label class="lbl" for="a-num" id="reach-label">{page.form.phoneLabel}</label>
          <input
            class="inp"
            id="a-num"
            name="reach"
            type="tel"
            autocomplete="tel"
            required
            placeholder={page.form.phonePlaceholder}
          />
          <p class="err" id="err-reach" hidden>{page.form.missingContactError}</p>
        </div>

        <div class="field">
          <label class="lbl" for="a-msg"
            >{page.form.messageLabel} <span class="opt">{page.form.optionalLabel}</span></label
          >
          <textarea
            class="inp"
            id="a-msg"
            name="message"
            rows="2"
            placeholder={page.form.messagePlaceholder}></textarea>
        </div>

        <button class="send" type="submit" id="submit">
          <Icon icon={Sent02Icon} />
          <span id="submit-label">{page.form.submitLabel}</span>
        </button>
        <p class="fine">{page.form.finePrint}</p>
        <p class="err center" id="err-send" hidden></p>
      </form>

      <div class="done" id="done" hidden>
        <span class="ring"><Icon icon={Tick02Icon} /></span>
        <h3>{page.form.successTitle}</h3>
        <p>{page.form.successText}</p>
        <button class="send" type="button" data-close>{page.form.doneLabel}</button>
      </div>
    </section>
  </div>
</Base>

<style>
