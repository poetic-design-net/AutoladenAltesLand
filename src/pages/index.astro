</style>

<script>
  import '../scripts/vehicle-slider';

  const navigation = document.getElementById('mobile-navigation')!;
  const mobileBar = document.getElementById('mobile-bar')!;
  const mobileViewport = matchMedia('(max-width: 760px)');
  const mobileNavigationScrollThreshold = 150;
  const barLinks = [...mobileBar.querySelectorAll<HTMLAnchorElement>('a')];
  const navSections = barLinks.map((link) => document.querySelector<HTMLElement>(link.hash)!);
  let navFrame = 0;

  const updateNavigation = () => {
    navFrame = 0;
    const expanded = mobileViewport.matches && window.scrollY >= mobileNavigationScrollThreshold;
    const hadNavFocus = navigation.contains(document.activeElement);
    const changed = navigation.dataset.expanded !== String(Number(expanded));
    navigation.dataset.expanded = String(Number(expanded));
    mobileBar.inert = !expanded;
    mobileBar.setAttribute('aria-hidden', String(!expanded));
    if (changed && hadNavFocus) {
      const target = expanded ? barLinks[0] : document.getElementById('start');
      target?.focus({ preventScroll: true });
    }
    if (expanded) {
      let active = 0;
      navSections.forEach((section, index) => {
        if (section.getBoundingClientRect().top <= Math.min(96, innerHeight * 0.2)) active = index;
      });
      barLinks.forEach((link, index) => {
        if (index === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    }
  };
  const queueNavigation = () => {
    if (!navFrame) navFrame = requestAnimationFrame(updateNavigation);
  };
  addEventListener('scroll', queueNavigation, { passive: true });
  addEventListener('resize', queueNavigation);
  addEventListener('pageshow', queueNavigation);
  mobileViewport.addEventListener('change', queueNavigation);
  updateNavigation();

  navigation.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', () => {
      document.querySelector<HTMLElement>(link.hash)?.focus({ preventScroll: true });
    });
  });

  const ovl = document.getElementById('ovl')!;
  const app = document.querySelector<HTMLElement>('.app')!;
  const sheets: Record<string, HTMLElement> = {
    faq: document.getElementById('sheet-faq')!,
    alex: document.getElementById('sheet-alex')!,
    cars: document.getElementById('sheet-cars')!,
    ask: document.getElementById('sheet-ask')!,
  };
  const form = document.getElementById('form') as HTMLFormElement;
  const done = document.getElementById('done')!;
  const ctx = document.getElementById('ctx')!;
  const ctxName = document.getElementById('ctx-name')!;
  const reach = document.getElementById('a-num') as HTMLInputElement;
  const reachLabel = document.getElementById('reach-label')!;
  const errReach = document.getElementById('err-reach')!;
  const errSend = document.getElementById('err-send')!;
  const submit = document.getElementById('submit') as HTMLButtonElement;
  const submitLabel = document.getElementById('submit-label')!;

  let current: string | null = null;
  let lastFocused: HTMLElement | null = null;
  let vehicle = '';
  let topic = 'firma';
  let channel = 'tel';

  function open(view: string, name?: string, tpc?: string) {
    if (!sheets[view]) return;
    if (!current) lastFocused = document.activeElement as HTMLElement;
    Object.entries(sheets).forEach(([k, el]) => (el.hidden = k !== view));
    current = view;
    ovl.dataset.view = view;
    ovl.dataset.open = '1';
    ovl.setAttribute('aria-hidden', 'false');
    ovl.inert = false;
    app.inert = true;
    document.body.style.overflow = 'hidden';

    if (view === 'ask') {
      if (name) {
        vehicle = name;
        ctxName.textContent = `${ovl.dataset.contextPrefix} ${name}`;
      }
      ctx.hidden = !vehicle;
      if (tpc) setTopic(tpc);
      form.hidden = false;
      done.hidden = true;
      errSend.hidden = true;
    }
    setTimeout(() => {
      if (current !== view) return;
      const target = view === 'ask' ? reach : sheets[view].querySelector<HTMLElement>('button');
      target?.focus();
    }, 80);
  }

  function close() {
    current = null;
    document.body.style.overflow = '';
    app.inert = false;
    lastFocused?.focus({ preventScroll: true });
    ovl.dataset.open = '0';
    ovl.setAttribute('aria-hidden', 'true');
    ovl.inert = true;
  }

  document
    .querySelectorAll<HTMLElement>('[data-view]')
    .forEach((el) =>
      el.addEventListener('click', () =>
        open(el.dataset.view!, el.dataset.vehicle, el.dataset.topic)
      )
    );
  document
    .querySelectorAll<HTMLElement>('[data-close]')
    .forEach((el) => el.addEventListener('click', close));
  ovl.addEventListener('click', (e) => {
    if (e.target === ovl) close();
  });
  document.getElementById('ctx-clear')!.addEventListener('click', () => {
    vehicle = '';
    ctx.hidden = true;
  });

  document.addEventListener('keydown', (e) => {
    if (!current) return;
    if (e.key === 'Escape') {
      e.preventDefault();
      close();
      return;
    }
    if (e.key !== 'Tab') return;
    const sheet = sheets[current];
    const f = Array.from(
      sheet.querySelectorAll<HTMLElement>('button, input, textarea, select, a[href], summary')
    ).filter((el) => el.offsetParent !== null);
    if (!f.length) return;
    const first = f[0];
    const last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  /* Chips + Segment */
  const chipGroup = document.getElementById('chips')!;
  function setTopic(val: string) {
    topic = val;
    chipGroup
      .querySelectorAll<HTMLElement>('.chip')
      .forEach((c) => c.setAttribute('aria-checked', String(c.dataset.val === val)));
  }
  chipGroup
    .querySelectorAll<HTMLElement>('.chip')
    .forEach((c) => c.addEventListener('click', () => setTopic(c.dataset.val!)));

  const segGroup = document.getElementById('seg')!;
  segGroup.querySelectorAll<HTMLElement>('.seg-b').forEach((b) =>
    b.addEventListener('click', () => {
      channel = b.dataset.val!;
      segGroup
        .querySelectorAll<HTMLElement>('.seg-b')
        .forEach((x) => x.setAttribute('aria-checked', String(x === b)));
      reachLabel.textContent =
        channel === 'wa' ? ovl.dataset.whatsappLabel! : ovl.dataset.phoneLabel!;
    })
  );

  /* Absenden */
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errSend.hidden = true;

    const value = reach.value.trim();
    const ok = value.replace(/\D/g, '').length >= 6;
    errReach.hidden = ok;
    reach.setAttribute('aria-invalid', String(!ok));
    if (!ok) {
      reach.focus();
      return;
    }

    const payload = {
      kind: topic === 'firma' || topic === 'transporter' ? 'firma' : 'privat',
      topic,
      vehicle,
      need: vehicle,
      channel,
      reach: value,
      message: String(new FormData(form).get('message') || ''),
      source: 'app',
    };

    submit.disabled = true;
    submitLabel.textContent = ovl.dataset.submittingLabel!;
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok)
        throw new Error((await res.json().catch(() => ({}))).error || 'Senden fehlgeschlagen');
      form.hidden = true;
      done.hidden = false;
    } catch (err) {
      errSend.textContent = `${(err as Error).message} ${ovl.dataset.sendErrorSuffix}`;
      errSend.hidden = false;
    } finally {
      submit.disabled = false;
      submitLabel.textContent = ovl.dataset.submitLabel!;
    }
  });

  /* Ablauf: Nur die Linie folgt dem Scrollen; die Section bleibt im normalen Seitenfluss. */
  const route = document.getElementById('route');
  if (route) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const horizontalRoute = matchMedia('(min-width: 901px)');
    const stops = route.querySelectorAll<HTMLElement>('.stop');
    if (stops.length) {
      let frame = 0;

      const draw = () => {
        frame = 0;
        const vh = innerHeight;
        const first = stops[0].getBoundingClientRect();
        const last = stops[stops.length - 1].getBoundingClientRect();
        const start = first.top + first.height / 2;
        const end = last.top + last.height / 2;
        // Die horizontale Route erst zeichnen, wenn sie im Blickfeld liegt,
        // und nicht schon abschließen, während die Überschrift noch oben steht.
        const entry = vh * (horizontalRoute.matches ? 0.65 : 0.85);
        const exit = vh * (horizontalRoute.matches ? 0.08 : 0.35);
        const travel = Math.max(1, end - start + entry - exit);
        const p = reduce.matches ? 1 : Math.min(1, Math.max(0, (entry - start) / travel));
        route.style.setProperty('--route-span', `${Math.max(0, end - start)}px`);
        route.style.setProperty('--p', p.toFixed(3));
      };

      const queueDraw = () => {
        if (!frame) frame = requestAnimationFrame(draw);
      };

      addEventListener('scroll', queueDraw, { passive: true });
      addEventListener('resize', queueDraw);
      reduce.addEventListener('change', queueDraw);
      new ResizeObserver(queueDraw).observe(route);
      draw();
    }
  }

  /* Leasing & Finanzierung: Einblenden + Tabs (mobil) */
  const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    reveals.forEach((el) => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            (e.target as HTMLElement).classList.add('in');
            io.unobserve(e.target);
          }
        }),
      { threshold: 0.15 }
    );
    reveals.forEach((el) => io.observe(el));
  }
  const finTabs = document.querySelectorAll<HTMLElement>('.fin-tabs [role="tab"]');
  finTabs.forEach((t) =>
    t.addEventListener('click', () => {
      finTabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      document
        .querySelectorAll<HTMLElement>('.way')
        .forEach((w) => (w.dataset.active = w.dataset.way === t.dataset.way ? '1' : '0'));
    })
  );

  /* Von der Detailseite: ?anfrage=<id> öffnet das Formular vorbelegt */
  const wanted = new URLSearchParams(location.search).get('anfrage');
  const pre =
    wanted && document.querySelector<HTMLElement>(`.vrow[data-id="${CSS.escape(wanted)}"]`);
  if (pre) open('ask', pre.dataset.vehicle, pre.dataset.topic);
</script>
