</style>

<script>
  const ovl = document.getElementById('ovl')!;
  const sheets: Record<string, HTMLElement> = {
    alex: document.getElementById('sheet-alex')!,
    cars: document.getElementById('sheet-cars')!,
    ask: document.getElementById('sheet-ask')!,
  };
  const form = document.getElementById('form') as HTMLFormElement;
  const done = document.getElementById('done')!;
  const ctx = document.getElementById('ctx')!;
  const ctxName = document.getElementById('ctx-name')!;
  const reach = document.getElementById('a-num') as HTMLInputElement;
  const reachLabel = document.getElementById('reach-label')!;
  const errReach = document.getElementById('err-reach')!;
  const errSend = document.getElementById('err-send')!;
  const submit = document.getElementById('submit') as HTMLButtonElement;
  const submitLabel = document.getElementById('submit-label')!;

  let current: string | null = null;
  let lastFocused: HTMLElement | null = null;
  let vehicle = '';
  let topic = 'firma';
  let channel = 'tel';

  function open(view: string, name?: string, tpc?: string) {
    if (!sheets[view]) return;
    if (!current) lastFocused = document.activeElement as HTMLElement;
    Object.entries(sheets).forEach(([k, el]) => (el.hidden = k !== view));
    current = view;
    ovl.dataset.open = '1';
    document.body.style.overflow = 'hidden';

    if (view === 'ask') {
      if (name) {
        vehicle = name;
        ctxName.textContent = `${ovl.dataset.contextPrefix} ${name}`;
      }
      ctx.hidden = !vehicle;
      if (tpc) setTopic(tpc);
      form.hidden = false;
      done.hidden = true;
      errSend.hidden = true;
      setTimeout(() => reach.focus(), 80);
    }
  }

  function close() {
    ovl.dataset.open = '0';
    current = null;
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  document.querySelectorAll<HTMLElement>('[data-view]').forEach((el) =>
    el.addEventListener('click', () => open(el.dataset.view!, el.dataset.vehicle, el.dataset.topic))
  );
  document.querySelectorAll<HTMLElement>('[data-close]').forEach((el) => el.addEventListener('click', close));
  ovl.addEventListener('click', (e) => {
    if (e.target === ovl) close();
  });
  document.getElementById('ctx-clear')!.addEventListener('click', () => {
    vehicle = '';
    ctx.hidden = true;
  });

  document.addEventListener('keydown', (e) => {
    if (!current) return;
    if (e.key === 'Escape') {
      e.preventDefault();
      close();
      return;
    }
    if (e.key !== 'Tab') return;
    const sheet = sheets[current];
    const f = Array.from(
      sheet.querySelectorAll<HTMLElement>('button, input, textarea, select, a[href]')
    ).filter((el) => el.offsetParent !== null);
    if (!f.length) return;
    const first = f[0];
    const last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  /* Chips + Segment */
  const chipGroup = document.getElementById('chips')!;
  function setTopic(val: string) {
    topic = val;
    chipGroup
      .querySelectorAll<HTMLElement>('.chip')
      .forEach((c) => c.setAttribute('aria-checked', String(c.dataset.val === val)));
  }
  chipGroup.querySelectorAll<HTMLElement>('.chip').forEach((c) =>
    c.addEventListener('click', () => setTopic(c.dataset.val!))
  );

  const segGroup = document.getElementById('seg')!;
  segGroup.querySelectorAll<HTMLElement>('.seg-b').forEach((b) =>
    b.addEventListener('click', () => {
      channel = b.dataset.val!;
      segGroup
        .querySelectorAll<HTMLElement>('.seg-b')
        .forEach((x) => x.setAttribute('aria-checked', String(x === b)));
      reachLabel.textContent = channel === 'wa' ? ovl.dataset.whatsappLabel! : ovl.dataset.phoneLabel!;
    })
  );

  /* Absenden */
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errSend.hidden = true;

    const value = reach.value.trim();
    const ok = value.replace(/\D/g, '').length >= 6;
    errReach.hidden = ok;
    reach.setAttribute('aria-invalid', String(!ok));
    if (!ok) {
      reach.focus();
      return;
    }

    const payload = {
      kind: topic === 'firma' || topic === 'transporter' ? 'firma' : 'privat',
      topic,
      vehicle,
      need: vehicle,
      channel,
      reach: value,
      message: String(new FormData(form).get('message') || ''),
      source: 'app',
    };

    submit.disabled = true;
    submitLabel.textContent = ovl.dataset.submittingLabel!;
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || 'Senden fehlgeschlagen');
      form.hidden = true;
      done.hidden = false;
    } catch (err) {
      errSend.textContent = `${(err as Error).message} ${ovl.dataset.sendErrorSuffix}`;
      errSend.hidden = false;
    } finally {
      submit.disabled = false;
      submitLabel.textContent = ovl.dataset.submitLabel!;
    }
  });

  /* Ablauf: Route zeichnet sich beim Scrollen, Schritte blenden nacheinander ein */
  const route = document.getElementById('route');
  if (route) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stepsEl = route.querySelectorAll<HTMLElement>('.step');
    if (reduce) {
      stepsEl.forEach((el) => el.classList.add('in'));
    } else {
      new IntersectionObserver(
        (entries, io) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              stepsEl.forEach((el) => el.classList.add('in'));
              io.disconnect();
            }
          }),
        { threshold: 0.2 }
      ).observe(route);
      const draw = () => {
        const r = route.getBoundingClientRect();
        const vh = innerHeight;
        // 0 wenn die Route unten ins Bild kommt, 1 wenn sie ~zwei Drittel hoch steht
        const p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.55 + r.height * 0.35)));
        route.style.setProperty('--p', p.toFixed(3));
      };
      addEventListener('scroll', draw, { passive: true });
      addEventListener('resize', draw);
      draw();
    }
  }

  /* Leasing & Finanzierung: Einblenden + Tabs (mobil) */
  const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    reveals.forEach((el) => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            (e.target as HTMLElement).classList.add('in');
            io.unobserve(e.target);
          }
        }),
      { threshold: 0.15 }
    );
    reveals.forEach((el) => io.observe(el));
  }
  const finTabs = document.querySelectorAll<HTMLElement>('.fin-tabs [role="tab"]');
  finTabs.forEach((t) =>
    t.addEventListener('click', () => {
      finTabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      document
        .querySelectorAll<HTMLElement>('.way')
        .forEach((w) => (w.dataset.active = w.dataset.way === t.dataset.way ? '1' : '0'));
    })
  );

  /* Von der Detailseite: ?anfrage=<id> öffnet das Formular vorbelegt */
  const wanted = new URLSearchParams(location.search).get('anfrage');
  const pre = wanted && document.querySelector<HTMLElement>(`.vrow[data-id="${CSS.escape(wanted)}"]`);
  if (pre) open('ask', pre.dataset.vehicle, pre.dataset.topic);
</script>
