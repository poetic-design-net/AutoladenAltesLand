  /* Mobil & Tablet: Tabs, ein Weg sichtbar */
  @media (max-width: 900px) {
    .fin {
      margin-top: 64px;
      padding-top: 44px;
    }
    .fin-head {
      text-align: left;
      margin-inline: 0;
    }
    .fork {
      display: none;
    }
    .seg.fin-tabs {
      display: grid;
      margin-top: 24px;
    }
    .ways {
      grid-template-columns: 1fr;
      margin-top: 12px;
      border-radius: 24px;
    }
    .way {
      padding: 26px 22px 24px;
      border-radius: 24px;
    }
    .way + .way {
      box-shadow: none;
    }
    .way[data-active='0'] {
      display: none;
    }
    .way[data-active='1'] {
      animation: way-in 0.35s var(--ease);
    }
    .oder {
      display: none;
    }
    .way h3 {
      font-size: 24px;
    }
    .way-pros li {
      font-size: 15px;
    }
    .fin-help {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 24px 22px;
      margin-top: 16px;
    }
    .fin-cta {
      align-items: stretch;
    }
    .fin-cta .primary {
      width: 100%;
      justify-content: space-between;
    }
    .fin-cta .proc-fine {
      text-align: center;
    }
  }
  @keyframes way-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (max-width: 760px) {
    .fin {
      margin: 48px 20px 0;
