  /* -------------------------------- Ablauf ------------------------------- */
  .proc {
    position: relative;
    width: 100%;
    max-width: 1240px;
    margin: 96px auto 0;
    padding-top: 64px;
    border-top: 1px solid var(--line);
  }
  .proc-stage {
    position: relative;
  }
  .proc-head {
    max-width: 560px;
  }
  .proc-head h2 {
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .proc-head p {
    margin-top: 14px;
    font-size: 16.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .route {
    --road-h: 170px;
    position: relative;
    margin-top: 28px;
    padding-top: var(--road-h);
    --p: 0;
  }
  .road {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: var(--road-h);
    overflow: visible;
    fill: none;
  }
  .road path {
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .road-base {
    stroke: var(--surface);
    stroke-width: 14;
  }
  .road-dash {
    stroke: var(--line);
    stroke-width: 1.5;
    stroke-dasharray: 6 8;
  }
  .road .road-draw {
    /* Keep normalized dash lengths tied to the scaled path, not screen pixels. */
    vector-effect: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--p));
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
  }
  .step {
    position: relative;
    padding: 0 8px;
    text-align: center;
  }
  .stop {
    position: absolute;
    left: 50%;
    top: calc(-1 * var(--road-h) + var(--y) * var(--road-h));
    width: 50px;
    height: 50px;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--surface);
    color: var(--accent);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--sh-soft);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
  .stop .ic {
    width: 21px;
    height: 21px;
  }
  .step:hover .stop {
    transform: translate(-50%, -50%) scale(1.08);
    box-shadow:
      inset 0 0 0 1.5px var(--accent-hi),
      var(--sh-lift);
  }
  .num {
    display: block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    transition: color 0.25s var(--ease);
  }
  .step:hover .num {
    color: var(--accent);
  }
  .step h3 {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .step p {
    margin-top: 8px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  /* Ziel */
  .step:last-child .stop {
    width: 58px;
    height: 58px;
    background: var(--accent);
    color: #fff;
    box-shadow:
      0 0 0 7px var(--green-ring),
      0 16px 30px -12px rgba(0, 51, 102, 0.6);
  }
  .step:last-child .stop .ic {
    width: 24px;
    height: 24px;
  }
  .step:last-child:hover .stop {
    box-shadow:
      0 0 0 9px var(--green-ring),
      0 20px 34px -12px rgba(0, 51, 102, 0.7);
  }
  .step:last-child h3 {
    color: var(--accent);
  }

  .proc-cta {
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .proc-cta .primary {
    margin: 0;
    width: auto;
    display: inline-flex;
    gap: 18px;
    padding: 0 10px 0 24px;
  }
  .proc-fine {
    font-size: 13px;
    color: var(--ink-3);
  }

  @media (max-width: 1100px) {
    .steps {
      gap: 12px;
    }
    .step h3 {
      font-size: 15px;
    }
  }

  /* Mobil & Tablet: vertikale Route */
  @media (max-width: 900px) {
    .proc {
      margin-top: 64px;
      padding-top: 44px;
    }
    .route {
      padding-top: 0;
      margin-top: 30px;
    }
    .road {
      display: none;
    }
    .steps {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 26px;
    }
    .steps::before,
    .steps::after {
      content: '';
      position: absolute;
      left: 23px;
      top: 24px;
      height: var(--route-span, calc(100% - 48px));
      width: 0;
      border-left: 1.5px dashed var(--line);
    }
    .steps::after {
      border-left: 2px solid var(--accent);
      transform: scaleY(var(--p));
      transform-origin: top;
    }
    .step {
      display: grid;
      grid-template-columns: 48px 1fr;
      column-gap: 18px;
      padding: 0;
      text-align: left;
      transform: none;
    }
    .step > :not(.stop) {
      grid-column: 2;
    }
    .stop {
      position: relative;
      z-index: 1;
      grid-row: 1 / span 3;
      left: auto;
      top: 0;
      transform: none;
      width: 48px;
      height: 48px;
    }
    .step:hover .stop {
      transform: scale(1.06);
    }
    .step:last-child .stop {
      width: 48px;
      height: 48px;
    }
    .step h3 {
      font-size: 17px;
    }
    .step p {
      font-size: 15px;
      max-width: 460px;
    }
    .proc-cta {
      align-items: stretch;
      margin-top: 36px;
    }
    .proc-cta .primary {
      width: 100%;
      justify-content: space-between;
    }
    .proc-fine {
      text-align: center;
    }
