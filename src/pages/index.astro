  /* ------------------------ Leasing & Finanzierung ----------------------- */
  .fin {
    position: relative;
    width: 100%;
    max-width: 1240px;
    margin: 96px auto 0;
    padding-top: 64px;
    border-top: 1px solid var(--line);
  }
  [data-reveal] {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  [data-reveal].in {
    opacity: 1;
    transform: none;
  }
  .fin-head {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
  }
  .fin-head h2 {
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .fin-head p {
    margin-top: 14px;
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* Gabelung: ein Auto, zwei Wege */
  .fork {
    position: relative;
    height: 150px;
    margin-top: 28px;
    transition-delay: 0.1s;
  }
  .fork-car {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    box-shadow:
      0 0 0 7px var(--green-ring),
      0 16px 30px -12px rgba(0, 51, 102, 0.6);
    z-index: 1;
  }
  .fork-car .ic {
    width: 26px;
    height: 26px;
  }
  .fork-lines {
    position: absolute;
    left: 0;
    top: 60px;
    width: 100%;
    height: 90px;
    fill: none;
    overflow: visible;
  }
  .fork-lines path {
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-dasharray: 5 7;
    vector-effect: non-scaling-stroke;
    opacity: 0.55;
  }

  .seg.fin-tabs {
    display: none;
  }
  .fin-tabs .seg-b[aria-selected='true'] {
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--sh-soft);
  }

  /* Eine Fläche, zwei Wege */
  .ways {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: 30px;
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--sh-soft);
    transition-delay: 0.2s;
  }
  .way {
    position: relative;
    padding: 40px 44px 40px;
    border-radius: 30px;
    transition: background 0.25s var(--ease);
  }
  .way:hover {
    background: var(--surface-2);
  }
  .way + .way {
    box-shadow: inset 1px 0 0 var(--line);
  }
  .oder {
    position: absolute;
    left: 50%;
    top: 40px;
    transform: translateX(-50%);
    padding: 4px 11px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    z-index: 1;
  }
  .way-icon {
