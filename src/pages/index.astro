---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { ArrowRight01Icon, ArrowRight02Icon, BubbleChatIcon, Call02Icon, Cancel01Icon, Car03Icon, ShieldCheckIcon, SlidersHorizontalIcon, SteeringIcon, RefreshIcon, CheckmarkBadge01Icon, Car05Icon, Sent02Icon, Tick02Icon, WhatsappIcon } from '@hugeicons/core-free-icons';
import { contactLinks, getContent } from '../lib/content';
import { getFeaturedVehicles } from '../lib/vehicles';

const [{ site, page }, vehicles] = await Promise.all([getContent(), getFeaturedVehicles()]);
const { telHref, waHref } = contactLinks(site);

/* Prozess-Route: x = Spaltenmitte in %, y = Anteil der Straßenhöhe (passt zum SVG-Pfad) */
const stepLayout = [
  { icon: BubbleChatIcon, x: 10, y: 0.667 },
  { icon: SlidersHorizontalIcon, x: 30, y: 0.333 },
  { icon: Car03Icon, x: 50, y: 0.583 },
  { icon: ShieldCheckIcon, x: 70, y: 0.292 },
  { icon: SteeringIcon, x: 90, y: 0.625 },
];
const steps = page.process.steps.map((step, index) => ({ ...stepLayout[index], ...step }));
const wayIcons = { leasing: RefreshIcon, finanzierung: CheckmarkBadge01Icon };
const ways = page.finance.ways.map((way) => ({
  ...way,
  icon: wayIcons[way.id as keyof typeof wayIcons] ?? CheckmarkBadge01Icon,
}));
const road = 'M100 80 C180 80 220 40 300 40 S420 70 500 70 S620 35 700 35 S820 75 900 75';
---

<Base
  title={page.seoTitle}
  description={page.seoDescription}
  ogImage={site.logo}
  theme="light"
  fonts="family=Geist:wght@300..700&family=Manrope:wght@400..700"
>
  <div class="app">
    <!-- ============================ KOPF ============================ -->
    <header class="bar">
      <img class="logo" src={site.logo} alt={site.logoAlt} width="56" height="56" />
      <span>
        <span class="bar-name">{site.brandName}</span>
      </span>
    </header>

    <div class="console">
      <div class="hero-row">
      <!-- ------------------------- Alex (Spalte 1) ------------------------ -->
      <button class="alex" type="button" data-view="alex" aria-label={page.hero.moreLabel}>
        <span class="alex-pic"
          ><img src={page.about.image} alt={page.about.imageAlt} width="1600" height="1067" /></span
        >
      </button>

      <!-- ------------------------- Mitte (Spalte 2) ----------------------- -->
      <main class="mid">
        <span class="live"><span class="dot"></span>{page.hero.availability}</span>
        <h1>{page.hero.headline}<br /><span class="a">{page.hero.headlineAccent}</span></h1>
        <blockquote class="sub">
          <p>{page.hero.quote}</p>
        </blockquote>

        <div class="alex-txt">
          <strong class="alex-n">{page.hero.personTitle}</strong>
          <span class="alex-r">{page.hero.personIntro}</span>
          <button class="alex-more" type="button" data-view="alex">
            {page.hero.moreLabel}
            <Icon icon={ArrowRight02Icon} />
          </button>
        </div>

        <div class="acts">
          {
            telHref ? (
              <a class="act" href={telHref}>
                <Icon icon={Call02Icon} />
                {page.hero.phoneLabel}
              </a>
            ) : (
              <button class="act" type="button" data-view="ask">
                <Icon icon={Call02Icon} />
                {page.hero.phoneLabel}
              </button>
            )
          }
          {
            waHref ? (
              <a class="act" href={waHref} target="_blank" rel="noopener">
                <Icon icon={WhatsappIcon} />
                {page.hero.whatsappLabel}
              </a>
            ) : (
              <button class="act" type="button" data-view="ask">
                <Icon icon={WhatsappIcon} />
                {page.hero.whatsappLabel}
              </button>
            )
          }
        </div>

        <button class="primary hero-primary" type="button" data-view="ask">
          {page.hero.ctaLabel}
          <span class="go"
            ><Icon icon={ArrowRight02Icon} /></span
          >
        </button>
      </main>
      </div>

      <!-- --------------------- Angebote (eigene Reihe) -------------------- -->
      <section class="panel">
        <div class="panel-head">
          <h2>{page.offers.heading}</h2>
          <button class="panel-more" type="button" data-view="cars">
            {page.offers.allLabel}
            <Icon icon={ArrowRight02Icon} />
          </button>
        </div>

        <!-- Desktop: drei Karten nebeneinander -->
        <div class="offers">
          {
            vehicles.map((v) => (
              <a class="ocard" href={`/fahrzeuge/${v.id}`}>
                <span class="ocard-pic" style={`background-image:url(${v.image})`} role="img" aria-label={v.alt} />
                <span class="ocard-txt">
                  <span class="t">{v.name}</span>
                  <span class="s">
                    <span class={`dot tone-${v.tone}`} />
                    {v.status}
                  </span>
                  <span class="prow">
                    {v.price.old && <span class="p-old">{v.price.old}</span>}
                    <span class="p-new">{v.price.value}</span>
                    <span class="p-unit">{page.offers.priceLabel}</span>
                  </span>
                </span>
                <span class="ch">
                  <Icon icon={ArrowRight01Icon} />
                </span>
              </a>
            ))
          }
        </div>

        <!-- Mobil: Streifen -->
        <div class="strip">
          {
            vehicles.map((v) => (
              <a class="offer" href={`/fahrzeuge/${v.id}`}>
                <span class="offer-media">
                  <span class="offer-img" style={`background-image:url(${v.image})`} role="img" aria-label={v.alt} />
                  <span class="offer-fade" />
                  <span class={`pin tone-${v.tone}`} />
                </span>
                <span class="offer-body">
                  <span class="offer-name">{v.name}</span>
                  <span class="prow">
                    {v.price.old && <span class="p-old">{v.price.old}</span>}
                    <span class="p-new">{v.price.value}</span>
                  </span>
                </span>
              </a>
            ))
          }
        </div>

        <p class="tail">{site.priceNote}</p>
      </section>
    </div>

    <!-- ============================ ABLAUF ============================ -->
    <section class="proc" id="ablauf" aria-labelledby="proc-title">
      <div class="proc-head">
        <h2 id="proc-title">{page.process.heading}</h2>
        <p>{page.process.intro}</p>
      </div>

      <div class="route" id="route">
        <svg class="road" viewBox="0 0 1000 120" preserveAspectRatio="none" aria-hidden="true">
          <path class="road-base" d={road} />
          <path class="road-dash" d={road} />
          <path class="road-draw" d={road} pathLength="1" />
        </svg>
        <ol class="steps">
          {
            steps.map((st, i) => (
              <li class="step" style={`--x:${st.x}%;--y:${st.y};--i:${i}`}>
                <span class="stop" aria-hidden="true">
                  <Icon icon={st.icon} />
                </span>
                <span class="num" aria-hidden="true">0{i + 1}</span>
                <h3>{st.title}</h3>
                <p>{st.text}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="proc-cta">
        <button class="primary" type="button" data-view="ask">
          {page.process.ctaLabel}
          <span class="go"><Icon icon={ArrowRight02Icon} /></span>
        </button>
        <p class="proc-fine">{page.process.finePrint}</p>
      </div>
    </section>

    <!-- ===================== LEASING & FINANZIERUNG ===================== -->
    <section class="fin" id="finanzierung" aria-labelledby="fin-title">
      <div class="fin-head" data-reveal>
        <h2 id="fin-title">{page.finance.heading}</h2>
        <p>{page.finance.intro}</p>
      </div>

      <div class="fork" data-reveal>
        <span class="fork-car" aria-hidden="true"><Icon icon={Car05Icon} /></span>
        <svg class="fork-lines" viewBox="0 0 1000 90" preserveAspectRatio="none" aria-hidden="true">
          <path d="M500 0 V22 C500 60 250 40 250 90" />
          <path d="M500 0 V22 C500 60 750 40 750 90" />
        </svg>
      </div>

      <div class="seg fin-tabs" role="tablist" aria-label={page.finance.heading} data-reveal>
        {
          ways.map((w, i) => (
            <button class="seg-b" type="button" role="tab" id={`tab-${w.id}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`way-${w.id}`} data-way={w.id}>
              {w.title}
            </button>
          ))
        }
      </div>

      <div class="ways" data-reveal>
        {
          ways.map((w, i) => (
            <article class="way" id={`way-${w.id}`} role="tabpanel" aria-labelledby={`tab-${w.id}`} data-way={w.id} data-active={i === 0 ? '1' : '0'}>
              <span class="way-icon" aria-hidden="true"><Icon icon={w.icon} /></span>
              <span class="way-tag">{w.tag}</span>
              <h3>{w.title}</h3>
              <p class="way-intro">{w.intro}</p>
              <ul class="way-pros">
                {w.pros.map((x) => (
                  <li>
                    <Icon icon={Tick02Icon} />
                    {x}
                  </li>
                ))}
              </ul>
              <p class="way-fit">{w.fit}</p>
            </article>
          ))
        }
        <span class="oder" aria-hidden="true">{page.finance.comparisonLabel}</span>
      </div>

      <div class="fin-help" data-reveal>
        <div>
          <h3>{page.finance.helpHeading}</h3>
          <p>{page.finance.helpText}</p>
        </div>
        <div class="fin-cta">
          <button class="primary" type="button" data-view="ask">
            {page.finance.ctaLabel}
            <span class="go"><Icon icon={ArrowRight02Icon} /></span>
          </button>
          <span class="proc-fine">{page.finance.finePrint}</span>
        </div>
      </div>

      <p class="fin-legal">{page.finance.legal}</p>
    </section>

    <footer class="foot">
      <span>
        {page.footer.phonePrefix} {site.phone ? site.phone : <span class="ph">[Nummer eintragen]</span>} · {page.footer.emailPrefix} {
          site.email ? site.email : <span class="ph">[Adresse eintragen]</span>
        }
      </span>
      <span class="links">
        <a href="/impressum">{page.footer.legalLabel}</a>
        <a href="/datenschutz">{page.footer.privacyLabel}</a>
      </span>
    </footer>
  </div>

  <!-- ============================== SHEETS ============================== -->
  <div
    class="ovl"
    id="ovl"
    data-open="0"
    data-context-prefix={page.form.contextPrefix}
    data-phone-label={page.form.phoneLabel}
    data-whatsapp-label={page.form.whatsappLabel}
    data-submitting-label={page.form.submittingLabel}
    data-submit-label={page.form.submitLabel}
    data-send-error-suffix={page.form.sendErrorSuffix}
  >
    <!-- Alex: der ganze Text -->
    <section class="sheet" id="sheet-alex" role="dialog" aria-modal="true" aria-labelledby="alex-title" hidden>
      <div class="grab"></div>
      <div class="sh-head">
        <div>
          <div class="sh-title" id="alex-title">{page.about.title}</div>
          <div class="sh-sub">{page.about.subtitle}</div>
        </div>
        <button class="sh-x" type="button" aria-label={page.form.closeLabel} data-close>
          <Icon icon={Cancel01Icon} />
        </button>
      </div>
      <div class="sh-body">
        <div class="band">
          <img src={page.about.image} alt={page.about.imageAlt} width="1600" height="1067" />
          <div class="duo"></div>
        </div>
        <p class="lead">{page.about.lead}</p>
        {page.about.paragraphs.map((paragraph) => <p class="para">{paragraph}</p>)}
        <p class="kicker">{page.about.kicker}</p>

        <div class="rule">
          <span class="rule-l">{page.about.ruleHeading}</span>
          {page.about.ruleParagraphs.map((paragraph) => <p class="para">{paragraph}</p>)}
          <p class="para strong">{page.about.ruleEmphasis}</p>
        </div>

        <button class="send" type="button" data-view="ask">
          <Icon icon={BubbleChatIcon} />
          {page.about.ctaLabel}
        </button>
      </div>
    </section>

    <!-- Angebote -->
    <section class="sheet" id="sheet-cars" role="dialog" aria-modal="true" aria-labelledby="cars-title" hidden>
      <div class="grab"></div>
      <div class="sh-head">
        <div>
          <div class="sh-title" id="cars-title">{page.offers.heading}</div>
          <div class="sh-sub">{page.offers.sheetSubtitle}</div>
        </div>
        <button class="sh-x" type="button" aria-label={page.form.closeLabel} data-close>
          <Icon icon={Cancel01Icon} />
        </button>
      </div>
      <div class="sh-body">
        {
          vehicles.map((v) => (
            <a class="vrow" href={`/fahrzeuge/${v.id}`} data-id={v.id} data-vehicle={v.name} data-topic={v.topic}>
              <span class="pic" style={`background-image:url(${v.image})`} role="img" aria-label={v.alt} />
              <span class="vrow-txt">
                <span class="t">{v.name}</span>
                <span class="s">
                  <span class={`dot tone-${v.tone}`} />
                  {v.status}
                </span>
                <span class="prow">
                  {v.price.old && <span class="p-old">{v.price.old}</span>}
                  <span class="p-new">{v.price.value}</span>
                  <span class="p-unit">{page.offers.priceLabel}</span>
                </span>
              </span>
              <span class="ch">
                <Icon icon={ArrowRight01Icon} />
              </span>
            </a>
          ))
        }
        <p class="terms">{site.priceNote}</p>
      </div>
    </section>

    <!-- Anfrage -->
    <section class="sheet" id="sheet-ask" role="dialog" aria-modal="true" aria-labelledby="ask-title" hidden>
      <div class="grab"></div>
      <div class="sh-head">
        <div>
          <div class="sh-title" id="ask-title">{page.form.title}</div>
          <div class="sh-sub">{page.form.subtitle}</div>
        </div>
        <button class="sh-x" type="button" aria-label={page.form.closeLabel} data-close>
          <Icon icon={Cancel01Icon} />
        </button>
      </div>

      <form class="sh-body" id="form" novalidate>
        <div class="ctx" id="ctx" hidden>
          <Icon icon={Car03Icon} />
          <span id="ctx-name"></span>
          <button class="ctx-x" type="button" aria-label={page.form.removeContextLabel} id="ctx-clear">
            <Icon icon={Cancel01Icon} size={14} />
          </button>
        </div>

        <div class="field">
          <span class="lbl" id="lbl-topic">{page.form.topicLabel}</span>
          <div class="chips" role="radiogroup" aria-labelledby="lbl-topic" id="chips">
            {
              page.form.topics.map((t, i) => (
                <button class="chip" type="button" role="radio" aria-checked={i === 0} data-val={t.id}>
                  {t.label}
                </button>
              ))
            }
          </div>
        </div>

        <div class="field">
          <span class="lbl" id="lbl-ch">{page.form.channelLabel}</span>
          <div class="seg" role="radiogroup" aria-labelledby="lbl-ch" id="seg">
            <button class="seg-b" type="button" role="radio" aria-checked="true" data-val="tel">
              <Icon icon={Call02Icon} />
              {page.form.phoneOption}
            </button>
            <button class="seg-b" type="button" role="radio" aria-checked="false" data-val="wa">
              <Icon icon={WhatsappIcon} />
              {page.form.whatsappOption}
            </button>
          </div>
        </div>

        <div class="field">
          <label class="lbl" for="a-num" id="reach-label">{page.form.phoneLabel}</label>
          <input class="inp" id="a-num" name="reach" type="tel" autocomplete="tel" required placeholder={page.form.phonePlaceholder} />
          <p class="err" id="err-reach" hidden>{page.form.missingContactError}</p>
        </div>

        <div class="field">
          <label class="lbl" for="a-msg">{page.form.messageLabel} <span class="opt">{page.form.optionalLabel}</span></label>
          <textarea class="inp" id="a-msg" name="message" rows="2" placeholder={page.form.messagePlaceholder}></textarea>
        </div>

        <button class="send" type="submit" id="submit">
          <Icon icon={Sent02Icon} />
          <span id="submit-label">{page.form.submitLabel}</span>
        </button>
        <p class="fine">{page.form.finePrint}</p>
        <p class="err center" id="err-send" hidden></p>
      </form>

      <div class="done" id="done" hidden>
        <span class="ring"
          ><Icon icon={Tick02Icon} /></span
        >
        <h3>{page.form.successTitle}</h3>
        <p>{page.form.successText}</p>
        <button class="send" type="button" data-close>{page.form.doneLabel}</button>
      </div>
    </section>
  </div>
</Base>

<style>
  :global(body[data-theme='light']) {
    --font: 'Geist', 'Manrope', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  }
  .app {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 24px 40px 26px;
  }
  .app::before {
    display: none;
  }
  .app::after {
    display: none;
  }

  /* --------------------------------- Kopf -------------------------------- */
  .bar {
    position: relative;
    flex: none;
    width: 100%;
    max-width: 1150px;
    margin-inline: auto;
    height: 54px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .logo {
    width: 54px;
    height: 54px;
    flex: none;
    object-fit: contain;
  }
  .bar-name {
    display: block;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.014em;
  }
  .bar-sub {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .live-top {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 40px;
    padding: 0 17px 0 13px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 13.5px;
    color: var(--ink-2);
  }

  /* -------------------------------- Bühne -------------------------------- */
  .console {
    position: relative;
    flex: 1;
    width: 100%;
    max-width: 1150px;
    margin: 14px auto 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 0;
  }
  .hero-row {
    display: grid;
    grid-template-columns: 525px 460px;
    gap: 53px;
    justify-content: start;
    height: 430px;
  }

  /* Alex */
  .alex {
    position: relative;
    display: flex;
    border-radius: 22px;
    overflow: hidden;
    background: var(--surface-2);
    padding: 0;
    box-shadow: none;
    transition: transform 0.2s var(--ease);
  }
  .alex:hover {
    transform: translateY(-2px);
  }
  .alex-pic {
    position: absolute;
    inset: 0;
  }
  .alex-pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left 50%;
    transform: scale(1.35);
    transform-origin: 50% 23%;
  }
  .alex-pic::after {
    display: none;
  }
  .alex-txt {
    margin-top: 23px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .live {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 13px 0 11px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px rgba(0, 153, 102, 0.16), 0 3px 10px rgba(6, 26, 48, 0.04);
    font-size: 11.5px;
    font-weight: 500;
    color: #31846c;
  }
  .alex-n {
    font-size: 16.5px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.018em;
  }
  .alex-r {
    margin-top: 3px;
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .alex-more {
    margin-top: 15px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: auto;
    padding: 0;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--accent-text);
    transition: color 0.16s var(--ease);
  }
  .alex-more:hover {
    color: var(--accent-hi);
  }
  .alex-more .ic {
    width: 16px;
    height: 16px;
  }

  /* Mitte */
  .mid {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 5px 0 0;
    max-width: none;
  }
  .eyebrow {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 34px;
    padding: 0 15px 0 12px;
    border-radius: 999px;
    background: rgba(0, 51, 102, 0.08);
    box-shadow: inset 0 0 0 1px rgba(0, 51, 102, 0.2);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--accent);
  }
  .eyebrow .ic {
    width: 15px;
    height: 15px;
  }
  h1 {
    margin-top: 22px;
    font-size: clamp(34px, 3.05vw, 40px);
    line-height: 1.06;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  h1 .a {
    color: var(--accent-text);
  }
  .sub {
    position: relative;
    margin-top: 17px;
    margin-inline: 0;
    max-width: 430px;
    padding: 1px 0 1px 12px;
    border-left: 2px solid var(--green);
  }
  .sub::before {
    display: none;
  }
  .sub p {
    font-size: 15px;
    line-height: 1.35;
    font-weight: 400;
    letter-spacing: -0.014em;
    color: var(--ink);
  }
  .acts {
    margin-top: 25px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .act {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 40px;
    border-radius: 7px;
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.014em;
    transition: background 0.16s var(--ease), transform 0.16s var(--ease);
  }
  .act:hover {
    background: var(--surface-2);
    transform: translateY(-1px);
  }
  .act .ic {
    color: var(--ink-2);
  }
  .primary {
    margin-top: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    height: 64px;
    padding: 0 12px 0 24px;
    border-radius: 20px;
    background: var(--accent);
    color: #fff;
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: -0.016em;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), 0 16px 30px -14px rgba(0, 51, 102, 0.55);
    transition: background 0.16s var(--ease), transform 0.16s var(--ease);
  }
  .primary:hover {
    background: var(--accent-deep);
    transform: translateY(-1px);
  }
  .primary .go {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
  }
  .hero-primary {
    margin-top: 10px;
    height: 42px;
    padding: 0 14px 0 18px;
    border-radius: 7px;
    font-size: 13.5px;
    font-weight: 500;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14);
  }
  .hero-primary .go {
    width: auto;
    height: auto;
    border-radius: 0;
    background: none;
    box-shadow: none;
  }
  .note {
    margin-top: 18px;
    font-size: 13px;
    color: var(--ink-3);
  }

  /* Angebote */
  .panel {
    flex: none;
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2px 0 4px;
  }
  .panel h2 {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .panel-more {
    display: none;
    align-items: center;
    gap: 5px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .panel-more .ic {
    width: 14px;
    height: 14px;
  }
  .offers {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .ocard {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 91px;
    padding: 8px 10px;
    border-radius: 10px;
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .ocard,
  .offer,
  .vrow {
    color: var(--ink);
  }
  .vrow {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 12px 10px 10px;
    margin-top: 10px;
    border-radius: 18px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background 0.18s var(--ease);
  }
  .vrow:first-child {
    margin-top: 0;
  }
  .vrow:hover {
    background: var(--line);
  }
  .vrow .pic {
    width: 88px;
    height: 68px;
    border-radius: 12px;
    background-size: cover;
    background-position: 50%;
    flex: none;
  }
  .vrow-txt {
    min-width: 0;
    flex: 1;
  }
  .vrow .t {
    display: block;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.018em;
  }
  .vrow .s {
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    color: var(--ink-2);
  }
  .vrow .ch {
    color: var(--ink-3);
  }
  .ocard:hover {
    background: var(--surface-2);
    transform: translateY(-2px);
  }
  .ocard-pic {
    width: 108px;
    height: 75px;
    border-radius: 9px;
    background-size: cover;
    background-position: 50% 50%;
    flex: none;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .ocard-txt {
    min-width: 0;
    flex: 1;
  }
  .ocard .t {
    display: block;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.018em;
    line-height: 1.25;
  }
  .ocard .s {
    margin-top: 5px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 10.5px;
    color: var(--ink-2);
  }
  .ocard .ch {
    color: var(--ink-3);
    flex: none;
  }
  .tone-blue {
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(0, 51, 102, 0.18);
  }
  .tone-grey {
    background: #8b959e;
    box-shadow: 0 0 0 3px rgba(139, 149, 158, 0.2);
  }
  .prow {
    margin-top: 4px;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .p-old {
    font-size: 11.5px;
    font-weight: 500;
    color: var(--ink-3);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
  .p-new {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.026em;
    color: var(--ink);
  }
  .p-unit {
    font-size: 10px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .panel .tail {
    margin-top: 12px;
    padding: 0 4px;
    font-size: 10px;
    line-height: 1.5;
    color: var(--ink-3);
  }
  .strip {
    display: none;
  }

  /* -------------------------------- Ablauf ------------------------------- */
  .proc {
    position: relative;
    width: 100%;
    max-width: 1240px;
    margin: 96px auto 0;
    padding-top: 64px;
    border-top: 1px solid var(--line);
  }
  .proc-head {
    max-width: 560px;
  }
  .proc-head h2 {
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .proc-head p {
    margin-top: 14px;
    font-size: 16.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .route {
    --road-h: 170px;
    position: relative;
    margin-top: 28px;
    padding-top: var(--road-h);
    --p: 0;
  }
  .road {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: var(--road-h);
    overflow: visible;
    fill: none;
  }
  .road path {
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .road-base {
    stroke: var(--surface);
    stroke-width: 14;
  }
  .road-dash {
    stroke: var(--line);
    stroke-width: 1.5;
    stroke-dasharray: 6 8;
  }
  .road-draw {
    stroke: var(--accent);
    stroke-width: 2;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--p));
    transition: stroke-dashoffset 0.25s linear;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
  }
  .step {
    position: relative;
    padding: 0 8px;
    text-align: center;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
    transition-delay: calc(var(--i) * 110ms + 120ms);
  }
  .step.in {
    opacity: 1;
    transform: none;
  }
  .stop {
    position: absolute;
    left: 50%;
    top: calc(-1 * var(--road-h) + var(--y) * var(--road-h));
    width: 50px;
    height: 50px;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--surface);
    color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--line), var(--sh-soft);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .stop .ic {
    width: 21px;
    height: 21px;
  }
  .step:hover .stop {
    transform: translate(-50%, -50%) scale(1.08);
    box-shadow: inset 0 0 0 1.5px var(--accent-hi), var(--sh-lift);
  }
  .num {
    display: block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    transition: color 0.25s var(--ease);
  }
  .step:hover .num {
    color: var(--accent);
  }
  .step h3 {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .step p {
    margin-top: 8px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  /* Ziel */
  .step:last-child .stop {
    width: 58px;
    height: 58px;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 0 0 7px var(--green-ring), 0 16px 30px -12px rgba(0, 51, 102, 0.6);
  }
  .step:last-child .stop .ic {
    width: 24px;
    height: 24px;
  }
  .step:last-child:hover .stop {
    box-shadow: 0 0 0 9px var(--green-ring), 0 20px 34px -12px rgba(0, 51, 102, 0.7);
  }
  .step:last-child h3 {
    color: var(--accent);
  }

  .proc-cta {
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .proc-cta .primary {
    margin: 0;
    width: auto;
    display: inline-flex;
    gap: 18px;
    padding: 0 10px 0 24px;
  }
  .proc-fine {
    font-size: 13px;
    color: var(--ink-3);
  }

  @media (max-width: 1100px) {
    .steps {
      gap: 12px;
    }
    .step h3 {
      font-size: 15px;
    }
  }

  /* Mobil & Tablet: vertikale Route */
  @media (max-width: 900px) {
    .proc {
      margin-top: 64px;
      padding-top: 44px;
    }
    .route {
      padding-top: 0;
      margin-top: 30px;
    }
    .road {
      display: none;
    }
    .steps {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 26px;
    }
    .steps::before,
    .steps::after {
      content: '';
      position: absolute;
      left: 23px;
      top: 26px;
      bottom: 26px;
      width: 0;
      border-left: 1.5px dashed var(--line);
    }
    .steps::after {
      border-left: 2px solid var(--accent);
      bottom: auto;
      height: calc(var(--p) * (100% - 52px));
      transition: height 0.25s linear;
    }
    .step {
      display: grid;
      grid-template-columns: 48px 1fr;
      column-gap: 18px;
      padding: 0;
      text-align: left;
      transform: translateX(-10px);
    }
    .step > :not(.stop) {
      grid-column: 2;
    }
    .stop {
      position: relative;
      z-index: 1;
      grid-row: 1 / span 3;
      left: auto;
      top: 0;
      transform: none;
      width: 48px;
      height: 48px;
    }
    .step:hover .stop {
      transform: scale(1.06);
    }
    .step:last-child .stop {
      width: 48px;
      height: 48px;
    }
    .step h3 {
      font-size: 17px;
    }
    .step p {
      font-size: 15px;
      max-width: 460px;
    }
    .proc-cta {
      align-items: stretch;
      margin-top: 36px;
    }
    .proc-cta .primary {
      width: 100%;
      justify-content: space-between;
    }
    .proc-fine {
      text-align: center;
    }
  }

  @media (max-width: 760px) {
    .proc {
      margin: 48px 20px 0;
      width: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .route {
      --p: 1;
    }
    .step {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ------------------------ Leasing & Finanzierung ----------------------- */
  .fin {
    position: relative;
    width: 100%;
    max-width: 1240px;
    margin: 96px auto 0;
    padding-top: 64px;
    border-top: 1px solid var(--line);
  }
  [data-reveal] {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
  }
  [data-reveal].in {
    opacity: 1;
    transform: none;
  }
  .fin-head {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
  }
  .fin-head h2 {
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .fin-head p {
    margin-top: 14px;
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* Gabelung: ein Auto, zwei Wege */
  .fork {
    position: relative;
    height: 150px;
    margin-top: 28px;
    transition-delay: 0.1s;
  }
  .fork-car {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 0 0 7px var(--green-ring), 0 16px 30px -12px rgba(0, 51, 102, 0.6);
    z-index: 1;
  }
  .fork-car .ic {
    width: 26px;
    height: 26px;
  }
  .fork-lines {
    position: absolute;
    left: 0;
    top: 60px;
    width: 100%;
    height: 90px;
    fill: none;
    overflow: visible;
  }
  .fork-lines path {
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-dasharray: 5 7;
    vector-effect: non-scaling-stroke;
    opacity: 0.55;
  }

  .fin-tabs {
    display: none;
  }
  .fin-tabs .seg-b[aria-selected='true'] {
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 0 0 0 1px var(--line), var(--sh-soft);
  }

  /* Eine Fläche, zwei Wege */
  .ways {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: 30px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line), var(--sh-soft);
    transition-delay: 0.2s;
  }
  .way {
    position: relative;
    padding: 40px 44px 40px;
    border-radius: 30px;
    transition: background 0.25s var(--ease);
  }
  .way:hover {
    background: var(--surface-2);
  }
  .way + .way {
    box-shadow: inset 1px 0 0 var(--line);
  }
  .oder {
    position: absolute;
    left: 50%;
    top: 40px;
    transform: translateX(-50%);
    padding: 4px 11px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    z-index: 1;
  }
  .way-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: rgba(0, 51, 102, 0.07);
    color: var(--accent);
    transition: transform 0.25s var(--ease);
  }
  .way:hover .way-icon {
    transform: translateY(-2px);
  }
  .way-icon .ic {
    width: 22px;
    height: 22px;
  }
  .way-tag {
    display: inline-block;
    margin-top: 22px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--green);
  }
  .way h3 {
    margin-top: 6px;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .way-intro {
    margin-top: 10px;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .way-pros {
    margin-top: 22px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 10px;
  }
  .way-pros li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--ink);
  }
  .way-pros .ic {
    width: 17px;
    height: 17px;
    margin-top: 2px;
    color: var(--green);
    stroke-width: 2;
  }
  .way-fit {
    margin-top: 24px;
    padding: 14px 16px;
    border-radius: 16px;
    background: rgba(0, 51, 102, 0.05);
    box-shadow: inset 0 0 0 1px rgba(0, 51, 102, 0.1);
    font-size: 14px;
    line-height: 1.5;
    font-weight: 500;
    color: var(--accent);
  }

  .fin-help {
    margin-top: 24px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 32px;
    padding: 28px 32px;
    border-radius: 24px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line-soft);
    transition-delay: 0.1s;
  }
  .fin-help h3 {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.024em;
  }
  .fin-help p {
    margin-top: 8px;
    max-width: 560px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .fin-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .fin-cta .primary {
    margin: 0;
    width: auto;
    display: inline-flex;
    gap: 18px;
    padding: 0 10px 0 24px;
    white-space: nowrap;
  }
  .fin-legal {
    margin-top: 20px;
    padding: 0 4px;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--ink-3);
    max-width: 820px;
  }

  @media (max-width: 1100px) {
    .way {
      padding: 32px 30px;
    }
  }

  /* Mobil & Tablet: Tabs, ein Weg sichtbar */
  @media (max-width: 900px) {
    .fin {
      margin-top: 64px;
      padding-top: 44px;
    }
    .fin-head {
      text-align: left;
      margin-inline: 0;
    }
    .fork {
      display: none;
    }
    .fin-tabs {
      display: grid;
      margin-top: 24px;
    }
    .ways {
      grid-template-columns: 1fr;
      margin-top: 12px;
      border-radius: 24px;
    }
    .way {
      padding: 26px 22px 24px;
      border-radius: 24px;
    }
    .way + .way {
      box-shadow: none;
    }
    .way[data-active='0'] {
      display: none;
    }
    .way[data-active='1'] {
      animation: way-in 0.35s var(--ease);
    }
    .oder {
      display: none;
    }
    .way h3 {
      font-size: 24px;
    }
    .way-pros li {
      font-size: 15px;
    }
    .fin-help {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 24px 22px;
      margin-top: 16px;
    }
    .fin-cta {
      align-items: stretch;
    }
    .fin-cta .primary {
      width: 100%;
      justify-content: space-between;
    }
    .fin-cta .proc-fine {
      text-align: center;
    }
  }
  @keyframes way-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (max-width: 760px) {
    .fin {
      margin: 48px 20px 0;
      width: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .way[data-active='1'] {
      animation: none;
    }
  }

  .foot {
    position: relative;
    flex: none;
    width: 100%;
    max-width: 1240px;
    margin: 26px auto 0;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .foot .links {
    display: flex;
    gap: 22px;
  }
  .foot a {
    color: var(--ink-3);
  }
  .foot a:hover {
    color: var(--ink-2);
  }
  .ph {
    background: var(--surface-2);
    border-radius: 6px;
    padding: 2px 8px;
    color: var(--ink-2);
  }

  /* -------------------------------- Sheets ------------------------------- */
  .ovl {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(6, 26, 48, 0.45);
    backdrop-filter: blur(5px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s var(--ease);
  }
  .ovl[data-open='1'] {
    opacity: 1;
    pointer-events: auto;
  }
  .sheet {
    width: 520px;
    max-height: 86vh;
    overflow: auto;
    border-radius: 30px;
    background: var(--sheet);
    padding-bottom: 26px;
    box-shadow: 0 0 0 1px var(--line), 0 50px 90px -34px rgba(6, 26, 48, 0.4);
    transform: translateY(12px) scale(0.98);
    opacity: 0;
    transition: transform 0.22s var(--ease), opacity 0.18s var(--ease);
  }
  .ovl[data-open='1'] .sheet {
    transform: none;
    opacity: 1;
  }
  .grab {
    display: none;
  }
  .sh-head {
    padding: 26px 26px 0;
    display: flex;
    align-items: flex-start;
    gap: 13px;
  }
  .sh-title {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.026em;
  }
  .sh-sub {
    margin-top: 3px;
    font-size: 13.5px;
    color: var(--ink-2);
  }
  .sh-x {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 44px;
