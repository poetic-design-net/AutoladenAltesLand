  .seg-b[aria-checked='true'] {
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--sh-soft);
  }
  .inp {
    margin-top: 10px;
    width: 100%;
    height: 52px;
    padding: 0 16px;
    border: 0;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 16px;
    color: var(--ink);
  }
  textarea.inp {
    height: auto;
    padding: 12px 16px;
    line-height: 1.5;
    resize: vertical;
  }
  .inp::placeholder {
    color: var(--ink-3);
  }
  .inp:focus {
    outline: none;
    background: var(--surface);
    box-shadow: inset 0 0 0 1.5px var(--accent-hi);
  }
  .inp[aria-invalid='true'] {
    box-shadow: inset 0 0 0 1.5px #c8473d;
