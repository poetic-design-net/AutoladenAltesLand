---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { ArrowRight02Icon, BubbleChatIcon, Building03Icon, Call02Icon, Cancel01Icon, Car03Icon, DashboardSquare01Icon, Home01Icon, Mail01Icon, MoreHorizontalIcon, Sent02Icon, Tick02Icon, UserGroupIcon, UserIcon, WhatsappIcon } from '@hugeicons/core-free-icons';
import { brand, vehicles, priceNote, telHref, waHref, mailHref, contact } from '../data/site';

const title = 'Autoladen Altes Land – ein Ansprechpartner für dein Fahrzeug';
const description =
  'Markenunabhängige Fahrzeugvermittlung im Alten Land. Alex sucht das Fahrzeug, ' +
  'das zu deinem Bedarf und deinem Budget passt – für Unternehmen genauso wie für Privatkunden.';
---

<Base title={title} description={description} theme="light">
  <!-- ============================ HEADER ============================ -->
  <header class="header">
    <div class="wrap">
      <a class="brand" href="#top">
        <img class="logo" src="/logo.png" alt="" width="58" height="58" />
        <span>
          <span class="brand-name">{brand.name}</span>
          <span class="brand-sub">{brand.claim}</span>
        </span>
      </a>
      <button class="status-pill" type="button" data-open-dialog>
        <img class="status-ava" src="/alex.jpg" alt="" width="24" height="24" />
        <span class="dot"></span>
        <span class="status-label">Direkt mit Alex</span>
      </button>
    </div>
  </header>

  <main id="top">
    <!-- ============================ HERO ============================ -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <span class="eyebrow">
            <Icon icon={DashboardSquare01Icon} />
            Markenunabhängig vermittelt
          </span>
          <h1>Ein Ansprechpartner.<br /><span class="accent">Fertig.</span></h1>
          <div class="hero-copy">
            <p class="lead">
              Gerade wenn Autos nicht dein Tagesgeschäft sind, musst du auch keins daraus machen.
            </p>
            <p>
              Bei mir bist du nicht an eine bestimmte Marke gebunden und musst dich auch nicht selbst durch
              unzählige Angebote kämpfen.
            </p>
            <p>Ich suche das Fahrzeug, das zu deinem Bedarf und deinem Budget passt.</p>
            <p class="strong">Für Unternehmen genauso wie für Privatkunden.</p>
          </div>
          <div class="hero-cta">
            <button class="btn-primary" type="button" data-open-dialog>
              <Icon icon={BubbleChatIcon} />
              Kurz mit Alex sprechen
            </button>
            <span class="hero-note">Kein Verkaufstheater.</span>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hv-frame">
            <img src="/hero.jpg" alt="Ladekabel an einem Elektrofahrzeug" width="1400" height="980" />
            <div class="hv-wash"></div>
          </div>
          <span class="hv-chip hv-a">
            <Icon icon={DashboardSquare01Icon} />
            markenunabhängig
          </span>
          <span class="hv-chip hv-b">
            <Icon icon={UserGroupIcon} />
            privat &amp; gewerblich
          </span>
          <div class="hv-card">
            <img src="/alex.jpg" alt="" width="46" height="46" />
            <span>
              <span class="t">Direkt mit Alex</span>
              <span class="s"><span class="dot"></span>Ein Ansprechpartner, kein Callcenter</span>
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================== FAHRZEUGE ========================== -->
    <section class="vehicles" id="fahrzeuge">
      <div class="wrap">
        <div class="sec-head">
          <h2>Was gerade möglich ist.</h2>
          <p>
            Ein kleiner Einblick in aktuelle Fahrzeuge und Kontingente. Verfügbarkeit und Konditionen ändern
            sich laufend – frag Alex einfach kurz, was gerade möglich ist.
          </p>
          <p class="sec-note">{priceNote}</p>
        </div>

        <div class="grid-v">
          {
            vehicles.map((v) => (
              <article class="tile">
                <div class="tile-media">
                  <div class="tile-img" style={`background-image:url(${v.image})`} role="img" aria-label={v.alt} />
                  <span class="chip-status">
                    <span class={`dot tone-${v.tone}`} />
                    {v.status}
                  </span>
                </div>
                <div class="tile-body">
                  <span class="tile-kicker">{v.kicker}</span>
                  <h3 class="tile-name">{v.name}</h3>
                  <ul class="tile-feats">
                    {v.features.map((f) => (
                      <li>
                        <Icon icon={Tick02Icon} />
                        {f}
                      </li>
                    ))}
                  </ul>
                  <div class="tile-price">
                    <span class="p-old">{v.price.old}</span>
                    <span class="p-new">{v.price.rate}</span>
                    <span class="p-unit">mtl. netto</span>
                    <span class="p-save">{v.price.save}</span>
                  </div>
                  <p class="p-terms">{v.price.terms}</p>
                  <button class="btn-tile" type="button" data-open-dialog data-vehicle={v.name} data-topic={v.topic}>
                    Preis &amp; Verfügbarkeit anfragen
                    <span class="arw">
                      <Icon icon={ArrowRight02Icon} size={17} />
                    </span>
                  </button>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================ ALEX ============================ -->
    <section class="alex" id="ueber-alex">
      <div class="wrap">
        <div class="alex-panel">
          <div class="alex-photo">
            <img src="/alex-tall.jpg" alt={`${brand.person} vom ${brand.name}`} width="480" height="720" />
            <div class="tint"></div>
          </div>
          <div class="alex-body">
            <span class="alex-eyebrow"><span class="dot"></span>Dein Ansprechpartner</span>
            <h2>Moin, ich bin Alex.</h2>
            <div class="copy">
              <p class="first">Persönlich, direkt und ohne großes Verkaufstheater.</p>
              <p>
                Mir ist lieber, wir sprechen zehn Minuten vernünftig darüber, was du wirklich brauchst, als dass
                ich dir drei Hochglanzangebote schicke, die am Ende nicht passen.
              </p>
              <p>Wenn ich weiß, wonach du suchst, kann ich dir meistens ziemlich schnell sagen, was machbar ist.</p>
            </div>
            <p class="alex-kicker">Also: Was soll’s werden?</p>
            <div class="alex-cta">
              <button class="btn-light" type="button" data-open-dialog>
                <Icon icon={BubbleChatIcon} />
                Kurz mit Alex sprechen
              </button>
              <span class="alex-sig">Zehn Minuten reichen meistens.</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ============================ FOOTER ============================ -->
  <footer class="footer">
    <div class="wrap">
      <div class="foot-brand">
        <img class="logo" src="/logo.png" alt="" width="58" height="58" />
        <span>
          <span class="brand-name">{brand.name}</span>
          <span class="brand-sub">Fahrzeugvermittlung · {brand.region}</span>
        </span>
      </div>
      <nav class="foot-links" aria-label="Rechtliches">
        <a href="#fahrzeuge">Fahrzeuge</a>
        <a href="#ueber-alex">Über Alex</a>
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </nav>
      <div class="foot-contact">
        <span>
          Telefon {telHref ? <a href={telHref}>{contact.phone}</a> : <span class="ph">[Nummer eintragen]</span>}
        </span>
        <span>
          E-Mail {mailHref ? <a href={mailHref}>{contact.email}</a> : <span class="ph">[Adresse eintragen]</span>}
        </span>
      </div>
    </div>
    <div class="spacer"></div>
  </footer>

  <!-- ========================= BOTTOM-COCKPIT ======================== -->
  <div class="cockpit">
    <div class="cockpit-shell">
      <div class="cp-panel" id="cp-panel" data-open="0">
        {
          telHref ? (
            <a class="cp-item" href={telHref}>
              <Icon icon={Call02Icon} />
              Anrufen
            </a>
          ) : (
            <span class="cp-item">
              <Icon icon={Call02Icon} />
              Anrufen
            </span>
          )
        }
        {
          waHref ? (
            <a class="cp-item" href={waHref} target="_blank" rel="noopener">
              <Icon icon={WhatsappIcon} />
              WhatsApp
            </a>
          ) : (
            <span class="cp-item">
              <Icon icon={WhatsappIcon} />
              WhatsApp
            </span>
          )
        }
        {
          mailHref ? (
            <a class="cp-item" href={mailHref}>
              <Icon icon={Mail01Icon} />
              E-Mail
            </a>
          ) : (
            <span class="cp-item">
              <Icon icon={Mail01Icon} />
              E-Mail
            </span>
          )
        }
        <button class="cp-item" type="button" data-open-dialog>
          <Icon icon={Sent02Icon} />
          Anfrage senden
        </button>
      </div>
      <div class="cp-fillet" data-open="0"></div>
      <nav class="cp-bar" aria-label="Schnellzugriff">
        <a class="cp-btn" href="#top" data-section="top">
          <Icon icon={Home01Icon} />
          <span class="cp-label">Start</span>
        </a>
        <a class="cp-btn" href="#fahrzeuge" data-section="fahrzeuge">
          <Icon icon={Car03Icon} />
          <span class="cp-label">Fahrzeuge</span>
        </a>
        <span class="cp-sep"></span>
        <button class="cp-main" type="button" data-open-dialog>
          <Icon icon={BubbleChatIcon} />
          Alex fragen
        </button>
        <span class="cp-sep"></span>
        <a class="cp-btn" href="#ueber-alex" data-section="ueber-alex">
          <Icon icon={UserIcon} />
          <span class="cp-label">Über Alex</span>
        </a>
        <button
          class="cp-more"
          type="button"
          aria-label="Weitere Kontaktmöglichkeiten"
          aria-expanded="false"
          aria-controls="cp-panel"
          id="cp-more"
        >
          <Icon icon={MoreHorizontalIcon} />
        </button>
      </nav>
    </div>
  </div>

  <!-- ========================= KONTAKT-DIALOG ======================== -->
  <div class="ovl" id="ovl" data-open="0">
    <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="dlg-title" id="dlg">
      <div class="grab"></div>
      <div class="sheet-head">
        <img src="/alex.jpg" alt="" width="46" height="46" />
        <div>
          <div class="sheet-title" id="dlg-title">Kurz mit Alex sprechen</div>
          <div class="sheet-sub">Sag mir grob, worum es geht – den Rest klären wir persönlich.</div>
        </div>
        <button class="x-btn" type="button" aria-label="Dialog schließen" data-close-dialog>
          <Icon icon={Cancel01Icon} />
        </button>
      </div>

      <div class="ctx" id="ctx" hidden>
        <Icon icon={Car03Icon} />
        <span>Anfrage zu: <span id="ctx-name"></span></span>
        <button class="ctx-x" type="button" aria-label="Fahrzeugbezug entfernen" id="ctx-clear">
          <Icon icon={Cancel01Icon} size={15} />
        </button>
      </div>

      <form class="form" id="form" novalidate>
        <div class="row2">
          <div class="fld">
            <label class="lbl" for="f-name">Name</label>
            <input class="inp" id="f-name" name="name" type="text" autocomplete="name" placeholder="Wie heißt du?" />
          </div>
          <div class="fld">
            <span class="lbl" id="lbl-kind">Ich frage als</span>
            <div class="seg" role="radiogroup" aria-labelledby="lbl-kind" data-seg="kind">
              <button class="seg-b" type="button" role="radio" aria-checked="true" data-val="privat">
                <Icon icon={UserIcon} />
                Privat
              </button>
              <button class="seg-b" type="button" role="radio" aria-checked="false" data-val="firma">
                <Icon icon={Building03Icon} />
                Unternehmen
              </button>
            </div>
          </div>
        </div>

        <div class="fld">
          <label class="lbl" for="f-need">Was suchst du?</label>
          <input
            class="inp"
            id="f-need"
            name="need"
            type="text"
            placeholder="z. B. E-Transporter für die Werkstatt"
          />
        </div>

        <div class="row2">
          <div class="fld">
            <label class="lbl" for="f-budget">Budget oder Leasingrate <span class="opt">– optional</span></label>
            <input class="inp" id="f-budget" name="budget" type="text" placeholder="z. B. bis 450 € / Monat" />
          </div>
          <div class="fld">
            <label class="lbl" for="f-when">Ab wann?</label>
            <input class="inp" id="f-when" name="timing" type="text" placeholder="z. B. im nächsten Quartal" />
          </div>
        </div>

        <div class="fld">
          <span class="lbl" id="lbl-ch">So erreichst du mich am liebsten</span>
          <div class="seg" role="radiogroup" aria-labelledby="lbl-ch" data-seg="channel">
            <button class="seg-b" type="button" role="radio" aria-checked="true" data-val="tel">
              <Icon icon={Call02Icon} />
              Anruf
            </button>
            <button class="seg-b" type="button" role="radio" aria-checked="false" data-val="wa">
              <Icon icon={WhatsappIcon} />
              WhatsApp
            </button>
            <button class="seg-b" type="button" role="radio" aria-checked="false" data-val="mail">
              <Icon icon={Mail01Icon} />
              E-Mail
            </button>
          </div>
        </div>

        <div class="fld">
          <label class="lbl" for="f-reach" id="reach-label">Deine Telefonnummer</label>
          <input class="inp" id="f-reach" name="reach" type="text" required placeholder="01xx xxxxxxx" />
          <p class="err" id="err-reach" hidden>Ohne Nummer oder Adresse kann ich mich nicht melden.</p>
        </div>

        <div class="fld">
          <label class="lbl" for="f-msg">Noch etwas, das ich wissen sollte? <span class="opt">– optional</span></label>
          <textarea class="inp" id="f-msg" name="message" rows="3" placeholder="Schreib einfach frei heraus."></textarea>
        </div>

        <button class="btn-send" type="submit" id="submit">
          <Icon icon={Sent02Icon} />
          <span id="submit-label">Anfrage an Alex senden</span>
        </button>
        <p class="fine">Deine Angaben gehen direkt an Alex – nicht an ein Portal.</p>
        <p class="err center" id="err-send" hidden></p>
      </form>

      <div class="done" id="done" hidden>
        <span class="done-ring"
          ><Icon icon={Tick02Icon} /></span
        >
        <h3>Alles klar – ist bei mir.</h3>
        <p>Ich schaue, ob ich so etwas finde, und melde mich persönlich bei dir.</p>
        <button class="btn-send" type="button" style="max-width:260px" data-close-dialog>Schließen</button>
      </div>
    </div>
  </div>
</Base>

<style>
  /* ------------------------------ Grundriss ------------------------------ */
  .wrap {
    position: relative;
    width: min(1200px, 100% - 48px);
    margin: 0 auto;
  }

  main {
    position: relative;
  }
  main::before {
    content: '';
    position: absolute;
    top: -340px;
    right: -240px;
    width: 1000px;
    height: 1000px;
    background: radial-gradient(circle, rgba(0, 51, 102, 0.1), rgba(0, 51, 102, 0) 62%);
    pointer-events: none;
  }
  main::after {
    content: '';
    position: absolute;
    top: 1500px;
    left: -320px;
    width: 900px;
    height: 900px;
    background: radial-gradient(circle, rgba(0, 153, 102, 0.075), rgba(0, 153, 102, 0) 62%);
    pointer-events: none;
  }

  /* -------------------------------- Header ------------------------------- */
  .header {
    position: sticky;
    top: 0;
    z-index: 30;
    height: 88px;
    background: rgba(245, 244, 241, 0.72);
    backdrop-filter: blur(18px) saturate(1.4);
    border-bottom: 1px solid var(--line-soft);
  }
  .header .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 88px;
  }
  .brand,
  .foot-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: inherit;
  }
  .logo {
    width: 72px;
    height: 72px;
    flex: none;
    object-fit: contain;
  }
  .brand-name {
    display: block;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.15;
  }
  .brand-sub {
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 44px;
    padding: 0 16px 0 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 0 0 1px var(--line);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink-2);
    transition: box-shadow 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .status-pill:hover {
    transform: translateY(-1px);
    box-shadow: 0 0 0 1px rgba(0, 51, 102, 0.22), var(--sh-soft);
  }
  .status-ava {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    object-fit: cover;
    object-position: 50% 18%;
    filter: grayscale(1);
    flex: none;
  }

  /* --------------------------------- Hero -------------------------------- */
  .hero {
    padding: 64px 0 104px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 620px 1fr;
    gap: 80px;
    align-items: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 14px 0 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.8);
    box-shadow: 0 0 0 1px var(--line);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent);
  }
  .eyebrow .ic {
    width: 15px;
    height: 15px;
    stroke-width: 1.8;
  }
  h1 {
    margin-top: 26px;
    font-size: clamp(32px, 4.2vw, 58px);
    line-height: 0.98;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  h1 .accent {
    color: var(--accent);
  }
  .hero-copy {
    margin-top: 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 492px;
  }
  .hero-copy p {
    font-size: 17px;
    line-height: 1.62;
    color: var(--ink-2);
  }
  .hero-copy .lead {
    font-size: 19.5px;
    line-height: 1.55;
    color: var(--ink);
    letter-spacing: -0.008em;
  }
  .hero-copy .strong {
    color: var(--ink);
    font-weight: 500;
  }
  .hero-cta {
    margin-top: 34px;
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .hero-note {
    font-size: 13.5px;
    color: var(--ink-3);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 54px;
    padding: 0 26px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.008em;
    box-shadow: 0 1px 2px rgba(0, 32, 64, 0.28), 0 14px 28px -12px rgba(0, 51, 102, 0.6);
    transition: transform 0.18s var(--ease), box-shadow 0.18s var(--ease), background 0.18s var(--ease);
  }
  .btn-primary:hover {
    background: var(--accent-deep);
    transform: translateY(-2px);
  }
  .btn-primary:active {
    transform: translateY(0);
  }

  .hero-visual {
    position: relative;
    height: 460px;
  }
  .hv-frame {
    position: absolute;
    inset: 0;
    border-radius: 44px;
    overflow: hidden;
    background: #dfe3e7;
    box-shadow: 0 2px 6px rgba(6, 26, 48, 0.07), 0 40px 70px -30px rgba(6, 26, 48, 0.42);
  }
  .hv-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hv-wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(0, 51, 102, 0.28), rgba(0, 51, 102, 0) 46%, rgba(10, 18, 26, 0.34));
  }
  .hv-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(16px) saturate(1.5);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.7), 0 10px 24px -10px rgba(6, 26, 48, 0.5);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }
  .hv-chip .ic {
    color: var(--accent);
  }
  .hv-a {
    top: 34px;
    left: 30px;
  }
  .hv-b {
    top: 92px;
    left: 68px;
  }
  .hv-card {
    position: absolute;
    left: -26px;
    bottom: -26px;
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 13px 22px 13px 13px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(20px) saturate(1.4);
    box-shadow: 0 0 0 1px var(--line-soft), 0 22px 44px -18px rgba(6, 26, 48, 0.45);
  }
  .hv-card img {
    width: 46px;
    height: 46px;
    border-radius: 16px;
    object-fit: cover;
    object-position: 50% 14%;
    filter: grayscale(1);
  }
  .hv-card .t {
    display: block;
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .hv-card .s {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12.5px;
    color: var(--ink-3);
    margin-top: 2px;
  }

  /* ------------------------------ Fahrzeuge ------------------------------ */
  .vehicles {
    padding: 8px 0 112px;
  }
  .sec-head {
    max-width: 660px;
  }
  h2 {
    font-size: clamp(34px, 4vw, 50px);
    line-height: 1.03;
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .sec-head p {
    margin-top: 18px;
    font-size: 17.5px;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 600px;
  }
  .sec-note {
    margin-top: 12px !important;
    font-size: 13px !important;
    color: var(--ink-3) !important;
  }

  .grid-v {
    margin-top: 52px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px;
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 36px;
    background: var(--surface);
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--line-soft), var(--sh-soft);
    transition: transform 0.28s var(--ease), box-shadow 0.28s var(--ease);
  }
  .tile:hover {
    transform: translateY(-6px);
    box-shadow: 0 0 0 1px rgba(0, 51, 102, 0.12), var(--sh-lift);
  }
  .tile-media {
    position: relative;
    height: 246px;
  }
  .tile-img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: 50% 52%;
    -webkit-mask-image: linear-gradient(to bottom, #000 62%, rgba(0, 0, 0, 0.35) 84%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 62%, rgba(0, 0, 0, 0.35) 84%, transparent 100%);
    transition: transform 0.7s var(--ease);
  }
  .tile:hover .tile-img {
    transform: scale(1.055);
  }
  .chip-status {
    position: absolute;
    top: 18px;
    left: 18px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 31px;
    padding: 0 13px 0 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px) saturate(1.5);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.6), 0 6px 16px -6px rgba(6, 26, 48, 0.4);
    font-size: 12px;
    font-weight: 600;
  }
  .tone-blue {
    background: #3366cc;
    box-shadow: 0 0 0 3px rgba(51, 102, 204, 0.16);
  }
  .tone-grey {
    background: #838d97;
    box-shadow: 0 0 0 3px rgba(131, 141, 151, 0.18);
  }

  .tile-body {
    position: relative;
    padding: 4px 26px 26px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .tile-kicker {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .tile-name {
    margin-top: 7px;
    font-size: 25px;
    font-weight: 600;
    letter-spacing: -0.028em;
    line-height: 1.12;
  }
  .tile-feats {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .tile-feats li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 14.5px;
    color: var(--ink-2);
  }
  .tile-feats .ic {
    width: 16px;
    height: 16px;
    stroke-width: 1.9;
    color: var(--green);
  }

  .tile-price {
    margin-top: 16px;
    display: flex;
    align-items: baseline;
    gap: 9px;
    flex-wrap: wrap;
  }
  .p-old {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-3);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
  .p-new {
    font-size: 25px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .p-unit {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .p-save {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    background: rgba(0, 153, 102, 0.1);
    box-shadow: inset 0 0 0 1px rgba(0, 153, 102, 0.24);
    font-size: 11.5px;
    font-weight: 600;
    color: #008056;
  }
  .p-terms {
    margin-top: 6px;
    margin-bottom: 20px;
    font-size: 11.5px;
    line-height: 1.45;
    color: var(--ink-3);
  }

  .btn-tile {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    height: 52px;
    padding: 0 12px 0 20px;
    border-radius: 999px;
    background: var(--surface-2);
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.008em;
    box-shadow: inset 0 0 0 1px var(--line-soft);
    transition: background 0.2s var(--ease), color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .btn-tile .arw {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 4px 10px -5px rgba(0, 51, 102, 0.9);
    transition: background 0.2s var(--ease), transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .tile:hover .btn-tile,
  .btn-tile:hover {
    background: var(--accent);
    color: #fff;
    box-shadow: inset 0 0 0 1px transparent;
  }
  .tile:hover .btn-tile .arw,
  .btn-tile:hover .arw {
    background: rgba(255, 255, 255, 0.18);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.26);
    transform: translateX(2px);
  }

  /* --------------------------------- Alex -------------------------------- */
  .alex {
    padding: 0 0 116px;
  }
  .alex-panel {
    position: relative;
    display: grid;
    grid-template-columns: 468px 1fr;
    border-radius: 48px;
    overflow: hidden;
    background: linear-gradient(152deg, #073059 0%, #04203c 100%);
    box-shadow: 0 3px 8px rgba(6, 26, 48, 0.1), 0 50px 90px -40px rgba(4, 32, 60, 0.66);
    min-height: 528px;
  }
  .alex-photo {
    position: relative;
    min-height: 340px;
  }
  .alex-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 8%;
    filter: grayscale(1) contrast(1.06);
  }
  .alex-photo .tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(4, 32, 60, 0.06), rgba(4, 32, 60, 0.55));
  }
  .alex-body {
    position: relative;
    padding: 60px 64px 58px 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: #fff;
  }
  .alex-body::before {
    content: '';
    position: absolute;
    top: -120px;
    right: -120px;
    width: 460px;
    height: 460px;
    background: radial-gradient(circle, rgba(51, 102, 204, 0.34), rgba(51, 102, 204, 0) 66%);
  }
  .alex-eyebrow {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    align-self: flex-start;
    height: 32px;
    padding: 0 14px 0 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.11);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
    font-size: 12.5px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
  }
  .alex-body h2 {
    position: relative;
    margin-top: 22px;
    color: #fff;
  }
  .alex-body .copy {
    position: relative;
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 520px;
  }
  .alex-body .copy p {
    font-size: 17px;
    line-height: 1.62;
    color: rgba(255, 255, 255, 0.78);
  }
  .alex-body .copy .first {
    font-size: 19px;
    color: rgba(255, 255, 255, 0.94);
    letter-spacing: -0.008em;
  }
  .alex-kicker {
    position: relative;
    margin-top: 26px;
    font-size: 23px;
    font-weight: 600;
    letter-spacing: -0.026em;
    color: #fff;
  }
  .alex-cta {
    position: relative;
    margin-top: 28px;
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .btn-light {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 54px;
    padding: 0 26px;
    border-radius: 999px;
    background: #fff;
    color: var(--accent);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.008em;
    box-shadow: 0 14px 30px -14px rgba(0, 0, 0, 0.7);
    transition: transform 0.18s var(--ease);
  }
  .btn-light:hover {
    transform: translateY(-2px);
  }
  .alex-sig {
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.55);
  }

  /* -------------------------------- Footer ------------------------------- */
  .footer {
    position: relative;
    padding-bottom: 40px;
  }
  .footer .wrap {
    border-top: 1px solid var(--line);
    padding-top: 36px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }
  .foot-links {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 13.5px;
    flex-wrap: wrap;
  }
  .foot-links a {
    color: var(--ink-3);
  }
  .foot-links a:hover {
    color: var(--ink);
  }
  .foot-contact {
    display: flex;
    flex-direction: column;
    gap: 7px;
    text-align: right;
    font-size: 13.5px;
    color: var(--ink-2);
  }
  .ph {
    color: var(--ink-3);
    background: rgba(16, 24, 32, 0.05);
    border-radius: 6px;
    padding: 1px 7px;
    font-size: 12.5px;
  }
  .spacer {
    height: 176px;
  }

  /* ---------------------------- Bottom-Cockpit --------------------------- */
  .cockpit {
    position: fixed;
    left: 0;
    right: 0;
    bottom: calc(30px + env(safe-area-inset-bottom, 0px));
    z-index: 60;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .cockpit-shell {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: calc(100vw - 24px);
    filter: drop-shadow(0 2px 4px rgba(6, 26, 48, 0.1)) drop-shadow(0 16px 34px rgba(6, 26, 48, 0.2));
  }
  .cp-panel {
    position: relative;
    width: 272px;
    background: #fff;
    border-radius: 24px 24px 0 0;
    padding: 0 10px;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transform: translateY(8px) scale(0.97);
    transform-origin: 50% 100%;
    transition: max-height 0.2s var(--ease), opacity 0.16s var(--ease), transform 0.2s var(--ease),
      padding 0.2s var(--ease);
  }
  .cp-panel[data-open='1'] {
    max-height: 260px;
    opacity: 1;
    padding: 10px 10px 6px;
    transform: translateY(0) scale(1);
  }
  .cp-fillet {
    position: relative;
    width: 272px;
    height: 0;
    background: #fff;
    transition: height 0.2s var(--ease);
  }
  .cp-fillet[data-open='1'] {
    height: 18px;
  }
  .cp-fillet::before,
  .cp-fillet::after {
    content: '';
    position: absolute;
    top: 0;
    width: 18px;
    height: 100%;
  }
  .cp-fillet::before {
    left: -18px;
    background: radial-gradient(circle 18px at top left, rgba(0, 0, 0, 0) 17.6px, #fff 18px);
  }
  .cp-fillet::after {
    right: -18px;
    background: radial-gradient(circle 18px at top right, rgba(0, 0, 0, 0) 17.6px, #fff 18px);
  }
  .cp-item {
    display: flex;
    align-items: center;
    gap: 11px;
    width: 100%;
    min-height: 46px;
    padding: 0 13px;
    border-radius: 14px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--ink-2);
    transition: background 0.16s var(--ease), color 0.16s var(--ease);
  }
  .cp-item:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .cp-item .ic {
    color: var(--accent);
  }
  .cp-bar {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 62px;
    padding: 7px 8px;
    background: #fff;
    border-radius: 31px;
  }
  .cp-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    padding: 0 15px;
    border-radius: 24px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink-3);
    white-space: nowrap;
    transition: background 0.16s var(--ease), color 0.16s var(--ease);
  }
  .cp-btn .ic {
    width: 19px;
    height: 19px;
  }
  .cp-btn:hover {
    background: #f3f3f0;
    color: var(--ink);
  }
  .cp-btn[data-active='1'] {
    color: var(--ink);
    font-weight: 600;
    background: #f0f1ee;
  }
  .cp-main {
    display: flex;
    align-items: center;
    gap: 9px;
    height: 48px;
    padding: 0 22px;
    border-radius: 24px;
    background: var(--accent);
    color: #fff;
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.008em;
    white-space: nowrap;
    box-shadow: 0 8px 18px -8px rgba(0, 51, 102, 0.85);
    transition: background 0.16s var(--ease), transform 0.16s var(--ease);
  }
  .cp-main:hover {
    background: var(--accent-deep);
    transform: translateY(-1px);
  }
  .cp-sep {
    width: 1px;
    height: 24px;
    background: var(--line);
    margin: 0 4px;
  }
  .cp-more {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 24px;
    color: var(--ink-3);
    transition: background 0.16s var(--ease), color 0.16s var(--ease);
  }
  .cp-more:hover,
  .cp-more[aria-expanded='true'] {
    background: #f0f1ee;
    color: var(--ink);
  }

  /* --------------------------------- Dialog ------------------------------ */
  .ovl {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 20, 32, 0.42);
    backdrop-filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s var(--ease);
  }
  .ovl[data-open='1'] {
    opacity: 1;
    pointer-events: auto;
  }
  .sheet {
    width: 552px;
    max-height: 88vh;
    overflow: auto;
    border-radius: 36px;
    background: var(--surface);
    box-shadow: 0 40px 90px -30px rgba(4, 20, 40, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.6);
    transform: translateY(14px) scale(0.975);
    opacity: 0;
    transition: transform 0.22s var(--ease), opacity 0.18s var(--ease);
  }
  .ovl[data-open='1'] .sheet {
    transform: none;
    opacity: 1;
  }
  .grab {
    display: none;
  }
  .sheet-head {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 26px 26px 0;
  }
  .sheet-head img {
    width: 46px;
    height: 46px;
    border-radius: 16px;
    object-fit: cover;
    object-position: 50% 14%;
    filter: grayscale(1);
    flex: none;
  }
  .sheet-title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.024em;
  }
  .sheet-sub {
    margin-top: 3px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .x-btn {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    color: var(--ink-3);
    flex: none;
    transition: background 0.16s var(--ease), color 0.16s var(--ease);
  }
  .x-btn:hover {
    background: #f1f1ee;
    color: var(--ink);
  }
  .ctx {
    margin: 18px 26px 0;
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 12px 14px;
    border-radius: 16px;
    background: rgba(0, 51, 102, 0.055);
    box-shadow: inset 0 0 0 1px rgba(0, 51, 102, 0.1);
    font-size: 14px;
    color: var(--accent);
    font-weight: 500;
  }
  .ctx-x {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    color: var(--accent);
    opacity: 0.6;
  }
  .ctx-x:hover {
    opacity: 1;
    background: rgba(0, 51, 102, 0.09);
  }
  .form {
    padding: 20px 26px 26px;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .row2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 13px;
  }
  .fld {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .lbl {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .lbl .opt {
    font-weight: 400;
    color: var(--ink-3);
  }
  .inp {
    width: 100%;
    height: 46px;
    padding: 0 14px;
    border: 0;
    border-radius: 14px;
    background: #f7f7f4;
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 14.5px;
    color: var(--ink);
    transition: box-shadow 0.16s var(--ease), background 0.16s var(--ease);
  }
  textarea.inp {
    height: auto;
    padding: 12px 14px;
    resize: vertical;
    line-height: 1.5;
  }
  .inp::placeholder {
    color: #a9b1b9;
  }
  .inp:focus {
    outline: none;
    background: #fff;
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }
  .inp[aria-invalid='true'] {
    box-shadow: inset 0 0 0 1.5px #b4453a;
  }
  .err {
    font-size: 12.5px;
    color: #b4453a;
  }
  .err.center {
    text-align: center;
  }
  .seg {
    display: grid;
    grid-auto-flow: column;
    gap: 4px;
    padding: 4px;
    border-radius: 14px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line-soft);
  }
  .seg-b {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    height: 38px;
    border-radius: 10px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink-2);
    transition: background 0.16s var(--ease), color 0.16s var(--ease), box-shadow 0.16s var(--ease);
  }
  .seg-b .ic {
    width: 16px;
    height: 16px;
  }
  .seg-b:hover {
    color: var(--ink);
  }
  .seg-b[aria-checked='true'] {
    background: #fff;
    color: var(--accent);
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(6, 26, 48, 0.1), 0 0 0 1px var(--line-soft);
  }
  .btn-send {
    margin-top: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    height: 52px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: -0.008em;
    box-shadow: 0 12px 26px -12px rgba(0, 51, 102, 0.8);
    transition: background 0.18s var(--ease), transform 0.18s var(--ease), opacity 0.18s var(--ease);
  }
  .btn-send:hover {
    background: var(--accent-deep);
    transform: translateY(-1px);
  }
  .btn-send[disabled] {
    opacity: 0.6;
    pointer-events: none;
  }
  .fine {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--ink-3);
    text-align: center;
  }
  .done {
    padding: 34px 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }
  .done-ring {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 999px;
    background: rgba(0, 153, 102, 0.1);
    color: var(--green);
  }
  .done-ring .ic {
    width: 28px;
    height: 28px;
    stroke-width: 1.8;
  }
  .done h3 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.026em;
  }
  .done p {
    font-size: 15px;
    color: var(--ink-2);
    max-width: 330px;
    line-height: 1.6;
  }

  /* ------------------------------ Responsive ----------------------------- */
  @media (max-width: 1180px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
      gap: 48px;
    }
    .hero-visual {
      height: 420px;
    }
    .alex-panel {
      grid-template-columns: 40% 1fr;
    }
    .alex-body {
      padding: 48px 44px;
    }
  }

  @media (max-width: 900px) {
    .wrap {
      width: min(1200px, 100% - 40px);
    }
    .hero {
      padding: 40px 0 72px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .hero-visual {
      height: 320px;
    }
    .hv-card {
      left: 0;
      right: 0;
      bottom: -22px;
    }
    .grid-v {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
    .alex-panel {
      grid-template-columns: 1fr;
      border-radius: 36px;
    }
    .alex-photo {
      height: 300px;
    }
    .alex-photo img {
      object-position: 50% 12%;
    }
    .alex-photo .tint {
      background: linear-gradient(to bottom, rgba(4, 32, 60, 0.05) 45%, rgba(4, 32, 60, 0.86));
    }
    .alex-body {
      padding: 30px 26px 34px;
    }
    .footer .wrap {
      flex-direction: column;
      gap: 20px;
    }
    .foot-contact {
      text-align: left;
    }
  }

  @media (max-width: 640px) {
    .wrap {
      width: min(1200px, 100% - 32px);
    }
    .header,
    .header .wrap {
      height: 74px;
    }
    .status-label {
      display: none;
    }
    .status-pill {
      padding: 0 12px;
    }
    .header .brand-sub {
      display: none;
    }
    .logo {
      width: 58px;
      height: 58px;
    }
    .hero-copy .lead {
      font-size: 18px;
    }
    .hero-copy p {
      font-size: 16px;
    }
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-primary {
      justify-content: center;
    }
    .hero-note {
      text-align: center;
    }
    .grid-v {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .tile-media {
      height: 200px;
    }
    .tile-body {
      padding: 4px 20px 20px;
    }
    .tile-name {
      font-size: 22px;
    }
    .sec-head p {
      font-size: 16px;
    }
    .alex-kicker {
      font-size: 20px;
    }
    .alex-cta {
      align-items: stretch;
      flex-direction: column;
    }
    .btn-light {
      justify-content: center;
    }
    .spacer {
      height: 150px;
    }

    /* Cockpit mobil: Icon über Label, kompakter */
    .cp-bar {
      height: 66px;
      padding: 6px;
      gap: 2px;
    }
    .cp-btn {
      flex-direction: column;
      gap: 3px;
      min-width: 54px;
      height: 54px;
      padding: 0 6px;
      border-radius: 27px;
      font-size: 9.5px;
      font-weight: 600;
    }
    .cp-btn .ic {
      width: 20px;
      height: 20px;
    }
    .cp-main {
      height: 54px;
      padding: 0 16px;
      border-radius: 27px;
      font-size: 13.5px;
    }
    .cp-sep {
      display: none;
    }
    .cp-more {
      width: 46px;
      height: 54px;
      border-radius: 27px;
    }
    .cp-panel,
    .cp-fillet {
      width: 240px;
    }

    /* Dialog mobil als Bottom Sheet */
    .ovl {
      align-items: flex-end;
    }
    .sheet {
      width: 100%;
      max-height: 92vh;
      border-radius: 30px 30px 0 0;
      transform: translateY(26px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    .grab {
      display: block;
      width: 40px;
      height: 4px;
      border-radius: 999px;
      background: rgba(16, 24, 32, 0.14);
      margin: 10px auto 0;
    }
    .sheet-head {
      padding: 14px 20px 0;
    }
    .ctx,
    .form {
      margin-left: 0;
      margin-right: 0;
    }
    .ctx {
      margin: 16px 20px 0;
    }
    .form {
      padding: 18px 20px 22px;
    }
    .row2 {
      grid-template-columns: 1fr;
    }
    .inp {
      height: 48px;
      font-size: 16px; /* verhindert iOS-Zoom */
    }
  }
</style>

<script>
  const ovl = document.getElementById('ovl')!;
  const dlg = document.getElementById('dlg')!;
  const form = document.getElementById('form') as HTMLFormElement;
  const done = document.getElementById('done')!;
  const ctx = document.getElementById('ctx')!;
  const ctxName = document.getElementById('ctx-name')!;
  const reachInput = document.getElementById('f-reach') as HTMLInputElement;
  const reachLabel = document.getElementById('reach-label')!;
  const errReach = document.getElementById('err-reach')!;
  const errSend = document.getElementById('err-send')!;
  const submit = document.getElementById('submit') as HTMLButtonElement;
  const submitLabel = document.getElementById('submit-label')!;
  const panel = document.getElementById('cp-panel')!;
  const fillet = document.querySelector('.cp-fillet') as HTMLElement;
  const moreBtn = document.getElementById('cp-more')!;

  let lastFocused: HTMLElement | null = null;
  let vehicle = '';
  let topic = '';

  /* ------------------------------- Cockpit ------------------------------- */
  function setMore(open: boolean) {
    panel.dataset.open = open ? '1' : '0';
    fillet.dataset.open = open ? '1' : '0';
    moreBtn.setAttribute('aria-expanded', String(open));
  }
  moreBtn.addEventListener('click', () => setMore(moreBtn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (moreBtn.getAttribute('aria-expanded') === 'true' && !panel.contains(t) && !moreBtn.contains(t)) setMore(false);
  });

  /* Aktiven Abschnitt im Cockpit markieren */
  const sections = ['top', 'fahrzeuge', 'ueber-alex']
    .map((id) => document.getElementById(id))
    .filter(Boolean) as HTMLElement[];
  const navBtns = Array.from(document.querySelectorAll<HTMLElement>('.cp-btn'));
  if ('IntersectionObserver' in window && sections.length) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          navBtns.forEach((b) => (b.dataset.active = b.dataset.section === en.target.id ? '1' : '0'));
        });
      },
      { rootMargin: '-45% 0px -45% 0px' }
    );
    sections.forEach((s) => io.observe(s));
  }

  /* -------------------------------- Dialog ------------------------------- */
  function focusables() {
    return Array.from(
      dlg.querySelectorAll<HTMLElement>('button, input, textarea, select, a[href]')
    ).filter((el) => el.offsetParent !== null);
  }

  function openDialog(name?: string, tpc?: string) {
    lastFocused = document.activeElement as HTMLElement;
    vehicle = name || '';
    topic = tpc || '';
    ctx.hidden = !vehicle;
    ctxName.textContent = vehicle;
    const need = document.getElementById('f-need') as HTMLInputElement;
    if (vehicle && !need.value) need.value = vehicle;
    form.hidden = false;
    done.hidden = true;
    errSend.hidden = true;
    ovl.dataset.open = '1';
    document.body.style.overflow = 'hidden';
    setMore(false);
    setTimeout(() => (document.getElementById('f-name') as HTMLElement)?.focus(), 60);
  }

  function closeDialog() {
    ovl.dataset.open = '0';
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  document.querySelectorAll<HTMLElement>('[data-open-dialog]').forEach((el) =>
    el.addEventListener('click', () => openDialog(el.dataset.vehicle, el.dataset.topic))
  );
  document.querySelectorAll<HTMLElement>('[data-close-dialog]').forEach((el) =>
    el.addEventListener('click', closeDialog)
  );
  ovl.addEventListener('click', (e) => {
    if (e.target === ovl) closeDialog();
  });
  document.getElementById('ctx-clear')!.addEventListener('click', () => {
    vehicle = '';
    ctx.hidden = true;
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (ovl.dataset.open === '1') {
        e.preventDefault();
        closeDialog();
      } else if (moreBtn.getAttribute('aria-expanded') === 'true') {
        e.preventDefault();
        setMore(false);
      }
      return;
    }
    if (e.key === 'Tab' && ovl.dataset.open === '1') {
      const f = focusables();
      if (!f.length) return;
      const first = f[0];
      const last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  /* -------------------------- Segmentierte Auswahl ------------------------ */
  const seg: Record<string, string> = { kind: 'privat', channel: 'tel' };
  document.querySelectorAll<HTMLElement>('.seg').forEach((group) => {
    const key = group.dataset.seg!;
    group.querySelectorAll<HTMLElement>('.seg-b').forEach((btn) => {
      btn.addEventListener('click', () => {
        seg[key] = btn.dataset.val!;
        group
          .querySelectorAll<HTMLElement>('.seg-b')
          .forEach((b) => b.setAttribute('aria-checked', String(b === btn)));
        if (key === 'channel') {
          const mail = seg.channel === 'mail';
          reachLabel.textContent = mail ? 'Deine E-Mail-Adresse' : 'Deine Telefonnummer';
          reachInput.placeholder = mail ? 'name@firma.de' : '01xx xxxxxxx';
          reachInput.type = mail ? 'email' : 'tel';
          reachInput.autocomplete = mail ? 'email' : 'tel';
        }
      });
    });
  });

  /* -------------------------------- Absenden ------------------------------ */
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errSend.hidden = true;

    const reach = reachInput.value.trim();
    const ok = seg.channel === 'mail' ? /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(reach) : reach.replace(/\D/g, '').length >= 6;
    errReach.hidden = ok;
    reachInput.setAttribute('aria-invalid', String(!ok));
    if (!ok) {
      reachInput.focus();
      return;
    }

    const data = new FormData(form);
    const payload = {
      name: String(data.get('name') || ''),
      kind: seg.kind,
      need: String(data.get('need') || ''),
      vehicle,
      topic,
      budget: String(data.get('budget') || ''),
      timing: String(data.get('timing') || ''),
      channel: seg.channel,
      reach,
      message: String(data.get('message') || ''),
      source: 'landingpage',
    };

    submit.disabled = true;
    submitLabel.textContent = 'Wird gesendet …';
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || 'Senden fehlgeschlagen');
      form.hidden = true;
      done.hidden = false;
    } catch (err) {
      errSend.textContent =
        (err as Error).message + ' – ruf Alex gern direkt an, das geht immer.';
      errSend.hidden = false;
    } finally {
      submit.disabled = false;
      submitLabel.textContent = 'Anfrage an Alex senden';
    }
  });
</script>
