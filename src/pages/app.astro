---
import Base from '../layouts/Base.astro';
import { brand, vehicles, priceNote, topics, telHref, waHref, contact } from '../data/site';

const title = 'Autoladen Altes Land – sag Alex, was du brauchst';
const description =
  'Ein Ansprechpartner für dein Fahrzeug. Markenunabhängig, für Unternehmen und Privatkunden. ' +
  'Anrufen, WhatsApp oder Anfrage mit drei Angaben.';
---

<Base
  title={title}
  description={description}
  theme="dark"
  fonts="family=Geist:wght@300..700&family=Manrope:wght@400..700"
>
  <div class="app">
    <!-- ============================ KOPF ============================ -->
    <header class="bar">
      <img class="logo" src="/logo.png" alt="" width="44" height="44" />
      <span>
        <span class="bar-name">{brand.name}</span>
        <span class="bar-sub">Fahrzeugvermittlung</span>
      </span>
      <span class="live-top"><span class="dot"></span>Alex antwortet persönlich</span>
    </header>

    <div class="console">
      <div class="hero-row">
      <!-- ------------------------- Alex (Spalte 1) ------------------------ -->
      <button class="alex" type="button" data-view="alex">
        <span class="alex-txt">
          <span class="live"><span class="dot"></span>Persönlich erreichbar</span>
          <span class="alex-n">Moin, ich bin Alex.</span>
          <span class="alex-r">Persönlich, direkt und ohne großes Verkaufstheater.</span>
          <span class="alex-more">
            Was das für dich heißt
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M4.8 12h13.4"></path><path d="m12.9 6.6 5.3 5.4-5.3 5.4"></path></svg
            >
          </span>
        </span>
        <span class="alex-pic"
          ><img src="/alex-tall.jpg" alt={`${brand.person} vom ${brand.name}`} width="480" height="720" /></span
        >
      </button>

      <!-- ------------------------- Mitte (Spalte 2) ----------------------- -->
      <main class="mid">
        <span class="eyebrow">
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"
            ><rect x="4" y="4" width="7" height="7" rx="2"></rect><rect x="13" y="4" width="7" height="7" rx="2"
            ></rect><rect x="4" y="13" width="7" height="7" rx="2"></rect><rect x="13" y="13" width="7" height="7" rx="2"
            ></rect></svg
          >
          Markenunabhängig · privat &amp; gewerblich
        </span>
        <h1>Ein Ansprechpartner.<br /><span class="a">Fertig.</span></h1>
        <p class="sub">Gerade wenn Autos nicht dein Tagesgeschäft sind, musst du auch keins daraus machen.</p>

        <div class="acts">
          {
            telHref ? (
              <a class="act" href={telHref}>
                <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4.2 6.4c0-1.1.9-2 2-2h1.6c.7 0 1.3.4 1.6 1l1 2.2c.3.6.1 1.3-.4 1.7l-1 .8a11 11 0 0 0 4.9 4.9l.8-1c.4-.5 1.1-.7 1.7-.4l2.2 1c.6.3 1 .9 1 1.6v1.6c0 1.1-.9 2-2 2A15.3 15.3 0 0 1 4.2 6.4Z" />
                </svg>
                Anrufen
              </a>
            ) : (
              <button class="act is-ph" type="button" data-view="ask">
                <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4.2 6.4c0-1.1.9-2 2-2h1.6c.7 0 1.3.4 1.6 1l1 2.2c.3.6.1 1.3-.4 1.7l-1 .8a11 11 0 0 0 4.9 4.9l.8-1c.4-.5 1.1-.7 1.7-.4l2.2 1c.6.3 1 .9 1 1.6v1.6c0 1.1-.9 2-2 2A15.3 15.3 0 0 1 4.2 6.4Z" />
                </svg>
                Anrufen<em>Nummer fehlt</em>
              </button>
            )
          }
          {
            waHref ? (
              <a class="act" href={waHref} target="_blank" rel="noopener">
                <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.5 11.6a8.4 8.4 0 0 1-12.3 7.5L4 20.4l1.4-4.1A8.4 8.4 0 1 1 20.5 11.6Z" />
                  <path d="M9.4 9.4c.2-.4.4-.4.6-.4h.4c.2 0 .4 0 .6.5l.6 1.5c.1.2.1.4 0 .5l-.4.5c-.1.2-.2.3-.1.5a5.6 5.6 0 0 0 2.7 2.4c.3.1.4 0 .6-.1l.5-.6c.2-.2.3-.2.6-.1l1.4.7c.3.1.4.3.4.5s0 .8-.3 1.1c-.3.4-.9.7-1.5.7-1.4 0-3.2-1-4.4-2.2a8.6 8.6 0 0 1-1.9-2.9c-.2-.6-.1-1.3.2-1.8Z" />
                </svg>
                WhatsApp
              </a>
            ) : (
              <button class="act is-ph" type="button" data-view="ask">
                <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.5 11.6a8.4 8.4 0 0 1-12.3 7.5L4 20.4l1.4-4.1A8.4 8.4 0 1 1 20.5 11.6Z" />
                  <path d="M9.4 9.4c.2-.4.4-.4.6-.4h.4c.2 0 .4 0 .6.5l.6 1.5c.1.2.1.4 0 .5l-.4.5c-.1.2-.2.3-.1.5a5.6 5.6 0 0 0 2.7 2.4c.3.1.4 0 .6-.1l.5-.6c.2-.2.3-.2.6-.1l1.4.7c.3.1.4.3.4.5s0 .8-.3 1.1c-.3.4-.9.7-1.5.7-1.4 0-3.2-1-4.4-2.2a8.6 8.6 0 0 1-1.9-2.9c-.2-.6-.1-1.3.2-1.8Z" />
                </svg>
                WhatsApp<em>Nummer fehlt</em>
              </button>
            )
          }
        </div>

        <button class="primary" type="button" data-view="ask">
          Kurz mit Alex sprechen
          <span class="go"
            ><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M4.8 12h13.4"></path><path d="m12.9 6.6 5.3 5.4-5.3 5.4"></path></svg
            ></span
          >
        </button>
        <p class="note">Drei Angaben genügen: worum es geht, wie ich dich erreiche, deine Nummer.</p>
      </main>
      </div>

      <!-- --------------------- Angebote (eigene Reihe) -------------------- -->
      <section class="panel">
        <div class="panel-head">
          <h2>Was gerade geht</h2>
          <button class="panel-more" type="button" data-view="cars">
            alle ansehen
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M4.8 12h13.4"></path><path d="m12.9 6.6 5.3 5.4-5.3 5.4"></path></svg
            >
          </button>
        </div>

        <!-- Desktop: drei Karten nebeneinander -->
        <div class="offers">
          {
            vehicles.map((v) => (
              <button class="ocard" type="button" data-view="ask" data-vehicle={v.name} data-topic={v.topic}>
                <span class="ocard-pic" style={`background-image:url(${v.image})`} role="img" aria-label={v.alt} />
                <span class="ocard-txt">
                  <span class="t">{v.name}</span>
                  <span class="s">
                    <span class={`dot tone-${v.tone}`} />
                    {v.status}
                  </span>
                  <span class="prow">
                    <span class="p-old">{v.price.old}</span>
                    <span class="p-new">{v.price.rate}</span>
                    <span class="p-unit">mtl. netto</span>
                  </span>
                </span>
                <span class="ch">
                  <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m9.5 5.5 6.5 6.5-6.5 6.5" />
                  </svg>
                </span>
              </button>
            ))
          }
        </div>

        <!-- Mobil: Streifen -->
        <div class="strip">
          {
            vehicles.map((v) => (
              <button class="offer" type="button" data-view="ask" data-vehicle={v.name} data-topic={v.topic}>
                <span class="offer-media">
                  <span class="offer-img" style={`background-image:url(${v.image})`} role="img" aria-label={v.alt} />
                  <span class="offer-fade" />
                  <span class={`pin tone-${v.tone}`} />
                </span>
                <span class="offer-body">
                  <span class="offer-name">{v.name}</span>
                  <span class="prow">
                    <span class="p-old">{v.price.old}</span>
                    <span class="p-new">{v.price.rate}</span>
                    <span class="p-unit">mtl.</span>
                  </span>
                </span>
              </button>
            ))
          }
        </div>

        <p class="tail">{priceNote}</p>
      </section>
    </div>

    <footer class="foot">
      <span>
        Telefon {contact.phone ? contact.phone : <span class="ph">[Nummer eintragen]</span>} · E-Mail {
          contact.email ? contact.email : <span class="ph">[Adresse eintragen]</span>
        }
      </span>
      <span class="links">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </span>
    </footer>
  </div>

  <!-- ============================== SHEETS ============================== -->
  <div class="ovl" id="ovl" data-open="0">
    <!-- Alex: der ganze Text -->
    <section class="sheet" id="sheet-alex" role="dialog" aria-modal="true" aria-labelledby="alex-title" hidden>
      <div class="grab"></div>
      <div class="sh-head">
        <div>
          <div class="sh-title" id="alex-title">Moin, ich bin Alex.</div>
          <div class="sh-sub">Ein Ansprechpartner. Fertig.</div>
        </div>
        <button class="sh-x" type="button" aria-label="Schließen" data-close>
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17"></path></svg>
        </button>
      </div>
      <div class="sh-body">
        <div class="band">
          <img src="/alex.jpg" alt="" width="760" height="760" />
          <div class="duo"></div>
        </div>
        <p class="lead">Persönlich, direkt und ohne großes Verkaufstheater.</p>
        <p class="para">
          Mir ist lieber, wir sprechen zehn Minuten vernünftig darüber, was du wirklich brauchst, als dass ich dir
          drei Hochglanzangebote schicke, die am Ende nicht passen.
        </p>
        <p class="para">Wenn ich weiß, wonach du suchst, kann ich dir meistens ziemlich schnell sagen, was machbar ist.</p>
        <p class="kicker">Also: Was soll’s werden?</p>

        <div class="rule">
          <span class="rule-l">Warum ein Ansprechpartner reicht</span>
          <p class="para">
            Bei mir bist du nicht an eine bestimmte Marke gebunden und musst dich auch nicht selbst durch unzählige
            Angebote kämpfen.
          </p>
          <p class="para">Ich suche das Fahrzeug, das zu deinem Bedarf und deinem Budget passt.</p>
          <p class="para strong">Für Unternehmen genauso wie für Privatkunden.</p>
        </div>

        <button class="send" type="button" data-view="ask">
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M20.5 11.5a8 8 0 0 1-11.7 7.1L4 20l1.4-4.4A8 8 0 1 1 20.5 11.5Z"></path><path
              d="M9 11.6h.01M12 11.6h.01M15 11.6h.01"></path></svg
          >
          Kurz mit Alex sprechen
        </button>
      </div>
    </section>

    <!-- Angebote -->
    <section class="sheet" id="sheet-cars" role="dialog" aria-modal="true" aria-labelledby="cars-title" hidden>
      <div class="grab"></div>
      <div class="sh-head">
        <div>
          <div class="sh-title" id="cars-title">Was gerade geht</div>
          <div class="sh-sub">Drei Beispiele – kein Bestand, kein Katalog.</div>
        </div>
        <button class="sh-x" type="button" aria-label="Schließen" data-close>
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17"></path></svg>
        </button>
      </div>
      <div class="sh-body">
        {
          vehicles.map((v) => (
            <button class="vrow" type="button" data-view="ask" data-vehicle={v.name} data-topic={v.topic}>
              <span class="pic" style={`background-image:url(${v.image})`} role="img" aria-label={v.alt} />
              <span class="vrow-txt">
                <span class="t">{v.name}</span>
                <span class="s">
                  <span class={`dot tone-${v.tone}`} />
                  {v.status}
                </span>
                <span class="prow">
                  <span class="p-old">{v.price.old}</span>
                  <span class="p-new">{v.price.rate}</span>
                  <span class="p-unit">mtl. netto</span>
                </span>
              </span>
              <span class="ch">
                <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m9.5 5.5 6.5 6.5-6.5 6.5" />
                </svg>
              </span>
            </button>
          ))
        }
        <p class="terms">{priceNote}</p>
      </div>
    </section>

    <!-- Anfrage -->
    <section class="sheet" id="sheet-ask" role="dialog" aria-modal="true" aria-labelledby="ask-title" hidden>
      <div class="grab"></div>
      <div class="sh-head">
        <div>
          <div class="sh-title" id="ask-title">Kurz mit Alex sprechen</div>
          <div class="sh-sub">Drei Angaben – mehr brauche ich nicht.</div>
        </div>
        <button class="sh-x" type="button" aria-label="Schließen" data-close>
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17"></path></svg>
        </button>
      </div>

      <form class="sh-body" id="form" novalidate>
        <div class="ctx" id="ctx" hidden>
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M5 13.6h14"></path><path d="m6.6 13.6 1.2-4.3A2.3 2.3 0 0 1 10 7.6h4a2.3 2.3 0 0 1 2.2 1.7l1.2 4.3"
            ></path><path d="M5 13.6v3.1M19 13.6v3.1"></path><circle cx="8.2" cy="16.7" r="1.5"></circle><circle
              cx="15.8" cy="16.7" r="1.5"></circle></svg
          >
          <span id="ctx-name"></span>
          <button class="ctx-x" type="button" aria-label="Bezug entfernen" id="ctx-clear">
            <svg class="ic" viewBox="0 0 24 24" style="width:14px;height:14px" aria-hidden="true"
              ><path d="m7 7 10 10M17 7 7 17"></path></svg
            >
          </button>
        </div>

        <div class="field">
          <span class="lbl" id="lbl-topic">Worum geht’s?</span>
          <div class="chips" role="radiogroup" aria-labelledby="lbl-topic" id="chips">
            {
              topics.map((t, i) => (
                <button class="chip" type="button" role="radio" aria-checked={i === 0} data-val={t.id}>
                  {t.label}
                </button>
              ))
            }
          </div>
        </div>

        <div class="field">
          <span class="lbl" id="lbl-ch">Wie erreiche ich dich?</span>
          <div class="seg" role="radiogroup" aria-labelledby="lbl-ch" id="seg">
            <button class="seg-b" type="button" role="radio" aria-checked="true" data-val="tel">
              <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  d="M4.2 6.4c0-1.1.9-2 2-2h1.6c.7 0 1.3.4 1.6 1l1 2.2c.3.6.1 1.3-.4 1.7l-1 .8a11 11 0 0 0 4.9 4.9l.8-1c.4-.5 1.1-.7 1.7-.4l2.2 1c.6.3 1 .9 1 1.6v1.6c0 1.1-.9 2-2 2A15.3 15.3 0 0 1 4.2 6.4Z"
                ></path></svg
              >
              Anruf
            </button>
            <button class="seg-b" type="button" role="radio" aria-checked="false" data-val="wa">
              <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"
                ><path d="M20.5 11.6a8.4 8.4 0 0 1-12.3 7.5L4 20.4l1.4-4.1A8.4 8.4 0 1 1 20.5 11.6Z"></path><path
                  d="M9.4 9.4c.2-.4.4-.4.6-.4h.4c.2 0 .4 0 .6.5l.6 1.5c.1.2.1.4 0 .5l-.4.5c-.1.2-.2.3-.1.5a5.6 5.6 0 0 0 2.7 2.4c.3.1.4 0 .6-.1l.5-.6c.2-.2.3-.2.6-.1l1.4.7c.3.1.4.3.4.5s0 .8-.3 1.1c-.3.4-.9.7-1.5.7-1.4 0-3.2-1-4.4-2.2a8.6 8.6 0 0 1-1.9-2.9c-.2-.6-.1-1.3.2-1.8Z"
                ></path></svg
              >
              WhatsApp
            </button>
          </div>
        </div>

        <div class="field">
          <label class="lbl" for="a-num" id="reach-label">Deine Nummer</label>
          <input class="inp" id="a-num" name="reach" type="tel" autocomplete="tel" required placeholder="01xx xxxxxxx" />
          <p class="err" id="err-reach" hidden>Ohne Nummer kann ich mich nicht melden.</p>
        </div>

        <div class="field">
          <label class="lbl" for="a-msg">Kurz dazu <span class="opt">– optional</span></label>
          <textarea class="inp" id="a-msg" name="message" rows="2" placeholder="Was ist dir wichtig?"></textarea>
        </div>

        <button class="send" type="submit" id="submit">
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M20.1 4.4 3.6 9.7c-.9.3-.9 1.5 0 1.8l6.5 2.2 2.2 6.5c.3.9 1.5.9 1.8 0l5.3-16.5a.9.9 0 0 0-1.3-1.3Z"
            ></path><path d="m10.3 13.5 4.1-4.1"></path></svg
          >
          <span id="submit-label">An Alex senden</span>
        </button>
        <p class="fine">Geht direkt an Alex – nicht an ein Portal.</p>
        <p class="err center" id="err-send" hidden></p>
      </form>

      <div class="done" id="done" hidden>
        <span class="ring"
          ><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="m5.5 12.6 4 4 9-9"></path></svg></span
        >
        <h3>Ist bei Alex.</h3>
        <p>Er schaut, ob er so etwas findet, und meldet sich persönlich bei dir.</p>
        <button class="send" type="button" data-close>Fertig</button>
      </div>
    </section>
  </div>
</Base>

<style>
  .app {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 32px 40px;
  }
  .app::before {
    content: '';
    position: absolute;
    top: -300px;
    right: -180px;
    width: 820px;
    height: 820px;
    background: radial-gradient(circle, rgba(51, 102, 204, 0.2), rgba(51, 102, 204, 0) 66%);
    pointer-events: none;
  }
  .app::after {
    content: '';
    position: absolute;
    bottom: -340px;
    left: -200px;
    width: 760px;
    height: 760px;
    background: radial-gradient(circle, rgba(36, 192, 140, 0.09), rgba(36, 192, 140, 0) 66%);
    pointer-events: none;
  }

  /* --------------------------------- Kopf -------------------------------- */
  .bar {
    position: relative;
    flex: none;
    width: 100%;
    max-width: 1240px;
    margin-inline: auto;
    height: 68px;
    display: flex;
    align-items: center;
    gap: 13px;
  }
  .logo {
    width: 44px;
    height: 44px;
    flex: none;
    object-fit: contain;
  }
  .bar-name {
    display: block;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.014em;
  }
  .bar-sub {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .live-top {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 40px;
    padding: 0 17px 0 13px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 13.5px;
    color: var(--ink-2);
  }

  /* -------------------------------- Bühne -------------------------------- */
  .console {
    position: relative;
    flex: 1;
    width: 100%;
    max-width: 1240px;
    margin: 26px auto 0;
    display: flex;
    flex-direction: column;
    gap: 26px;
    min-height: 0;
  }
  .hero-row {
    display: grid;
    grid-template-columns: 400px minmax(0, 1fr);
    gap: 32px;
    flex: 1;
    min-height: 0;
  }

  /* Alex */
  .alex {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-radius: 36px;
    overflow: hidden;
    background: #10151a;
    padding: 0;
    box-shadow: 0 0 0 1px var(--line), 0 40px 70px -34px rgba(0, 0, 0, 0.95);
    transition: transform 0.2s var(--ease);
  }
  .alex:hover {
    transform: translateY(-2px);
  }
  .alex-pic {
    position: absolute;
    inset: 0;
  }
  .alex-pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 6%;
    filter: grayscale(1) contrast(1.05) brightness(0.95);
  }
  .alex-pic::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(196deg, rgba(51, 102, 204, 0.3), rgba(13, 16, 19, 0.06) 40%, rgba(13, 16, 19, 0.97));
  }
  .alex-txt {
    position: relative;
    z-index: 1;
    padding: 26px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 30px;
    padding: 0 13px 0 10px;
    border-radius: 999px;
    background: rgba(36, 192, 140, 0.13);
    box-shadow: inset 0 0 0 1px rgba(36, 192, 140, 0.28);
    font-size: 11.5px;
    font-weight: 600;
    color: #7fe0bd;
  }
  .alex-n {
    margin-top: 14px;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .alex-r {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 300px;
  }
  .alex-more {
    margin-top: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 14px 0 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
    font-size: 13.5px;
    font-weight: 600;
    color: #fff;
    transition: background 0.16s var(--ease);
  }
  .alex:hover .alex-more {
    background: rgba(255, 255, 255, 0.2);
  }
  .alex-more .ic {
    width: 16px;
    height: 16px;
  }

  /* Mitte */
  .mid {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 8px 0 24px;
    max-width: 620px;
  }
  .eyebrow {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 34px;
    padding: 0 15px 0 12px;
    border-radius: 999px;
    background: rgba(51, 102, 204, 0.16);
    box-shadow: inset 0 0 0 1px rgba(51, 102, 204, 0.34);
    font-size: 12.5px;
    font-weight: 600;
    color: #b9d0ff;
  }
  .eyebrow .ic {
    width: 15px;
    height: 15px;
  }
  h1 {
    margin-top: 24px;
    font-size: clamp(29px, 3.6vw, 50px);
    line-height: 1.04;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  h1 .a {
    color: var(--accent-text);
  }
  .sub {
    margin-top: 18px;
    font-size: 17.5px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 430px;
  }
  .acts {
    margin-top: 34px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .act {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 64px;
    border-radius: 20px;
    background: var(--surface);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.014em;
    transition: background 0.16s var(--ease), transform 0.16s var(--ease);
  }
  .act:hover {
    background: var(--surface-2);
    transform: translateY(-1px);
  }
  .act .ic {
    color: var(--ink-2);
  }
  .act em {
    font-style: normal;
    font-size: 10.5px;
    font-weight: 500;
    color: var(--ink-3);
  }
  .primary {
    margin-top: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    height: 64px;
    padding: 0 12px 0 24px;
    border-radius: 20px;
    background: var(--accent);
    color: #fff;
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: -0.016em;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), 0 16px 30px -14px rgba(51, 102, 204, 0.95);
    transition: background 0.16s var(--ease), transform 0.16s var(--ease);
  }
  .primary:hover {
    background: var(--accent-deep);
    transform: translateY(-1px);
  }
  .primary .go {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
  }
  .note {
    margin-top: 18px;
    font-size: 13px;
    color: var(--ink-3);
  }

  /* Angebote */
  .panel {
    flex: none;
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2px 0 4px;
  }
  .panel h2 {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .panel-more {
    display: none;
    align-items: center;
    gap: 5px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .panel-more .ic {
    width: 14px;
    height: 14px;
  }
  .offers {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .ocard {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 14px 12px 12px;
    border-radius: 22px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .ocard:hover {
    background: var(--surface-2);
    transform: translateY(-2px);
  }
  .ocard-pic {
    width: 112px;
    height: 92px;
    border-radius: 16px;
    background-size: cover;
    background-position: 50% 50%;
    flex: none;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .ocard-txt {
    min-width: 0;
    flex: 1;
  }
  .ocard .t {
    display: block;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.25;
  }
  .ocard .s {
    margin-top: 5px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    color: var(--ink-2);
  }
  .ocard .ch {
    color: var(--ink-3);
    flex: none;
  }
  .tone-blue {
    background: #5b9bff;
    box-shadow: 0 0 0 3px rgba(91, 155, 255, 0.2);
  }
  .tone-grey {
    background: #8b959e;
    box-shadow: 0 0 0 3px rgba(139, 149, 158, 0.2);
  }
  .prow {
    margin-top: 5px;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .p-old {
    font-size: 11.5px;
    font-weight: 500;
    color: var(--ink-3);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
  .p-new {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.026em;
    color: var(--ink);
  }
  .p-unit {
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .panel .tail {
    margin-top: 12px;
    padding: 0 4px;
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--ink-3);
  }
  .strip {
    display: none;
  }

  .foot {
    position: relative;
    flex: none;
    width: 100%;
    max-width: 1240px;
    margin: 26px auto 0;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .foot .links {
    display: flex;
    gap: 22px;
  }
  .foot a {
    color: var(--ink-3);
  }
  .foot a:hover {
    color: var(--ink-2);
  }
  .ph {
    background: rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    padding: 2px 8px;
    color: var(--ink-2);
  }

  /* -------------------------------- Sheets ------------------------------- */
  .ovl {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(4, 6, 8, 0.66);
    backdrop-filter: blur(5px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s var(--ease);
  }
  .ovl[data-open='1'] {
    opacity: 1;
    pointer-events: auto;
  }
  .sheet {
    width: 520px;
    max-height: 86vh;
    overflow: auto;
    border-radius: 30px;
    background: var(--sheet);
    padding-bottom: 26px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.09), 0 50px 90px -34px rgba(0, 0, 0, 0.95);
    transform: translateY(12px) scale(0.98);
    opacity: 0;
    transition: transform 0.22s var(--ease), opacity 0.18s var(--ease);
  }
  .ovl[data-open='1'] .sheet {
    transform: none;
    opacity: 1;
  }
  .grab {
    display: none;
  }
  .sh-head {
    padding: 26px 26px 0;
    display: flex;
    align-items: flex-start;
    gap: 13px;
  }
  .sh-title {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.026em;
  }
  .sh-sub {
    margin-top: 3px;
    font-size: 13.5px;
    color: var(--ink-2);
  }
  .sh-x {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--ink-2);
    flex: none;
  }
  .sh-x:hover {
    background: rgba(255, 255, 255, 0.11);
    color: var(--ink);
  }
  .sh-body {
    padding: 18px 26px 0;
  }

  .band {
    height: 200px;
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    background: #10151a;
  }
  .band img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 14%;
    filter: grayscale(1) brightness(0.94);
  }
  .band .duo {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(13, 16, 19, 0.08), rgba(13, 16, 19, 0.7));
  }
  .lead {
    margin-top: 18px;
    font-size: 17px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: -0.012em;
    color: var(--ink);
  }
  .para {
    margin-top: 14px;
    font-size: 15.5px;
    line-height: 1.62;
    color: var(--ink-2);
  }
  .para.strong {
    color: var(--ink);
    font-weight: 500;
  }
  .kicker {
    margin-top: 20px;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.026em;
    color: var(--ink);
  }
  .rule {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .rule-l {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .terms {
    margin-top: 14px;
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--ink-3);
  }

  .ctx {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    border-radius: 16px;
    background: rgba(51, 102, 204, 0.14);
    box-shadow: inset 0 0 0 1px rgba(51, 102, 204, 0.32);
    font-size: 13.5px;
    font-weight: 500;
    color: #cfe0ff;
  }
  .ctx-x {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    color: #cfe0ff;
    opacity: 0.7;
  }
  .ctx-x:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.1);
  }
  .field {
    margin-top: 20px;
  }
  .field:first-child {
    margin-top: 0;
  }
  .lbl {
    display: block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .lbl .opt {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
  }
  .chips {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    height: 44px;
    padding: 0 16px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
    transition: background 0.16s var(--ease), color 0.16s var(--ease), box-shadow 0.16s var(--ease);
  }
  .chip:hover {
    color: var(--ink);
  }
  .chip[aria-checked='true'] {
    background: rgba(51, 102, 204, 0.2);
    color: #cfe0ff;
    font-weight: 600;
    box-shadow: inset 0 0 0 1.5px var(--accent-hi);
  }
  .seg {
    margin-top: 10px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    padding: 5px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px var(--line-soft);
  }
  .seg-b {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
    transition: background 0.16s var(--ease), color 0.16s var(--ease);
  }
  .seg-b .ic {
    width: 17px;
    height: 17px;
  }
  .seg-b:hover {
    color: var(--ink);
  }
  .seg-b[aria-checked='true'] {
    background: rgba(255, 255, 255, 0.1);
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
  .inp {
    margin-top: 10px;
    width: 100%;
    height: 52px;
    padding: 0 16px;
    border: 0;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.045);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 16px;
    color: var(--ink);
  }
  textarea.inp {
    height: auto;
    padding: 12px 16px;
    line-height: 1.5;
    resize: vertical;
  }
  .inp::placeholder {
    color: #5f6a73;
  }
  .inp:focus {
    outline: none;
    background: rgba(255, 255, 255, 0.07);
    box-shadow: inset 0 0 0 1.5px var(--accent-hi);
  }
  .inp[aria-invalid='true'] {
    box-shadow: inset 0 0 0 1.5px #e0736a;
  }
  .err {
    margin-top: 8px;
    font-size: 12.5px;
    color: #e0736a;
  }
  .err.center {
    text-align: center;
  }
  .send {
    margin-top: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    height: 58px;
    border-radius: 18px;
    background: var(--accent);
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.014em;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), 0 12px 26px -12px rgba(51, 102, 204, 0.95);
    transition: background 0.16s var(--ease), opacity 0.16s var(--ease);
  }
  .send:hover {
    background: var(--accent-deep);
  }
  .send[disabled] {
    opacity: 0.6;
    pointer-events: none;
  }
  .fine {
    margin-top: 12px;
    text-align: center;
    font-size: 11.5px;
    color: var(--ink-3);
  }
  .done {
    padding: 34px 30px 10px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .ring {
    display: grid;
    place-items: center;
    width: 62px;
    height: 62px;
    border-radius: 999px;
    background: rgba(36, 192, 140, 0.14);
    color: var(--green);
  }
  .ring .ic {
    width: 28px;
    height: 28px;
    stroke-width: 1.9;
  }
  .done h3 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.026em;
  }
  .done p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 300px;
  }

  /* ------------------------------ Responsive ----------------------------- */
  @media (max-width: 1100px) {
    .hero-row {
      grid-template-columns: 330px minmax(0, 1fr);
      gap: 24px;
    }
    .mid {
      padding: 0 0 0 16px;
    }
    .offers {
      gap: 12px;
    }
    .ocard-pic {
      width: 92px;
      height: 80px;
    }
  }

  @media (max-width: 900px) {
    .offers {
      grid-template-columns: 1fr;
    }
    .ocard .ch {
      margin-left: auto;
    }
  }

  @media (max-width: 760px) {
    .app {
      padding: 0 0 18px;
    }
    .bar {
      height: 56px;
      padding: 0 20px;
      gap: 10px;
    }
    .logo {
      width: 36px;
      height: 36px;
    }
    .bar-name {
      font-size: 13px;
    }
    .bar-sub {
      font-size: 10px;
    }
    .live-top {
      display: none;
    }

    .console {
      margin-top: 8px;
      gap: 0;
    }
    .hero-row {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    /* Reihenfolge mobil: Aussage, Person, Handlung, Angebote.
       .mid wird aufgelöst, damit die Alex-Karte dazwischenpasst. */
    .mid {
      display: contents;
    }
    .mid h1,
    .mid .sub,
    .mid .acts,
    .mid .primary {
      margin-inline: 20px;
    }
    .mid h1 {
      order: 0;
    }
    .mid .sub {
      order: 1;
      max-width: none;
    }
    .mid .acts {
      order: 3;
    }
    .mid .primary {
      order: 4;
    }
    .eyebrow {
      display: none;
    }
    h1 {
      margin-top: 0;
      font-size: 29px;
      line-height: 1.1;
      letter-spacing: -0.036em;
    }
    .sub {
      margin-top: 10px;
      font-size: 15px;
      line-height: 1.45;
    }
    .acts {
      margin-top: 14px;
      gap: 10px;
    }
    .act {
      height: 60px;
      border-radius: 20px;
      font-size: 15.5px;
      flex-direction: column;
      gap: 2px;
    }
    .act .ic {
      width: 19px;
      height: 19px;
    }
    .primary {
      margin-top: 8px;
      height: 60px;
      font-size: 16px;
      padding: 0 12px 0 22px;
    }
    .note {
      display: none;
    }

    .alex {
      order: 2;
      flex-direction: row;
      justify-content: flex-start;
      margin: 16px 20px 0;
      height: 164px;
      border-radius: 26px;
      background: var(--surface);
      box-shadow: inset 0 0 0 1px var(--line), 0 22px 40px -22px rgba(0, 0, 0, 0.9);
    }
    .alex-txt {
      flex: 1;
      min-width: 0;
      padding: 16px 12px 16px 18px;
      justify-content: flex-start;
    }
    .live {
      height: 26px;
      font-size: 10.5px;
      padding: 0 11px 0 9px;
    }
    .alex-n {
      margin-top: 12px;
      font-size: 19px;
      letter-spacing: -0.028em;
    }
    .alex-r {
      margin-top: 6px;
      font-size: 12.5px;
      line-height: 1.4;
    }
    .alex-more {
      margin-top: auto;
      height: auto;
      padding: 0;
      background: none;
      box-shadow: none;
      color: var(--accent-text);
      font-size: 12.5px;
    }
    .alex-more .ic {
      width: 14px;
      height: 14px;
    }
    .alex-pic {
      position: relative;
      inset: auto;
      width: 132px;
      flex: none;
    }
    .alex-pic img {
      position: absolute;
      inset: 0;
      object-position: 50% 12%;
      filter: grayscale(1) contrast(1.03);
    }
    .alex-pic::after {
      background: none;
      box-shadow: inset 28px 0 30px -24px var(--surface);
    }

    /* Angebote als Streifen */
    .panel {
      margin-top: 18px;
    }
    .panel-head {
      padding: 0 20px;
    }
    .panel-more {
      display: inline-flex;
    }
    .offers {
      display: none;
    }
    .strip {
      display: flex;
      gap: 10px;
      margin-top: 12px;
      padding: 0 20px 4px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-left: 20px;
      scrollbar-width: none;
    }
    .strip::-webkit-scrollbar {
      display: none;
    }
    .offer {
      flex: none;
      width: 172px;
      scroll-snap-align: start;
      border-radius: 20px;
      overflow: hidden;
      background: var(--surface);
      box-shadow: inset 0 0 0 1px var(--line);
      transition: background 0.2s var(--ease);
    }
    .offer:hover {
      background: var(--surface-2);
    }
    .offer-media {
      display: block;
      position: relative;
      height: 92px;
    }
    .offer-img {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: 50% 50%;
    }
    .offer-fade {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, var(--surface) 2%, rgba(23, 28, 33, 0) 62%);
    }
    .pin {
      position: absolute;
      top: 8px;
      left: 8px;
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: var(--green);
    }
    .offer-body {
      display: block;
      padding: 2px 12px 12px;
    }
    .offer-name {
      display: block;
      font-size: 12.5px;
      font-weight: 600;
      line-height: 1.25;
      letter-spacing: -0.012em;
      min-height: 32px;
    }
    .offer .p-new {
      font-size: 16px;
    }
    .offer .p-old {
      font-size: 11px;
    }
    .offer .p-unit {
      font-size: 10.5px;
    }
    .panel .tail {
      margin: 10px 20px 0;
      padding: 0;
      font-size: 11px;
    }

    .foot {
      margin-top: 12px;
      padding: 0 20px;
      height: auto;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      font-size: 11.5px;
    }

    /* Sheets von unten */
    .ovl {
      align-items: flex-end;
    }
    .sheet {
      width: 100%;
      max-height: 92vh;
      border-radius: 30px 30px 0 0;
      padding-bottom: calc(22px + env(safe-area-inset-bottom, 0px));
      transform: translateY(26px);
    }
    .grab {
      display: block;
      width: 38px;
      height: 4px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.18);
      margin: 10px auto 0;
    }
    .sh-head {
      padding: 14px 22px 0;
    }
    .sh-body {
      padding: 18px 22px 0;
    }
    .band {
      height: 180px;
    }
    .lead {
      font-size: 16.5px;
    }
    .para {
      font-size: 15px;
    }
  }
</style>

<script>
  const ovl = document.getElementById('ovl')!;
  const sheets: Record<string, HTMLElement> = {
    alex: document.getElementById('sheet-alex')!,
    cars: document.getElementById('sheet-cars')!,
    ask: document.getElementById('sheet-ask')!,
  };
  const form = document.getElementById('form') as HTMLFormElement;
  const done = document.getElementById('done')!;
  const ctx = document.getElementById('ctx')!;
  const ctxName = document.getElementById('ctx-name')!;
  const reach = document.getElementById('a-num') as HTMLInputElement;
  const reachLabel = document.getElementById('reach-label')!;
  const errReach = document.getElementById('err-reach')!;
  const errSend = document.getElementById('err-send')!;
  const submit = document.getElementById('submit') as HTMLButtonElement;
  const submitLabel = document.getElementById('submit-label')!;

  let current: string | null = null;
  let lastFocused: HTMLElement | null = null;
  let vehicle = '';
  let topic = 'firma';
  let channel = 'tel';

  function open(view: string, name?: string, tpc?: string) {
    if (!sheets[view]) return;
    if (!current) lastFocused = document.activeElement as HTMLElement;
    Object.entries(sheets).forEach(([k, el]) => (el.hidden = k !== view));
    current = view;
    ovl.dataset.open = '1';
    document.body.style.overflow = 'hidden';

    if (view === 'ask') {
      if (name) {
        vehicle = name;
        ctxName.textContent = `Anfrage zu: ${name}`;
      }
      ctx.hidden = !vehicle;
      if (tpc) setTopic(tpc);
      form.hidden = false;
      done.hidden = true;
      errSend.hidden = true;
      setTimeout(() => reach.focus(), 80);
    }
  }

  function close() {
    ovl.dataset.open = '0';
    current = null;
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  document.querySelectorAll<HTMLElement>('[data-view]').forEach((el) =>
    el.addEventListener('click', () => open(el.dataset.view!, el.dataset.vehicle, el.dataset.topic))
  );
  document.querySelectorAll<HTMLElement>('[data-close]').forEach((el) => el.addEventListener('click', close));
  ovl.addEventListener('click', (e) => {
    if (e.target === ovl) close();
  });
  document.getElementById('ctx-clear')!.addEventListener('click', () => {
    vehicle = '';
    ctx.hidden = true;
  });

  document.addEventListener('keydown', (e) => {
    if (!current) return;
    if (e.key === 'Escape') {
      e.preventDefault();
      close();
      return;
    }
    if (e.key !== 'Tab') return;
    const sheet = sheets[current];
    const f = Array.from(
      sheet.querySelectorAll<HTMLElement>('button, input, textarea, select, a[href]')
    ).filter((el) => el.offsetParent !== null);
    if (!f.length) return;
    const first = f[0];
    const last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  /* Chips + Segment */
  const chipGroup = document.getElementById('chips')!;
  function setTopic(val: string) {
    topic = val;
    chipGroup
      .querySelectorAll<HTMLElement>('.chip')
      .forEach((c) => c.setAttribute('aria-checked', String(c.dataset.val === val)));
  }
  chipGroup.querySelectorAll<HTMLElement>('.chip').forEach((c) =>
    c.addEventListener('click', () => setTopic(c.dataset.val!))
  );

  const segGroup = document.getElementById('seg')!;
  segGroup.querySelectorAll<HTMLElement>('.seg-b').forEach((b) =>
    b.addEventListener('click', () => {
      channel = b.dataset.val!;
      segGroup
        .querySelectorAll<HTMLElement>('.seg-b')
        .forEach((x) => x.setAttribute('aria-checked', String(x === b)));
      reachLabel.textContent = channel === 'wa' ? 'Deine WhatsApp-Nummer' : 'Deine Nummer';
    })
  );

  /* Absenden */
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errSend.hidden = true;

    const value = reach.value.trim();
    const ok = value.replace(/\D/g, '').length >= 6;
    errReach.hidden = ok;
    reach.setAttribute('aria-invalid', String(!ok));
    if (!ok) {
      reach.focus();
      return;
    }

    const payload = {
      kind: topic === 'firma' || topic === 'transporter' ? 'firma' : 'privat',
      topic,
      vehicle,
      need: vehicle,
      channel,
      reach: value,
      message: String(new FormData(form).get('message') || ''),
      source: 'app',
    };

    submit.disabled = true;
    submitLabel.textContent = 'Wird gesendet …';
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || 'Senden fehlgeschlagen');
      form.hidden = true;
      done.hidden = false;
    } catch (err) {
      errSend.textContent = (err as Error).message + ' – ruf Alex gern direkt an.';
      errSend.hidden = false;
    } finally {
      submit.disabled = false;
      submitLabel.textContent = 'An Alex senden';
    }
  });
</script>
