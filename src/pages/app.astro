---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { ArrowRight01Icon, ArrowRight02Icon, BubbleChatIcon, Call02Icon, Cancel01Icon, Car03Icon, DashboardSquare01Icon, Sent02Icon, Tick02Icon, WhatsappIcon } from '@hugeicons/core-free-icons';
import { brand, vehicles, priceNote, topics, telHref, waHref, contact } from '../data/site';

const title = 'Autoladen Altes Land – sag Alex, was du brauchst';
const description =
  'Ein Ansprechpartner für dein Fahrzeug. Markenunabhängig, für Unternehmen und Privatkunden. ' +
  'Anrufen, WhatsApp oder Anfrage mit drei Angaben.';
---

<Base
  title={title}
  description={description}
  theme="dark"
  fonts="family=Geist:wght@300..700&family=Manrope:wght@400..700"
>
  <div class="app">
    <!-- ============================ KOPF ============================ -->
    <header class="bar">
      <img class="logo" src="/logo.png" alt="" width="56" height="56" />
      <span>
        <span class="bar-name">{brand.name}</span>
        <span class="bar-sub">Fahrzeugvermittlung</span>
      </span>
      <span class="live-top"><span class="dot"></span>Alex antwortet persönlich</span>
    </header>

    <div class="console">
      <div class="hero-row">
      <!-- ------------------------- Alex (Spalte 1) ------------------------ -->
      <button class="alex" type="button" data-view="alex">
        <span class="alex-txt">
          <span class="live"><span class="dot"></span>Persönlich erreichbar</span>
          <span class="alex-n">Moin, ich bin Alex.</span>
          <span class="alex-r">Persönlich, direkt und ohne großes Verkaufstheater.</span>
          <span class="alex-more">
            Was das für dich heißt
            <Icon icon={ArrowRight02Icon} />
          </span>
        </span>
        <span class="alex-pic"
          ><img src="/alex-tall.jpg" alt={`${brand.person} vom ${brand.name}`} width="480" height="720" /></span
        >
      </button>

      <!-- ------------------------- Mitte (Spalte 2) ----------------------- -->
      <main class="mid">
        <span class="eyebrow">
          <Icon icon={DashboardSquare01Icon} />
          Markenunabhängig · privat &amp; gewerblich
        </span>
        <h1>Ein Ansprechpartner.<br /><span class="a">Fertig.</span></h1>
        <p class="sub">Gerade wenn Autos nicht dein Tagesgeschäft sind, musst du auch keins daraus machen.</p>

        <div class="acts">
          {
            telHref ? (
              <a class="act" href={telHref}>
                <Icon icon={Call02Icon} />
                Anrufen
              </a>
            ) : (
              <button class="act" type="button" data-view="ask">
                <Icon icon={Call02Icon} />
                Anrufen
              </button>
            )
          }
          {
            waHref ? (
              <a class="act" href={waHref} target="_blank" rel="noopener">
                <Icon icon={WhatsappIcon} />
                WhatsApp
              </a>
            ) : (
              <button class="act" type="button" data-view="ask">
                <Icon icon={WhatsappIcon} />
                WhatsApp
              </button>
            )
          }
        </div>

        <button class="primary" type="button" data-view="ask">
          Kurz mit Alex sprechen
          <span class="go"
            ><Icon icon={ArrowRight02Icon} /></span
          >
        </button>
        <p class="note">Drei Angaben genügen: worum es geht, wie ich dich erreiche, deine Nummer.</p>
      </main>
      </div>

      <!-- --------------------- Angebote (eigene Reihe) -------------------- -->
      <section class="panel">
        <div class="panel-head">
          <h2>Was gerade geht</h2>
          <button class="panel-more" type="button" data-view="cars">
            alle ansehen
            <Icon icon={ArrowRight02Icon} />
          </button>
        </div>

        <!-- Desktop: drei Karten nebeneinander -->
        <div class="offers">
          {
            vehicles.map((v) => (
              <button class="ocard" type="button" data-view="ask" data-vehicle={v.name} data-topic={v.topic}>
                <span class="ocard-pic" style={`background-image:url(${v.image})`} role="img" aria-label={v.alt} />
                <span class="ocard-txt">
                  <span class="t">{v.name}</span>
                  <span class="s">
                    <span class={`dot tone-${v.tone}`} />
                    {v.status}
                  </span>
                  <span class="prow">
                    <span class="p-old">{v.price.old}</span>
                    <span class="p-new">{v.price.rate}</span>
                    <span class="p-unit">mtl. netto</span>
                  </span>
                </span>
                <span class="ch">
                  <Icon icon={ArrowRight01Icon} />
                </span>
              </button>
            ))
          }
        </div>

        <!-- Mobil: Streifen -->
        <div class="strip">
          {
            vehicles.map((v) => (
              <button class="offer" type="button" data-view="ask" data-vehicle={v.name} data-topic={v.topic}>
                <span class="offer-media">
                  <span class="offer-img" style={`background-image:url(${v.image})`} role="img" aria-label={v.alt} />
                  <span class="offer-fade" />
                  <span class={`pin tone-${v.tone}`} />
                </span>
                <span class="offer-body">
                  <span class="offer-name">{v.name}</span>
                  <span class="prow">
                    <span class="p-old">{v.price.old}</span>
                    <span class="p-new">{v.price.rate}</span>
                    <span class="p-unit">mtl.</span>
                  </span>
                </span>
              </button>
            ))
          }
        </div>

        <p class="tail">{priceNote}</p>
      </section>
    </div>

    <footer class="foot">
      <span>
        Telefon {contact.phone ? contact.phone : <span class="ph">[Nummer eintragen]</span>} · E-Mail {
          contact.email ? contact.email : <span class="ph">[Adresse eintragen]</span>
        }
      </span>
      <span class="links">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </span>
    </footer>
  </div>

  <!-- ============================== SHEETS ============================== -->
  <div class="ovl" id="ovl" data-open="0">
    <!-- Alex: der ganze Text -->
    <section class="sheet" id="sheet-alex" role="dialog" aria-modal="true" aria-labelledby="alex-title" hidden>
      <div class="grab"></div>
      <div class="sh-head">
        <div>
          <div class="sh-title" id="alex-title">Moin, ich bin Alex.</div>
          <div class="sh-sub">Ein Ansprechpartner. Fertig.</div>
        </div>
        <button class="sh-x" type="button" aria-label="Schließen" data-close>
          <Icon icon={Cancel01Icon} />
        </button>
      </div>
      <div class="sh-body">
        <div class="band">
          <img src="/alex.jpg" alt="" width="760" height="760" />
          <div class="duo"></div>
        </div>
        <p class="lead">Persönlich, direkt und ohne großes Verkaufstheater.</p>
        <p class="para">
          Mir ist lieber, wir sprechen zehn Minuten vernünftig darüber, was du wirklich brauchst, als dass ich dir
          drei Hochglanzangebote schicke, die am Ende nicht passen.
        </p>
        <p class="para">Wenn ich weiß, wonach du suchst, kann ich dir meistens ziemlich schnell sagen, was machbar ist.</p>
        <p class="kicker">Also: Was soll’s werden?</p>

        <div class="rule">
          <span class="rule-l">Warum ein Ansprechpartner reicht</span>
          <p class="para">
            Bei mir bist du nicht an eine bestimmte Marke gebunden und musst dich auch nicht selbst durch unzählige
            Angebote kämpfen.
          </p>
          <p class="para">Ich suche das Fahrzeug, das zu deinem Bedarf und deinem Budget passt.</p>
          <p class="para strong">Für Unternehmen genauso wie für Privatkunden.</p>
        </div>

        <button class="send" type="button" data-view="ask">
          <Icon icon={BubbleChatIcon} />
          Kurz mit Alex sprechen
        </button>
      </div>
    </section>

    <!-- Angebote -->
    <section class="sheet" id="sheet-cars" role="dialog" aria-modal="true" aria-labelledby="cars-title" hidden>
      <div class="grab"></div>
      <div class="sh-head">
        <div>
          <div class="sh-title" id="cars-title">Was gerade geht</div>
          <div class="sh-sub">Drei Beispiele – kein Bestand, kein Katalog.</div>
        </div>
        <button class="sh-x" type="button" aria-label="Schließen" data-close>
          <Icon icon={Cancel01Icon} />
        </button>
      </div>
      <div class="sh-body">
        {
          vehicles.map((v) => (
            <button class="vrow" type="button" data-view="ask" data-vehicle={v.name} data-topic={v.topic}>
              <span class="pic" style={`background-image:url(${v.image})`} role="img" aria-label={v.alt} />
              <span class="vrow-txt">
                <span class="t">{v.name}</span>
                <span class="s">
                  <span class={`dot tone-${v.tone}`} />
                  {v.status}
                </span>
                <span class="prow">
                  <span class="p-old">{v.price.old}</span>
                  <span class="p-new">{v.price.rate}</span>
                  <span class="p-unit">mtl. netto</span>
                </span>
              </span>
              <span class="ch">
                <Icon icon={ArrowRight01Icon} />
              </span>
            </button>
          ))
        }
        <p class="terms">{priceNote}</p>
      </div>
    </section>

    <!-- Anfrage -->
    <section class="sheet" id="sheet-ask" role="dialog" aria-modal="true" aria-labelledby="ask-title" hidden>
      <div class="grab"></div>
      <div class="sh-head">
        <div>
          <div class="sh-title" id="ask-title">Kurz mit Alex sprechen</div>
          <div class="sh-sub">Drei Angaben – mehr brauche ich nicht.</div>
        </div>
        <button class="sh-x" type="button" aria-label="Schließen" data-close>
          <Icon icon={Cancel01Icon} />
        </button>
      </div>

      <form class="sh-body" id="form" novalidate>
        <div class="ctx" id="ctx" hidden>
          <Icon icon={Car03Icon} />
          <span id="ctx-name"></span>
          <button class="ctx-x" type="button" aria-label="Bezug entfernen" id="ctx-clear">
            <Icon icon={Cancel01Icon} size={14} />
          </button>
        </div>

        <div class="field">
          <span class="lbl" id="lbl-topic">Worum geht’s?</span>
          <div class="chips" role="radiogroup" aria-labelledby="lbl-topic" id="chips">
            {
              topics.map((t, i) => (
                <button class="chip" type="button" role="radio" aria-checked={i === 0} data-val={t.id}>
                  {t.label}
                </button>
              ))
            }
          </div>
        </div>

        <div class="field">
          <span class="lbl" id="lbl-ch">Wie erreiche ich dich?</span>
          <div class="seg" role="radiogroup" aria-labelledby="lbl-ch" id="seg">
            <button class="seg-b" type="button" role="radio" aria-checked="true" data-val="tel">
              <Icon icon={Call02Icon} />
              Anruf
            </button>
            <button class="seg-b" type="button" role="radio" aria-checked="false" data-val="wa">
              <Icon icon={WhatsappIcon} />
              WhatsApp
            </button>
          </div>
        </div>

        <div class="field">
          <label class="lbl" for="a-num" id="reach-label">Deine Nummer</label>
          <input class="inp" id="a-num" name="reach" type="tel" autocomplete="tel" required placeholder="01xx xxxxxxx" />
          <p class="err" id="err-reach" hidden>Ohne Nummer kann ich mich nicht melden.</p>
        </div>

        <div class="field">
          <label class="lbl" for="a-msg">Kurz dazu <span class="opt">– optional</span></label>
          <textarea class="inp" id="a-msg" name="message" rows="2" placeholder="Was ist dir wichtig?"></textarea>
        </div>

        <button class="send" type="submit" id="submit">
          <Icon icon={Sent02Icon} />
          <span id="submit-label">An Alex senden</span>
        </button>
        <p class="fine">Geht direkt an Alex – nicht an ein Portal.</p>
        <p class="err center" id="err-send" hidden></p>
      </form>

      <div class="done" id="done" hidden>
        <span class="ring"
          ><Icon icon={Tick02Icon} /></span
        >
        <h3>Ist bei Alex.</h3>
        <p>Er schaut, ob er so etwas findet, und meldet sich persönlich bei dir.</p>
        <button class="send" type="button" data-close>Fertig</button>
      </div>
    </section>
  </div>
</Base>

<style>
  .app {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 32px 40px;
  }
  .app::before {
    content: '';
    position: absolute;
    top: -300px;
    right: -180px;
    width: 820px;
    height: 820px;
    background: radial-gradient(circle, rgba(51, 102, 204, 0.2), rgba(51, 102, 204, 0) 66%);
    pointer-events: none;
  }
  .app::after {
    content: '';
    position: absolute;
    bottom: -340px;
    left: -200px;
    width: 760px;
    height: 760px;
    background: radial-gradient(circle, rgba(36, 192, 140, 0.09), rgba(36, 192, 140, 0) 66%);
    pointer-events: none;
  }

  /* --------------------------------- Kopf -------------------------------- */
  .bar {
    position: relative;
    flex: none;
    width: 100%;
    max-width: 1240px;
    margin-inline: auto;
    height: 84px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .logo {
    width: 70px;
    height: 70px;
    flex: none;
    object-fit: contain;
  }
  .bar-name {
    display: block;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.014em;
  }
  .bar-sub {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .live-top {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 40px;
    padding: 0 17px 0 13px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 13.5px;
    color: var(--ink-2);
  }

  /* -------------------------------- Bühne -------------------------------- */
  .console {
    position: relative;
    flex: 1;
    width: 100%;
    max-width: 1240px;
    margin: 26px auto 0;
    display: flex;
    flex-direction: column;
    gap: 26px;
    min-height: 0;
  }
  .hero-row {
    display: grid;
    grid-template-columns: 400px minmax(0, 1fr);
    gap: 32px;
    flex: 1;
    min-height: 0;
  }

  /* Alex */
  .alex {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-radius: 36px;
    overflow: hidden;
    background: #10151a;
    padding: 0;
    box-shadow: 0 0 0 1px var(--line), 0 40px 70px -34px rgba(0, 0, 0, 0.95);
    transition: transform 0.2s var(--ease);
  }
  .alex:hover {
    transform: translateY(-2px);
  }
  .alex-pic {
    position: absolute;
    inset: 0;
  }
  .alex-pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 6%;
    filter: grayscale(1) contrast(1.05) brightness(0.95);
  }
  .alex-pic::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(196deg, rgba(51, 102, 204, 0.3), rgba(13, 16, 19, 0.06) 40%, rgba(13, 16, 19, 0.97));
  }
  .alex-txt {
    position: relative;
    z-index: 1;
    padding: 26px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 30px;
    padding: 0 13px 0 10px;
    border-radius: 999px;
    background: rgba(36, 192, 140, 0.13);
    box-shadow: inset 0 0 0 1px rgba(36, 192, 140, 0.28);
    font-size: 11.5px;
    font-weight: 600;
    color: #7fe0bd;
  }
  .alex-n {
    margin-top: 14px;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .alex-r {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 300px;
  }
  .alex-more {
    margin-top: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 14px 0 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
    font-size: 13.5px;
    font-weight: 600;
    color: #fff;
    transition: background 0.16s var(--ease);
  }
  .alex:hover .alex-more {
    background: rgba(255, 255, 255, 0.2);
  }
  .alex-more .ic {
    width: 16px;
    height: 16px;
  }

  /* Mitte */
  .mid {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 8px 0 24px;
    max-width: 620px;
  }
  .eyebrow {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 34px;
    padding: 0 15px 0 12px;
    border-radius: 999px;
    background: rgba(51, 102, 204, 0.16);
    box-shadow: inset 0 0 0 1px rgba(51, 102, 204, 0.34);
    font-size: 12.5px;
    font-weight: 600;
    color: #b9d0ff;
  }
  .eyebrow .ic {
    width: 15px;
    height: 15px;
  }
  h1 {
    margin-top: 24px;
    font-size: clamp(29px, 3.6vw, 50px);
    line-height: 1.04;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  h1 .a {
    color: var(--accent-text);
  }
  .sub {
    margin-top: 18px;
    font-size: 17.5px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 430px;
  }
  .acts {
    margin-top: 34px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .act {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 64px;
    border-radius: 20px;
    background: var(--surface);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.014em;
    transition: background 0.16s var(--ease), transform 0.16s var(--ease);
  }
  .act:hover {
    background: var(--surface-2);
    transform: translateY(-1px);
  }
  .act .ic {
    color: var(--ink-2);
  }
  .primary {
    margin-top: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    height: 64px;
    padding: 0 12px 0 24px;
    border-radius: 20px;
    background: var(--accent);
    color: #fff;
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: -0.016em;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), 0 16px 30px -14px rgba(51, 102, 204, 0.95);
    transition: background 0.16s var(--ease), transform 0.16s var(--ease);
  }
  .primary:hover {
    background: var(--accent-deep);
    transform: translateY(-1px);
  }
  .primary .go {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
  }
  .note {
    margin-top: 18px;
    font-size: 13px;
    color: var(--ink-3);
  }

  /* Angebote */
  .panel {
    flex: none;
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2px 0 4px;
  }
  .panel h2 {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .panel-more {
    display: none;
    align-items: center;
    gap: 5px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .panel-more .ic {
    width: 14px;
    height: 14px;
  }
  .offers {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .ocard {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 14px 12px 12px;
    border-radius: 22px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .ocard:hover {
    background: var(--surface-2);
    transform: translateY(-2px);
  }
  .ocard-pic {
    width: 112px;
    height: 92px;
    border-radius: 16px;
    background-size: cover;
    background-position: 50% 50%;
    flex: none;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .ocard-txt {
    min-width: 0;
    flex: 1;
  }
  .ocard .t {
    display: block;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.25;
  }
  .ocard .s {
    margin-top: 5px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    color: var(--ink-2);
  }
  .ocard .ch {
    color: var(--ink-3);
    flex: none;
  }
  .tone-blue {
    background: #5b9bff;
    box-shadow: 0 0 0 3px rgba(91, 155, 255, 0.2);
  }
  .tone-grey {
    background: #8b959e;
    box-shadow: 0 0 0 3px rgba(139, 149, 158, 0.2);
  }
  .prow {
    margin-top: 5px;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .p-old {
    font-size: 11.5px;
    font-weight: 500;
    color: var(--ink-3);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
  .p-new {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.026em;
    color: var(--ink);
  }
  .p-unit {
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .panel .tail {
    margin-top: 12px;
    padding: 0 4px;
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--ink-3);
  }
