---
import Base from '../layouts/Base.astro';
import { contactLinks, getSiteSettings } from '../lib/content';

const site = await getSiteSettings();
const { legal, legalLabels: labels } = site;
const { mailHref } = contactLinks(site);
---

<Base
  title={`${labels.privacyTitle} – ${site.brandName}`}
  description="Datenschutzerklärung"
  theme="light"
  ogImage={site.logo}
  ogImageAlt={site.logoAlt}
  siteName={site.brandName}
>
  <main class="legal">
    <a class="back" href="/">{labels.backLabel}</a>
    <h1>{labels.privacyTitle}</h1>
    <h2>{labels.privacyController}</h2>
    <p>
      {legal.company}, {legal.street}, {legal.city}<br />
      {labels.ceo}
      {legal.ceo} · <a href={mailHref}>{site.email}</a> · {site.phone}
    </p>
    {
      site.privacySections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((text) => (
            <p>
              {text
                .replaceAll('{{email}}', site.email)
                .split(/(https:\/\/[^\s)]+)/g)
                .map((part) =>
                  part.startsWith('https://') ? (
                    <a href={part} target="_blank" rel="noopener noreferrer">
                      {part}
                    </a>
                  ) : (
                    part
                  )
                )}
            </p>
          ))}
        </section>
      ))
    }
  </main>
</Base>

<style>
  .legal {
    width: min(680px, 100% - 40px);
    margin: 0 auto;
    padding: 56px 0 120px;
  }
  .back {
    font-size: 13.5px;
    font-weight: 600;
  }
  h1 {
    margin-top: 20px;
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  h2 {
    margin-top: 34px;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .hint {
    margin-top: 16px;
    padding: 14px 16px;
    border-radius: 16px;
    background: rgba(0, 51, 102, 0.055);
    box-shadow: inset 0 0 0 1px rgba(0, 51, 102, 0.1);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--accent);
  }
  p,
  li {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--ink-2);
  }
  ul {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  li {
    padding-left: 18px;
    position: relative;
  }
  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 11px;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--ink-3);
  }
  .ph {
    color: var(--ink-3);
    background: rgba(16, 24, 32, 0.05);
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 14px;
  }
</style>
